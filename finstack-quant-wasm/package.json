{
  "name": "finstack-quant-wasm",
  "version": "0.8.0",
  "type": "module",
  "description": "WebAssembly bindings for Finstack Quant - high-performance financial computation library for bonds, derivatives, and portfolio analytics",
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "exports/**",
    "pkg/**",
    "pkg-node/**",
    "snippets/**",
    "types/**"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./types": {
      "types": "./types/generated/index.ts"
    },
    "./package.json": "./package.json",
    "./pkg/finstack_quant_wasm_bg.wasm": "./pkg/finstack_quant_wasm_bg.wasm"
  },
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node",
    "build:optimized": "wasm-pack build --target web --out-dir pkg && npm run optimize",
    "prepare": "command -v wasm-pack >/dev/null 2>&1 && npm run build || true",
    "docs:sync": "node scripts/sync-facade-jsdoc.mjs --write && node scripts/complete-facade-jsdoc.mjs --write",
    "docs:check": "node scripts/check-dts-docs.mjs && node scripts/check-typescript-docs.mjs && node scripts/complete-facade-jsdoc.mjs --check && npm run test:docs-tools && npm run test:dts",
    "optimize": "command -v wasm-opt >/dev/null 2>&1 && wasm-opt -Oz -o pkg/finstack_quant_wasm_bg.wasm pkg/finstack_quant_wasm_bg.wasm || echo 'wasm-opt not found, skipping optimization'",
    "test": "wasm-pack test --node",
    "test:dts": "tsc -p tests/typescript/tsconfig.es2020.json && tsc -p tests/typescript/tsconfig.esnext-disposable.json",
    "test:docs-tools": "node --test tests/scripts/typescript_docs.test.mjs",
    "test:browser": "wasm-pack test --chrome --headless",
    "test:facade": "node --test \"tests/facade/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,js,json,css,md,mjs,mks}\" index.d.ts",
    "format:fix": "prettier --write \"**/*.{ts,js,json,css,md,mjs,mks}\" index.d.ts",
    "format:check": "npm run format",
    "bench": "node benchmarks/bench.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeickmeier/finstack-quant"
  },
  "homepage": "https://github.com/jeickmeier/finstack-quant#readme",
  "bugs": {
    "url": "https://github.com/jeickmeier/finstack-quant/issues"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "finance",
    "rust",
    "derivatives",
    "bonds",
    "pricing",
    "fixed-income",
    "rates",
    "credit",
    "fx",
    "equity",
    "options",
    "swaps",
    "portfolio",
    "risk",
    "calibration",
    "monte-carlo",
    "structured-products"
  ],
  "author": "Finstack Quant Contributors",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@humanfs/node": "0.16.8"
  }
}
