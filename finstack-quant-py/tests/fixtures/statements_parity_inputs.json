{
  "model": {
    "id": "p9",
    "periods": [
      { "id": "2025Q1", "start": "2025-01-01", "end": "2025-04-01", "is_actual": true },
      { "id": "2025Q2", "start": "2025-04-01", "end": "2025-07-01", "is_actual": false }
    ],
    "nodes": {
      "revenue": {
        "node_id": "revenue",
        "node_type": "value",
