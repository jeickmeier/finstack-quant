      "cogs": {
        "node_id": "cogs",
        "node_type": "value",
        "values": { "2025Q1": 40.0, "2025Q2": 50.0 }
      },
      "profit": { "node_id": "profit", "node_type": "calculated", "formula_text": "revenue - cogs" },
      "margin": { "node_id": "margin", "node_type": "calculated", "formula_text": "profit / revenue" }
    },
    "schema_version": 1
  },
  "check_suite": {
    "name": "p9 suite",
    "builtin_checks": [{ "type": "non_finite", "nodes": [] }],
    "formula_checks": [
      {
        "id": "revenue_large",
        "name": "Revenue above 110",
        "category": "internal_consistency",
        "severity": "error",
        "formula": "revenue > 110",
        "message_template": "Revenue too small in {period}",
        "tolerance": null
      }
    ]
  },
  "normalization_config": {
    "target_node": "profit",
    "adjustments": [
      {
        "id": "one_off",
        "name": "One-off cost",
        "category": "non_recurring",
        "value": { "type": "fixed", "amounts": { "2025Q1": 5.0 } }
      },
      {
        "id": "synergy",
        "name": "Synergies",
        "value": { "type": "percentage_of_node", "node_id": "revenue", "percentage": 0.1 }
      }
    ]
  },
