        {
          "path": "pricing-workbench/pricing-workbench.tsx",
          "type": "registry:block",
          "target": "components/finstack/blocks/pricing-workbench/pricing-workbench.tsx"
        }
      ],
      "registryDependencies": [
        "@finstack/instrument-form",
        "@finstack/pricing-params-form",
        "@finstack/curve-chart",
        "@finstack/measures-grid",
        "@finstack/json-viewer",
        "@finstack/use-instrument-validator",
        "@finstack/use-price-instrument",
        "@finstack/finstack-fixtures",
        "@finstack/market-context-form",
        "@finstack/use-market-validator",
        "@finstack/cashflow-viewer",
        "@finstack/valuation-details",
        "@finstack/finstack-table",
        "@finstack/use-linked-selection"
      ],
      "dependencies": [
        "@base-ui/react@1.8.0",
        "finstack-quant-wasm@0.8.0",
        "@tanstack/react-table@9.2.4"
      ]
    }
  ]
