{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "pricing-workbench",
      "type": "registry:block",
      "docs": "All-instrument workbench with complete market browser/editor, explicitly configured evaluated views, native calibration/diagnostics, linked residuals, validated market-to-pricing handoff and optional structured-credit scenarios. Host owns routes and domain inputs.",
      "files": [
        {
          "path": "pricing-workbench/pricing-workbench.tsx",
          "type": "registry:block",
          "target": "components/finstack/blocks/pricing-workbench/pricing-workbench.tsx"
        },
        {
          "path": "pricing-workbench/calibration-panel.tsx",
          "type": "registry:block",
          "target": "components/finstack/blocks/pricing-workbench/calibration-panel.tsx"
        },
        {
          "path": "pricing-workbench/scenario-panel.tsx",
          "type": "registry:block",
          "target": "components/finstack/blocks/pricing-workbench/scenario-panel.tsx"
        }
      ],
      "registryDependencies": [
        "@finstack/instrument-form",
        "@finstack/pricing-params-form",
        "@finstack/measures-grid",
        "@finstack/json-viewer",
        "@finstack/use-instrument-validator",
        "@finstack/use-price-instrument",
        "@finstack/finstack-fixtures",
        "@finstack/market-context-form",
        "@finstack/use-market-validator",
        "@finstack/cashflow-viewer",
        "@finstack/valuation-details",
        "@finstack/use-linked-selection",
        "@finstack/market-context-browser",
        "@finstack/vol-cube-explorer",
        "@finstack/fx-surface-chart",
        "@finstack/calibration-form",
        "@finstack/calibration-report",
        "@finstack/calibration-fit-chart",
        "@finstack/use-calibrate",
        "@finstack/use-scenario-table",
        "@finstack/scenario-heatmap",
        "button",
        "label",
        "popover",
        "select",
        "tabs",
        "textarea"
      ],
      "dependencies": ["@base-ui/react@1.8.0", "finstack-quant-wasm@0.8.0"]
    }
  ]
}
