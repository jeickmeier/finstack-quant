          "popover-foreground": "#0b1311",
          "secondary": "#eeefeb",
          "secondary-foreground": "#0b1311",
          "destructive": "#b1272d"
        },
        "dark": {
          "background": "#121b19",
          "foreground": "#e6ede8",
          "card": "#18231f",
          "card-foreground": "#e6ede8",
          "muted": "#26342e",
          "muted-foreground": "#a9b7ae",
          "border": "#2a3835",
