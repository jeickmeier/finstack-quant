          "primary-foreground": "#ffffff",
          "accent": "#e4f0eb",
          "accent-foreground": "#145b50",
          "ring": "#086c61",
          "positive": "#176848",
          "negative": "#b1272d",
          "warning": "#865607",
          "error": "#b1272d",
          "info": "#175f8c",
          "par": "#59645f",
          "chart-1": "#0d9488",
          "chart-2": "#c2410c",
          "chart-3": "#4f46e5",
          "chart-4": "#b91c1c",
          "chart-5": "#0369a1",
          "chart-6": "#a16207",
          "sequential-1": "#f0fdfa",
          "sequential-2": "#ccfbf1",
          "sequential-3": "#99f6e4",
          "sequential-4": "#5eead4",
          "sequential-5": "#2dd4bf",
          "sequential-6": "#14b8a6",
          "sequential-7": "#0d9488",
          "sequential-8": "#0f766e",
          "sequential-9": "#134e4a",
          "diverging-negative": "#b1272d",
          "diverging-neutral": "#eeefeb",
          "diverging-positive": "#176848",
          "cell-light": "#ffffff",
          "cell-dark": "#000000",
          "input": "#86928c",
