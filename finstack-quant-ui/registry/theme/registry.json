          "chart-6": "#ad830c",
          "sequential-1": "#f0fdfa",
          "sequential-2": "#ccfbf1",
          "sequential-3": "#99f6e4",
          "sequential-4": "#5eead4",
          "sequential-5": "#2dd4bf",
          "sequential-6": "#14b8a6",
