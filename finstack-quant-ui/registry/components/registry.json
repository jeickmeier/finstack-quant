{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "figure-example",
      "type": "registry:component",
      "docs": "Standalone supplied-data publication example. Uses the same figure props on screen and in explicit 900x600 vector / 1800x1200 pixel exports (6x4 inches at 300 PPI). The theme includes licensed fonts; install IBM Plex Sans in a desktop editor if it cannot use embedded webfonts.",
      "files": [
        {
          "path": "figure-example/figure-example.tsx",
          "type": "registry:component",
          "target": "components/finstack/components/figure-example/figure-example.tsx"
        },
        {
          "path": "figure-example/linked-figures.tsx",
          "type": "registry:component",
          "target": "components/finstack/components/figure-example/linked-figures.tsx"
        }
      ],
      "registryDependencies": [
        "@finstack/finstack-chart",
        "@finstack/use-linked-selection"
      ]
    },
    {
      "name": "schema-form",
      "type": "registry:component",
      "docs": "Bond-subset generated schema form. Supply a lazy generated instrument module and useInstrumentValidator from the shared worker; canonical JSON is emitted only on valid submit. Basic mode hides defaulted fields. Broader renderer coverage remains gated.",
      "files": [
        {
          "path": "schema-form/schema-form.tsx",
          "type": "registry:component",
          "target": "components/finstack/components/schema-form/schema-form.tsx"
        },
        {
          "path": "schema-form/render-field.tsx",
          "type": "registry:component",
          "target": "components/finstack/components/schema-form/render-field.tsx"
        },
        {
          "path": "schema-form/schema.ts",
          "type": "registry:component",
          "target": "components/finstack/components/schema-form/schema.ts"
        },
        {
          "path": "schema-form/discriminator.ts",
          "type": "registry:component",
          "target": "components/finstack/components/schema-form/discriminator.ts"
        }
      ],
      "registryDependencies": [
        "@finstack/finstack-form",
        "@finstack/finstack-codec",
        "@finstack/enum-field"
      ],
      "dependencies": ["react@19.2.8", "zod@4.6.5"]
    }
  ]
}
