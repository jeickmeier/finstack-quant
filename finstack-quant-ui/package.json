{
  "name": "finstack-quant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./instruments": "./src/generated/instruments.ts",
    "./codec": "./src/codec.mjs",
    "./host": "./src/host.ts",
    "./views": "./src/views.ts"
  },
  "scripts": {
    "generate": "node scripts/gen.mjs && node scripts/gen-registry.mjs && node scripts/gen-theme.mjs && node scripts/encoding-report.mjs && node scripts/catalogue-docs.mjs && node scripts/gen-gallery.mjs",
    "check:generated": "node scripts/gen.mjs --check && node scripts/gen-registry.mjs --check && node scripts/gen-theme.mjs --check && node scripts/encoding-report.mjs --check && node scripts/catalogue-docs.mjs --check && node scripts/gen-gallery.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:generated && npm run format:check && npm run check:tokens && npm run check:registry && npm run typecheck && npm test",
    "format:check": "prettier --check .",
    "test:browser": "node tests/browser/run.mjs",
    "test:footprint": "REGISTRY_MEASURE_FOOTPRINT=1 node tests/browser/run.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "build": "shadcn build --output public/r",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:theme:browser": "node tests/browser/theme.mjs",
    "test:primitives:browser": "node tests/browser/primitives.mjs",
    "test:figures:browser": "node tests/browser/figures.mjs",
    "test:interactions:browser": "node tests/browser/interactions.mjs",
    "test:form:browser": "node tests/browser/schema-form.mjs",
    "test:results:browser": "node tests/browser/results.mjs",
    "test:curves:browser": "node tests/browser/curves.mjs",
    "test:pricing-forms:browser": "node tests/browser/pricing-forms.mjs",
    "test:workbench:browser": "node tests/browser/workbench.mjs",
    "test:table-link:browser": "node tests/browser/table-link.mjs",
    "test:cashflows:browser": "node tests/browser/cashflows.mjs",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@daypicker/react": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "big.js": "7.0.1",
    "comlink": "4.4.2",
    "culori": "4.0.2",
    "d3-scale": "4.0.2",
    "finstack-quant-wasm": "file:../finstack-quant-wasm",
    "lossless-json": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/big.js": "6.2.2",
    "@types/culori": "4.0.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "28.1.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.58.2",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "shadcn": "4.21.0",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-axe": "0.1.0"
  }
}
