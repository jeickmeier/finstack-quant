{
  "name": "finstack-quant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./instruments": "./src/generated/instruments.ts",
    "./codec": "./src/codec.mjs",
    "./host": "./src/host.ts",
    "./views": "./src/views.ts"
  },
  "scripts": {
    "generate": "node scripts/gen.mjs && node scripts/gen-registry.mjs && node scripts/gen-theme.mjs",
    "check:generated": "node scripts/gen.mjs --check && node scripts/gen-registry.mjs --check && node scripts/gen-theme.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:generated && npm run format:check && npm run check:tokens && npm run check:registry && npm run typecheck && npm test",
    "format:check": "prettier --check .",
    "test:browser": "node tests/browser/run.mjs",
    "test:footprint": "REGISTRY_MEASURE_FOOTPRINT=1 node tests/browser/run.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "build": "shadcn build --output public/r",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:theme:browser": "node tests/browser/theme.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-table": "9.2.4",
    "big.js": "7.0.1",
    "finstack-quant-wasm": "file:../finstack-quant-wasm",
    "lossless-json": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/big.js": "6.2.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "culori": "4.0.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.58.2",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "shadcn": "4.21.0",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
