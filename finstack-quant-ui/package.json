{
  "name": "finstack-quant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./instruments": "./src/generated/instruments.ts",
    "./codec": "./src/codec.mjs",
    "./host": "./src/host.ts",
    "./views": "./src/views.ts"
  },
  "scripts": {
    "generate": "node scripts/gen.mjs",
    "check:generated": "node scripts/gen.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:generated && npm run format:check && npm run typecheck && npm test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "finstack-quant-wasm": "file:../finstack-quant-wasm",
    "lossless-json": "4.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.2",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
