{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/lib/finstack/*": ["src/*"],
      "@/hooks/*": ["registry/hooks/*"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "tests/**/*.tsx"
  ],
  "exclude": ["tests/browser/fixture"]
}
