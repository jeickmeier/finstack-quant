{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/lib/finstack/form": ["registry/shared/lib/finstack-form/form.tsx"],
      "@/lib/finstack/*": ["src/*"],
      "@/hooks/shared/*": ["registry/shared/hooks/*"],
      "@/hooks/core/*": ["registry/core/hooks/*"],
      "@/hooks/valuations/*": ["registry/valuations/hooks/*"],
      "@/hooks/calibration/*": ["registry/calibration/hooks/*"],
      "@/hooks/models/*": ["registry/models/hooks/*"],
      "@/hooks/statements/*": ["registry/statements/hooks/*"],
      "@/workers/*": ["registry/shared/file/*"],
      "@/components/finstack/*": ["registry/*"],
      "@/components/ui/*": ["components/ui/*"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "tests/**/*.tsx",
    "components/**/*.tsx"
  ],
  "exclude": [
    "tests/browser/fixture",
    "tests/*/browser/fixture",
    "tests/install/fixture"
  ]
}
