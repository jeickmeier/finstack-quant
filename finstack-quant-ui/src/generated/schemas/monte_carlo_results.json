{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Percentile summaries of a Monte Carlo statement-model evaluation.",
  "examples": [
    {
      "forecast_periods": [
        "2025Q1",
        "2025Q2"
      ],
      "n_paths": 1000,
      "percentile_results": {
        "revenue": {
          "metric": "revenue",
          "values": {
            "2025Q1": [
              [
                0.05,
                940000
              ],
              [
                0.5,
                1000000
              ],
              [
                0.95,
                1065000
              ]
            ],
            "2025Q2": [
              [
                0.05,
                925000
              ],
              [
                0.5,
                1020000
              ],
              [
                0.95,
                1120000
              ]
            ]
          }
        }
      },
      "percentiles": [
        0.05,
        0.5,
        0.95
      ]
    }
  ],
  "properties": {
    "forecast_periods": {
      "description": "Forecast (non-actual) periods included in the simulation.",
      "items": {
        "$ref": "#/$defs/d_b888a5be75073df7b251"
      },
      "type": "array"
    },
    "n_paths": {
      "description": "Number of Monte Carlo paths simulated.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "path_data": {
      "anyOf": [
        {
          "$ref": "#/$defs/d_ce059e1e5fd8531c74da"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional full path data in long-format table form."
    },
    "percentile_results": {
      "additionalProperties": {
        "$ref": "#/$defs/d_9ebf84cf8414d0c617ec"
      },
      "description": "Aggregated percentile results: `metric → PercentileSeries`.",
      "type": "object"
    },
    "percentiles": {
      "description": "Percentiles computed for each metric/period.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Distinct warnings raised in the simulated forecast periods, each\nreported once however many paths raised it, in a canonical sorted\norder. Warnings in actual periods are omitted: those periods are not\nsimulated and every path repeats the deterministic evaluation's.",
      "items": {
        "$ref": "#/$defs/d_cf776b61125046d84b45"
      },
      "type": "array"
    }
  },
  "required": [
    "percentile_results",
    "n_paths",
    "percentiles",
    "forecast_periods"
  ],
  "title": "MonteCarloResults",
  "type": "object",
  "$id": "https://finstack_quant.dev/schemas/statements/1/monte_carlo_results.schema.json",
  "$defs": {
    "d_090e21e61cdf3e0563e2": {
      "description": "Column storage variants supported by the table envelope.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Non-null string column.",
          "properties": {
            "type": {
              "const": "string",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable string column.",
          "properties": {
            "type": {
              "const": "nullable_string",
              "type": "string"
            },
            "values": {
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null floating-point column.",
          "properties": {
            "type": {
              "const": "float64",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/d_a176fd07772b7dfa6e59"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable floating-point column.",
          "properties": {
            "type": {
              "const": "nullable_float64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null unsigned 32-bit integer column.",
          "properties": {
            "type": {
              "const": "u_int32",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable unsigned 32-bit integer column.",
          "properties": {
            "type": {
              "const": "nullable_u_int32",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null signed 64-bit integer column.",
          "properties": {
            "type": {
              "const": "int64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable signed 64-bit integer column.",
          "properties": {
            "type": {
              "const": "nullable_int64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null boolean column.",
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "d_2f3bf3b3f13fb41b2ca2": {
      "additionalProperties": false,
      "description": "A single named column in a [`TableEnvelope`].",
      "properties": {
        "data": {
          "$ref": "#/$defs/d_090e21e61cdf3e0563e2",
          "description": "Column values."
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Optional per-column metadata.",
          "type": "object"
        },
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_9c2fac7fef3fb26aaf21"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional semantic hint for bindings and consumers."
        }
      },
      "required": [
        "name",
        "data"
      ],
      "type": "object"
    },
    "d_2f44e69fe77b00d952fa": {
      "description": "Sentinel string the [`non_finite_f64`] adapter writes for a non-finite `f64`.",
      "oneOf": [
        {
          "const": "inf",
          "description": "`+∞`, written as `\"inf\"`.",
          "type": "string"
        },
        {
          "const": "-inf",
          "description": "`-∞`, written as `\"-inf\"`.",
          "type": "string"
        },
        {
          "const": "nan",
          "description": "`NaN`, written as `\"nan\"`.",
          "type": "string"
        }
      ]
    },
    "d_3c19fd4ab208f14be2b5": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "nan",
            "inf",
            "-inf"
          ]
        }
      ]
    },
    "d_797699a3f0493b0ba6f3": {
      "description": "Typed reason for a capital-structure evaluation warning.",
      "oneOf": [
        {
          "description": "A negative creditor claim was neutralized instead of reducing other claims.",
          "properties": {
            "amount": {
              "description": "Negative claim amount in the waterfall currency.",
              "format": "double",
              "type": "number"
            },
            "category": {
              "$ref": "#/$defs/d_d823a4e2fcad0a8791f3",
              "description": "Payment category containing the invalid negative claim."
            },
            "instrument_id": {
              "description": "Instrument whose claim was neutralized.",
              "type": "string"
            },
            "kind": {
              "const": "negative_claim_neutralized",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "category",
            "instrument_id",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "A negative available-cash pool was floored to zero before allocation.",
          "properties": {
            "amount": {
              "description": "Negative amount that was floored, in the waterfall currency.",
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "negative_available_cash_floored",
              "type": "string"
            },
            "node_id": {
              "description": "Statement node supplying the available-cash amount.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "Available cash was insufficient to pay a cash-interest claim.",
          "properties": {
            "amount": {
              "description": "Unpaid amount in the waterfall currency.",
              "format": "double",
              "type": "number"
            },
            "instrument_id": {
              "description": "Instrument carrying the unpaid claim forward.",
              "type": "string"
            },
            "kind": {
              "const": "interest_shortfall",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instrument_id",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "Available cash was insufficient to pay a fee claim.",
          "properties": {
            "amount": {
              "description": "Unpaid amount in the waterfall currency.",
              "format": "double",
              "type": "number"
            },
            "instrument_id": {
              "description": "Instrument carrying the unpaid claim forward.",
              "type": "string"
            },
            "kind": {
              "const": "fee_shortfall",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instrument_id",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "Available cash was insufficient to pay scheduled principal.",
          "properties": {
            "amount": {
              "description": "Unpaid amount in the waterfall currency.",
              "format": "double",
              "type": "number"
            },
            "instrument_id": {
              "description": "Instrument carrying the unpaid claim forward.",
              "type": "string"
            },
            "kind": {
              "const": "principal_shortfall",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instrument_id",
            "amount"
          ],
          "type": "object"
        }
      ]
    },
    "d_9c2fac7fef3fb26aaf21": {
      "description": "Optional semantic hint for a column.",
      "oneOf": [
        {
          "const": "dimension",
          "description": "Row identifier or primary grouping field.",
          "type": "string"
        },
        {
          "const": "index",
          "description": "Ordinal or time-like axis column.",
          "type": "string"
        },
        {
          "const": "measure",
          "description": "Numeric value column.",
          "type": "string"
        },
        {
          "const": "attribute",
          "description": "Auxiliary classification column.",
          "type": "string"
        }
      ]
    },
    "d_9ebf84cf8414d0c617ec": {
      "description": "Per-metric percentile time series.",
      "properties": {
        "metric": {
          "description": "Metric / node identifier.",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "description": "Period → ordered list of `(percentile, value)` pairs.",
          "type": "object"
        }
      },
      "required": [
        "metric",
        "values"
      ],
      "type": "object"
    },
    "d_a176fd07772b7dfa6e59": {
      "anyOf": [
        {
          "description": "A finite value, written as a JSON number.",
          "format": "double",
          "type": "number"
        },
        {
          "$ref": "#/$defs/d_2f44e69fe77b00d952fa",
          "description": "A non-finite value, written as its sentinel string."
        }
      ],
      "description": "An `f64` in the [`non_finite_f64`] wire form: a JSON number when finite,\notherwise one of the strings `\"inf\"`, `\"-inf\"` or `\"nan\"`.\n\nContract types store plain `f64` fields with\n`#[serde(with = \"finstack_quant_core::wire::non_finite_f64\")]` and name this\ntype in `#[schemars(with = ...)]`, so the generated schema describes the\nsentinel strings the serializer actually writes."
    },
    "d_b888a5be75073df7b251": {
      "description": "Identifier for a Gregorian period like `2025Q1` or a fiscal period like\n`FY2025W53`.",
      "type": "string"
    },
    "d_ce059e1e5fd8531c74da": {
      "additionalProperties": false,
      "description": "Serializable columnar table envelope.\n\nTables preserve column order and validate that every column has the same row\ncount. Optional metadata can record domain-specific hints such as which\ncolumn is a metric, what a numeric field represents, or how a host-language\nbinding should interpret the data.",
      "properties": {
        "columns": {
          "description": "Ordered set of columns.",
          "items": {
            "$ref": "#/$defs/d_2f3bf3b3f13fb41b2ca2"
          },
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "default": {},
          "description": "Table-level metadata for downstream bindings and documentation.",
          "type": "object"
        },
        "row_count": {
          "description": "Number of rows in the table.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "row_count",
        "columns"
      ],
      "type": "object"
    },
    "d_cf776b61125046d84b45": {
      "description": "Warning emitted during evaluation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A percentage change or growth rate was measured from a zero base, so\nits cell is unavailable. A division by zero in a formula is an error,\nnot this warning.",
          "properties": {
            "division_by_zero": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the node that triggered the warning.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the warning occurred.",
                  "type": "string"
                }
              },
              "required": [
                "node_id",
                "period"
              ],
              "type": "object"
            }
          },
          "required": [
            "division_by_zero"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-finite value (NaN, Inf, -Inf) detected when storing a node result.\n\nThis warning is emitted by the finiteness validation pipeline so that\nconsumers can identify which node/period introduced bad values.",
          "properties": {
            "non_finite_value": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the node that produced the non-finite value.",
                  "type": "string"
                },
                "period": {
                  "description": "Period in which the warning occurred.",
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/d_3c19fd4ab208f14be2b5",
                  "description": "The actual non-finite value, encoded as `\"nan\"`, `\"inf\"`, or `\"-inf\"`."
                }
              },
              "required": [
                "node_id",
                "period",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "non_finite_value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capital-structure extraction or waterfall processing required a guarded fallback.",
          "properties": {
            "capital_structure": {
              "properties": {
                "period": {
                  "description": "Period in which the warning was raised.",
                  "type": "string"
                },
                "warning": {
                  "$ref": "#/$defs/d_797699a3f0493b0ba6f3",
                  "description": "Typed reason and associated diagnostic values."
                }
              },
              "required": [
                "period",
                "warning"
              ],
              "type": "object"
            }
          },
          "required": [
            "capital_structure"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A forecast's published level was clipped to its `min` / `max` bound.\nThe raw level still drives the forecast's later steps.",
          "properties": {
            "forecast_clipped": {
              "properties": {
                "node_id": {
                  "description": "Identifier of the forecast node.",
                  "type": "string"
                },
                "period": {
                  "description": "Period whose published level was clipped.",
                  "type": "string"
                },
                "published": {
                  "description": "Level published after the bound, in the node's units.",
                  "format": "double",
                  "type": "number"
                },
                "raw": {
                  "description": "Level the forecast generated, in the node's units.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "node_id",
                "period",
                "raw",
                "published"
              ],
              "type": "object"
            }
          },
          "required": [
            "forecast_clipped"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A full-history statistic (`std`, `var`, `median`) was computed over a\nhistory with gaps, so its sample is smaller than its slot count.",
          "properties": {
            "gapped_sample": {
              "properties": {
                "function": {
                  "description": "Name of the statistic.",
                  "type": "string"
                },
                "node_id": {
                  "description": "Identifier of the node whose statistic has gaps.",
                  "type": "string"
                },
                "observations": {
                  "description": "Observations that had a value.",
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "period": {
                  "description": "Period the statistic was computed for.",
                  "type": "string"
                },
                "slots": {
                  "description": "Plan slots from the model start through the period.",
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "node_id",
                "period",
                "function",
                "observations",
                "slots"
              ],
              "type": "object"
            }
          },
          "required": [
            "gapped_sample"
          ],
          "type": "object"
        }
      ]
    },
    "d_d823a4e2fcad0a8791f3": {
      "description": "Cash claim category affected by a capital-structure warning.",
      "oneOf": [
        {
          "const": "fees",
          "description": "Fee claims such as commitment or facility fees.",
          "type": "string"
        },
        {
          "const": "interest",
          "description": "Cash-interest claims.",
          "type": "string"
        }
      ]
    }
  }
}
