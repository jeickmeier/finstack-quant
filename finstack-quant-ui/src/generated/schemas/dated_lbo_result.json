    "d_b1a3c01aac500ed9b346": {
      "description": "Full report aggregating all [`CheckResult`]s from a check run.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/d_c3c51cdb56917624c4ff",
          "description": "Verdict of the suite from the unfiltered check outcomes: `fail` when\nany check failed, else `incomplete` when any check is incomplete,\nelse `pass` when at least one check passed, else `unevaluated` (an\nempty suite, or one with no applicable check)."
        },
        "results": {
          "description": "Individual results for each check, in declared order.",
          "items": {
            "$ref": "#/$defs/d_93c16f623b8a2f7ada90"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/d_69ae4d1fc40a39a5e33a",
          "description": "Aggregate summary."
        }
      },
      "required": [
        "outcome",
        "results",
        "summary"
      ],
      "type": "object"
    },
    "d_c3c51cdb56917624c4ff": {
      "description": "Verdict of a check, or of a whole report, decided from every outcome\nbefore any reporting filter is applied.",
      "oneOf": [
        {
          "const": "pass",
          "description": "Work was evaluated, required coverage was complete and nothing failed.",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "At least one error-severity finding.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Nothing failed, but required data was missing or unavailable for at\nleast one period or cell.",
          "type": "string"
        },
        {
          "const": "unevaluated",
          "description": "Nothing was evaluated: an empty suite, or a check with no applicable\nperiod or cell.",
          "type": "string"
        }
      ]
    },
    "d_c5067a4bcfd83a6c2114": {
      "description": "Reconciled signed funding residual and its separately reported cash and face.",
      "properties": {
        "cash_uses": {
          "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea",
          "description": "Total transaction cash uses after separately authored credits."
        },
        "committed_cash_sources": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total explicitly committed cash sources when a sponsor commitment is supplied."
        },
        "debt_cash_proceeds": {
          "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea",
          "description": "Cash proceeds from all admitted debt sources."
        },
        "funding_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea"
            },
            {
              "type": "null"
            }
          ],
          "description": "Uses less committed cash sources. A positive amount is a shortage."
        },
        "opening_debt_face": {
          "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea",
          "description": "Contractual face outstanding at entry, separate from proceeds."
        },
        "required_sponsor_cash": {
          "$ref": "#/$defs/d_3abdbaf60c7fe57b7aea",
          "description": "Uses less debt cash proceeds, before applying sponsor cash."
        }
      },
      "required": [
        "cash_uses",
        "debt_cash_proceeds",
        "opening_debt_face",
        "required_sponsor_cash"
      ],
      "type": "object"
    },
    "d_d38aacf3b146998c3670": {
      "description": "The two values a check compared, their difference and the tolerance it\nallowed.\n\nRecorded for every numeric comparison a check performs, whether it passed\nor failed, so the verdict can be reconstructed from exported data: the\ncomparison fails exactly when `|difference| > tolerance`.\n\nEvery value is typed in the units of the compared nodes: exact money in\ntheir currency, or a scalar. `difference` is the one exact residual the\ncheck computed (an exact sum for money), not a difference of the two\nrecorded sides; `tolerance` is an absolute amount in the same units.",
      "properties": {
        "actual": {
          "$ref": "#/$defs/d_85f004180af6bb3032eb",
          "description": "Observed (left-hand) value, in the compared nodes' units."
        },
        "difference": {
          "$ref": "#/$defs/d_85f004180af6bb3032eb",
          "description": "Signed residual `actual - expected`, in the same units."
        },
        "expected": {
          "$ref": "#/$defs/d_85f004180af6bb3032eb",
          "description": "Value the identity requires (right-hand side), in the same units."
        },
        "identity": {
          "description": "Stable snake_case name of the identity that was tested (for example\n`\"balance_sheet_articulation\"` or `\"cash_flow_components\"`); a check\nthat tests several identities per period uses a distinct label for each.",
          "type": "string"
        },
        "period": {
          "description": "Period the comparison was evaluated for, if it is period-specific.",
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/d_85f004180af6bb3032eb",
          "description": "Absolute tolerance applied to `|difference|`, in the same units. This\nis the effective tolerance: the per-check override when one is\nconfigured, otherwise\n`max(default_tolerance, default_relative_tolerance * |reference|)`."
        }
      },
      "required": [
        "identity",
        "actual",
        "expected",
        "difference",
        "tolerance"
      ],
      "type": "object"
    },
    "d_efe1ae400db943a1b094": {
      "description": "Severity level for a check finding, ordered from least to most severe.",
      "oneOf": [
        {
          "const": "info",
          "description": "Informational finding — no action required.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Warning — review recommended.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Error — indicates a likely problem that should be addressed.",
          "type": "string"
        }
      ]
    }
  }
}
