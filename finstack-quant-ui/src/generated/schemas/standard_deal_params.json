  "properties": {
    "calendar_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/d_9c3fc047c6fea21344ad"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional holiday calendar for payment-date adjustment. Construction accepts\n`None`; simulation requires a calendar before generating payment dates."
    },
    "closing_date": {
      "$ref": "#/$defs/d_1b2ccb88c9229e7463e8",
      "description": "Contractual deal inception; the first accrual boundary is one registry\npayment period later (capped at maturity)."
    },
    "discount_curve_id": {
      "$ref": "#/$defs/d_9c3fc047c6fea21344ad",
      "description": "Market-context discount curve used for tranche PV."
    },
    "id": {
      "$ref": "#/$defs/d_9c3fc047c6fea21344ad",
      "description": "Stable deal identifier used for pricing results and risk labels."
    },
    "maturity": {
      "$ref": "#/$defs/d_1b2ccb88c9229e7463e8",
      "description": "Legal final date, strictly after closing."
    },
    "pool": {
      "$ref": "https://finstack_quant.dev/schemas/ui/1/shared-defs.schema.json#/$defs/AssetPool",
      "description": "Current collateral balances and contractual asset terms, in the pool currency."
    },
    "tranches": {
      "$ref": "https://finstack_quant.dev/schemas/ui/1/shared-defs.schema.json#/$defs/TrancheStructure",
      "description": "Capital structure, current note balances and coupon terms."
    }
  },
  "required": [
    "id",
    "pool",
    "tranches",
    "closing_date",
    "maturity",
    "discount_curve_id"
  ],
  "title": "StandardDealParams",
  "type": "object",
  "$id": "https://finstack_quant.dev/schemas/common/1/standard_deal_params.schema.json",
  "$defs": {
    "d_1b2ccb88c9229e7463e8": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "ISO 8601 calendar date string.",
      "examples": [
        "2024-01-15",
        "2034-01-15"
      ],
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "d_9c3fc047c6fea21344ad": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Opaque string identifier.",
      "examples": [
        "USD-OIS",
        "US912828XG33"
      ],
      "title": "Id",
      "type": "string"
    }
  }
}
