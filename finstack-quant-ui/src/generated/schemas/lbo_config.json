{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Transaction assumptions for an LBO evaluation.",
  "properties": {
    "check_mappings": {
      "anyOf": [
        {
          "$ref": "#/$defs/d_dffc33b1175f7681824d"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional mappings enabling the [`lbo_model_checks`] suite."
    },
    "entry_metric_node": {
      "description": "Node id supplying the entry valuation metric (typically `\"ebitda\"`),\nread at the explicitly selected entry period.",
      "type": "string"
    },
    "entry_multiple": {
      "description": "Entry valuation multiple applied to `entry_metric_node`, e.g. `8.5`\nfor 8.5x EBITDA.",
      "format": "double",
      "type": "number"
    },
    "entry_period": {
      "$ref": "#/$defs/d_ad3709dd7e1a54218861",
      "description": "Explicit statement observation period used to size the acquisition."
    },
    "exit_metric_node": {
      "description": "Node id supplying the exit valuation metric, read at `exit_period`.",
      "type": "string"
    },
    "exit_multiple": {
      "description": "Exit valuation multiple applied to `exit_metric_node`.",
      "format": "double",
      "type": "number"
    },
    "exit_net_debt_node": {
      "description": "Node id supplying net debt outstanding at exit, read at `exit_period`.\nThis is where a modelled amortisation schedule lands.",
      "type": "string"
    },
    "exit_period": {
      "$ref": "#/$defs/d_ad3709dd7e1a54218861",
      "description": "Period at which the sponsor exits. Periods are half-open `[start, end)`."
    },
    "sources": {
      "description": "Funded debt tranches at close. The sponsor equity check is solved as\nthe residual that balances sources against uses.",
      "items": {
        "$ref": "#/$defs/d_dd02f6f4dff5a950470b"
      },
      "type": "array"
    },
    "transaction_fees": {
      "description": "Transaction fees and expenses funded at close, in the model currency.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "entry_multiple",
    "entry_metric_node",
    "entry_period",
    "transaction_fees",
    "sources",
    "exit_multiple",
    "exit_metric_node",
    "exit_net_debt_node",
    "exit_period"
  ],
  "title": "LboConfig",
  "type": "object",
  "$id": "https://finstack_quant.dev/schemas/statements_analytics/1/lbo_config.schema.json",
  "$defs": {
    "d_11e029f4aea8705053a0": {
      "description": "Severity level for a check finding, ordered from least to most severe.",
      "oneOf": [
        {
          "const": "info",
          "description": "Informational finding — no action required.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Warning — review recommended.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Error — indicates a likely problem that should be addressed.",
          "type": "string"
        }
      ]
    },
    "d_445f5ed0781964568c7d": {
      "additionalProperties": false,
      "description": "An explicit opening balance at the first period boundary of a\nroll-forward identity.",
      "properties": {
        "date": {
          "$ref": "#/$defs/d_90233d6dc9558687a762",
          "description": "Date of the balance: the start of the model's first period."
        },
        "value": {
          "$ref": "#/$defs/d_af60afb49c6d5d79abc7",
          "description": "The balance on that date, in the units and currency of the\nreconciled balance node. A known zero is a typed zero."
        }
      },
      "required": [
        "date",
        "value"
      ],
      "type": "object"
    },
    "d_5884433b163d26991c12": {
      "additionalProperties": false,
      "description": "Maps node IDs for credit underwriting analysis.\n\nUsed by [`super::suites::credit_underwriting_checks`] to build leverage,\ncoverage, cash-flow, and trend checks. Unknown JSON keys are rejected, so\na misspelled optional key fails instead of silently disabling its check.",
      "properties": {
        "cash_burn_node": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_c9e3046f969a3cea691d"
            },
            {
              "type": "null"
            }
          ],
          "description": "Monthly cash burn node (for liquidity runway)."
        },
        "cash_node": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_c9e3046f969a3cea691d"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cash / liquidity node."
        },
        "config": {
          "$ref": "#/$defs/d_94d87fc0115f13e52ce3",
          "default": {
            "default_relative_tolerance": 0,
            "default_tolerance": 0,
            "materiality_threshold": 0,
            "min_severity": "info"
          },
          "description": "Comparison and reporting policy of the suite. Identities are compared\nexactly unless a tolerance is stated here."
        },
        "coverage_min_warn": {
          "description": "Minimum coverage ratio that triggers a warning; defaults to `1.5`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
