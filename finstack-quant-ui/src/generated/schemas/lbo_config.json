          "description": "Free cash flow node."
        },
        "interest_expense_node": {
          "$ref": "#/$defs/d_c9e3046f969a3cea691d",
          "description": "Interest expense node."
        },
        "leverage_warn": {
          "description": "`(min, max)` leverage warning range; defaults to `(0.0, 6.0)`.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "double",
              "type": "number"
