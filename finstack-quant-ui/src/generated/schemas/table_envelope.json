{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Column-oriented table with a shared row count and typed column storage.",
  "examples": [
    {
      "columns": [
        {
          "data": {
            "type": "string",
            "values": [
              "AAPL",
              "MSFT"
            ]
          },
          "name": "ticker",
          "role": "dimension"
        },
        {
          "data": {
            "type": "float64",
            "values": [
              0.6,
              0.4
            ]
          },
          "name": "weight",
          "role": "measure"
        }
      ],
      "row_count": 2
    }
  ],
  "properties": {
    "columns": {
      "description": "Ordered set of columns.",
      "items": {
        "$ref": "#/$defs/d_29b848ae6d2c610b175e"
      },
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "default": {},
      "description": "Table-level metadata for downstream bindings and documentation.",
      "type": "object"
    },
    "row_count": {
      "description": "Number of rows in the table.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "row_count",
    "columns"
  ],
  "title": "TableEnvelope",
  "type": "object",
  "$id": "https://finstack_quant.dev/schemas/table/1/table_envelope.schema.json",
  "$defs": {
    "d_1ae146054330a667eefc": {
      "description": "Column storage variants supported by the table envelope.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Non-null string column.",
          "properties": {
            "type": {
              "const": "string",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable string column.",
          "properties": {
            "type": {
              "const": "nullable_string",
              "type": "string"
            },
            "values": {
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null floating-point column.",
          "properties": {
            "type": {
              "const": "float64",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/d_5b5465b41b06bb451742"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable floating-point column.",
          "properties": {
            "type": {
              "const": "nullable_float64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null unsigned 32-bit integer column.",
          "properties": {
            "type": {
              "const": "u_int32",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable unsigned 32-bit integer column.",
          "properties": {
            "type": {
              "const": "nullable_u_int32",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null signed 64-bit integer column.",
          "properties": {
            "type": {
              "const": "int64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Nullable signed 64-bit integer column.",
          "properties": {
            "type": {
              "const": "nullable_int64",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Non-null boolean column.",
          "properties": {
            "type": {
              "const": "boolean",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "d_29b848ae6d2c610b175e": {
      "additionalProperties": false,
      "description": "A single named column in a [`TableEnvelope`].",
      "properties": {
        "data": {
          "$ref": "#/$defs/d_1ae146054330a667eefc",
          "description": "Column values."
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Optional per-column metadata.",
          "type": "object"
        },
        "name": {
          "description": "Column name.",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_bc00f88f44950a08d00d"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional semantic hint for bindings and consumers."
        }
      },
      "required": [
        "name",
        "data"
      ],
      "type": "object"
    },
    "d_523aa06debb28c76a725": {
      "description": "Sentinel string the [`non_finite_f64`] adapter writes for a non-finite `f64`.",
      "oneOf": [
        {
          "const": "inf",
          "description": "`+∞`, written as `\"inf\"`.",
          "type": "string"
        },
        {
          "const": "-inf",
          "description": "`-∞`, written as `\"-inf\"`.",
          "type": "string"
        },
        {
          "const": "nan",
          "description": "`NaN`, written as `\"nan\"`.",
          "type": "string"
        }
      ]
    },
    "d_5b5465b41b06bb451742": {
      "anyOf": [
        {
          "description": "A finite value, written as a JSON number.",
          "format": "double",
          "type": "number"
        },
        {
          "$ref": "#/$defs/d_523aa06debb28c76a725",
          "description": "A non-finite value, written as its sentinel string."
        }
      ],
      "description": "An `f64` in the [`non_finite_f64`] wire form: a JSON number when finite,\notherwise one of the strings `\"inf\"`, `\"-inf\"` or `\"nan\"`.\n\nContract types store plain `f64` fields with\n`#[serde(with = \"finstack_quant_core::wire::non_finite_f64\")]` and name this\ntype in `#[schemars(with = ...)]`, so the generated schema describes the\nsentinel strings the serializer actually writes."
    },
    "d_bc00f88f44950a08d00d": {
      "description": "Optional semantic hint for a column.",
      "oneOf": [
        {
          "const": "dimension",
          "description": "Row identifier or primary grouping field.",
          "type": "string"
        },
        {
          "const": "index",
          "description": "Ordinal or time-like axis column.",
          "type": "string"
        },
        {
          "const": "measure",
          "description": "Numeric value column.",
          "type": "string"
        },
        {
          "const": "attribute",
          "description": "Auxiliary classification column.",
          "type": "string"
        }
      ]
    }
  }
}
