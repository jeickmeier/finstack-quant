{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One forecast method with its typed parameters, in the wire shape of ForecastSpec.",
  "examples": [
    {
      "method": "fade_to_target",
      "params": {
        "shape": "linear",
        "target": 0.35
      }
    }
  ],
  "oneOf": [
    {
      "description": "Carry the last value forward.",
      "properties": {
        "method": {
          "const": "forward_fill",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_cdf57b2c9052d7e6a3f1"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    {
      "description": "Compound one growth rate per period.",
      "properties": {
        "method": {
          "const": "growth_pct",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_b5031e2afd1019fb5366"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Compound a different growth rate each period.",
      "properties": {
        "method": {
          "const": "curve_pct",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_9b3d81606bb357b45c25"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Sample an additive random walk.",
      "properties": {
        "method": {
          "const": "normal",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_c17c93b81aa1aa394bd9"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Sample a multiplicative random walk for positive values.",
      "properties": {
        "method": {
          "const": "log_normal",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_c17c93b81aa1aa394bd9"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Set exact values for chosen periods, carrying forward between them.",
      "properties": {
        "method": {
          "const": "override",
          "type": "string"
        },
        "params": {
