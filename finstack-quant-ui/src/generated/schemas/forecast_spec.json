      "properties": {
        "method": {
          "const": "time_series",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_76cf21224d1810f1ccb2"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Project a repeating pattern from a historical series.",
      "properties": {
        "method": {
          "const": "seasonal",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_0ead30fb9985712f46f4"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Sample a mean-reverting AR(1) process.",
      "properties": {
        "method": {
          "const": "mean_reverting",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_61ab76e17b1a0d1860ae"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Resample changes from a historical series.",
      "properties": {
        "method": {
          "const": "bootstrap",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/d_789205379096953ae54b"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Glide toward a target level over the forecast horizon.",
      "properties": {
        "method": {
          "const": "fade_to_target",
