{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Native cashflow rows, reporting-currency PV and reconciliation status.",
  "properties": {
    "as_of": {
      "$ref": "#/$defs/d_1b2ccb88c9229e7463e8",
      "description": "Valuation date."
    },
    "currency": {
      "$ref": "#/$defs/d_be98333e68c25ab5ae57",
      "description": "Reporting currency used for row PVs and `total_pv`."
    },
    "discount_curve_id": {
      "$ref": "#/$defs/d_9c3fc047c6fea21344ad",
      "description": "Discount curve ID used."
    },
    "flows": {
      "description": "Per-row enriched cashflows.",
      "items": {
        "$ref": "#/$defs/d_674830a94dacf97e7ac8"
      },
      "type": "array"
    },
    "hazard_curve_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/d_9c3fc047c6fea21344ad"
        },
        {
          "type": "null"
        }
      ],
      "description": "Hazard curve ID used (omitted for `discounting` model)."
    },
    "instrument_id": {
      "description": "Instrument identifier.",
      "type": "string"
    },
    "model": {
      "description": "Model key used (`\"discounting\"` or `\"hazard_rate\"`).",
      "type": "string"
    },
    "reconciles_with_base_value": {
      "description": "`true` when `total_pv` agrees with the instrument's canonical\n`base_value` (`Instrument::value`) within rounding tolerance. The\nexporter returns an error instead of emitting a non-reconciling\nenvelope, so every successful response carries `true`.",
      "type": "boolean"
    },
    "recovery_rate": {
      "description": "Recovery rate from the hazard curve (omitted for `discounting` model).",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "total_pv": {
      "description": "Sum of `flows[i].pv`. Matches `base_value` for supported products.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "instrument_id",
    "currency",
    "model",
    "as_of",
    "discount_curve_id",
    "flows",
    "total_pv",
    "reconciles_with_base_value"
  ],
  "title": "Instrument Cashflow",
  "type": "object",
  "$id": "https://finstack_quant.dev/schemas/results/1/instrument_cashflow.schema.json",
  "$defs": {
    "d_1b2ccb88c9229e7463e8": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "ISO 8601 calendar date string.",
      "examples": [
        "2024-01-15",
        "2034-01-15"
      ],
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "d_674830a94dacf97e7ac8": {
      "description": "Single-row enriched cashflow view.",
      "properties": {
        "accrual_factor": {
          "description": "Accrual factor stored on the `CashFlow`.",
          "format": "double",
          "type": "number"
        },
        "amount": {
          "description": "Signed cashflow amount in row currency.",
          "format": "double",
          "type": "number"
        },
        "beginning_balance": {
          "description": "Beginning pool balance for the period (agency MBS only).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "conditional_default_prob": {
          "description": "Interval default probability `SP(t_{i-1}) − SP(t_i)` (hazard mode only).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "$ref": "#/$defs/d_be98333e68c25ab5ae57",
          "description": "Row currency (matters for `XccySwap` / `FxSwap`)."
        },
        "date": {
          "$ref": "#/$defs/d_1b2ccb88c9229e7463e8",
          "description": "Payment date."
        },
        "discount_curve_id": {
          "$ref": "#/$defs/d_9c3fc047c6fea21344ad",
          "description": "Discount curve used for this row."
        },
        "discount_factor": {
          "description": "`df(as_of, date)`.",
          "format": "double",
          "type": "number"
        },
        "ending_balance": {
          "description": "Ending pool balance for the period (agency MBS only).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "inflation_index_ratio": {
          "description": "Inflation index ratio (populated for `InflationLinkedBond`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/d_c1062118d66ed5ee9642",
          "description": "`CFKind` discriminator (serde rename: `fixed`, `notional`, …)."
        },
        "prepayment_smm": {
          "description": "Single Monthly Mortality for the period (populated for agency MBS).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pv": {
          "description": "Per-flow present value in the envelope reporting currency. Sums to `total_pv`.",
          "format": "double",
          "type": "number"
        },
        "rate": {
          "description": "Projected / contractual rate when present (floats, real-coupon rates, etc.).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reset_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/d_1b2ccb88c9229e7463e8"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reset date when the flow is a floating-rate fixing."
        },
        "survival_probability": {
          "description": "Cumulative survival probability (hazard mode only).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "year_fraction": {
          "description": "Year fraction from `as_of` to `date` under the discount curve's day count.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "date",
        "amount",
        "currency",
        "kind",
        "accrual_factor",
        "year_fraction",
        "discount_factor",
        "discount_curve_id",
        "pv"
      ],
      "type": "object"
    },
    "d_9c3fc047c6fea21344ad": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Opaque string identifier.",
      "examples": [
        "USD-OIS",
        "US912828XG33"
      ],
      "title": "Id",
      "type": "string"
    },
