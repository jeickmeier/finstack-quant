    "SimmCurvatureSensitivity": {
      "additionalProperties": false,
      "description": "One volatility-weighted vega input before SIMM curvature scaling.\n\nThe amount is `sigma * dPV/dsigma` in the sensitivity container's base\ncurrency, before HVR, vega risk weights or concentration. For equity, FX\nand commodity, `sigma` is the paragraph 10(b) prescribed volatility proxy;\nfor rates and credit it is the matching quoted ATM volatility. Preserve\nseparate expiries until `SF(t) = 0.5 * min(1, 14/t_days)` has been applied.",
      "properties": {
        "bucket": {
          "description": "Currency code for IR, credit sector for qualifying credit, numeric\ncommodity bucket, `fx` for FX, or `residual` for equity/non-qualifying credit.",
          "type": "string"
        },
        "expiry_tenor": {
          "description": "Option-expiry tenor from [`SIMM_TENORS`]. Two weeks means 14 calendar\ndays; months use 365/12 days and years use 365 days.",
          "type": "string"
        },
        "factor": {
          "description": "IR subcurve name, credit issuer, equity underlier, commodity name,\nor an FX currency pair such as `EUR/USD`; must be nonempty.",
          "type": "string"
        },
        "risk_class": {
          "$ref": "#/$defs/SimmRiskClass",
          "description": "SIMM risk class selecting the prescribed bucket and correlation rules."
        },
        "risk_tenor": {
          "description": "IR or credit risk-factor tenor. Required for IR and credit; absent for\nequity, commodity and FX. This is distinct from the option expiry.",
          "type": [
            "string",
            "null"
          ]
        },
        "volatility_weighted_vega": {
          "description": "Signed base-currency `sigma * dPV/dsigma` before SF, HVR, VRW or concentration.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "risk_class",
        "bucket",
        "factor",
        "expiry_tenor",
        "volatility_weighted_vega"
      ],
      "type": "object"
    },
    "SimmRiskClass": {
      "description": "Risk classes for SIMM categorization.",
      "oneOf": [
        {
          "const": "interest_rate",
