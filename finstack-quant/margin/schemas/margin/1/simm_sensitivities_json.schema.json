  "additionalProperties": false,
  "description": "JSON-friendly representation of `SimmSensitivities`.",
  "examples": [
    {
      "base_currency": "USD",
      "commodity_delta": [],
      "commodity_vega": [],
      "credit_non_qualifying_delta": [],
      "credit_non_qualifying_vega": [],
      "credit_qualifying_delta": [],
      "credit_qualifying_vega": [],
      "curvature": [],
      "equity_delta": [
        [
          "AAPL",
          250000.0
        ]
      ],
      "equity_vega": [],
      "fx_delta": [
        [
          "EUR",
          400000.0
        ]
      ],
      "fx_vega": [],
      "ir_delta": [
        [
          "USD",
          "10Y",
          -8000.0
        ],
        [
          "USD",
          "5Y",
          12500.0
        ]
      ],
      "ir_vega": []
