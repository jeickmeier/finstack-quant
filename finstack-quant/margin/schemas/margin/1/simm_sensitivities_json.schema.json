{
  "$defs": {
    "SimmCreditSector": {
      "description": "SIMM credit sector for bucket assignment.\n\nMaps reference entities to ISDA SIMM credit qualifying buckets.\nSee ISDA SIMM v2.6 Table 2.",
      "oneOf": [
        {
          "const": "sovereign",
          "description": "Bucket 1: IG sovereigns including central banks.",
          "type": "string"
        },
        {
          "const": "financial",
          "description": "Bucket 2: IG financials including government-backed financials.",
          "type": "string"
        },
        {
          "const": "basic_materials",
          "description": "Bucket 3: IG basic materials, energy, and industrials.",
          "type": "string"
        },
        {
          "const": "consumer_goods",
          "description": "Bucket 4: IG consumer goods and services.",
          "type": "string"
        },
        {
          "const": "technology_media",
          "description": "Bucket 5: IG technology, telecommunications.",
          "type": "string"
        },
        {
          "const": "health_care",
          "description": "Bucket 6: IG health care, utilities, local government, and government-backed corporates.",
          "type": "string"
        },
        {
          "const": "high_yield_sovereign",
          "description": "Bucket 7: HY / non-rated sovereigns including central banks.",
          "type": "string"
        },
        {
          "const": "high_yield_financial",
          "description": "Bucket 8: HY / non-rated financials including government-backed financials.",
          "type": "string"
        },
        {
          "const": "high_yield_basic_materials",
          "description": "Bucket 9: HY / non-rated basic materials, energy, and industrials.",
          "type": "string"
        },
        {
          "const": "high_yield_consumer_goods",
          "description": "Bucket 10: HY / non-rated consumer goods and services.",
          "type": "string"
        },
        {
          "const": "high_yield_technology_media",
          "description": "Bucket 11: HY / non-rated technology, telecommunications.",
          "type": "string"
        },
        {
          "const": "high_yield_health_care",
          "description": "Bucket 12: HY / non-rated health care, utilities, local government, and government-backed corporates.",
          "type": "string"
        },
        {
          "const": "residual",
          "description": "Residual bucket.",
          "type": "string"
        }
      ]
    },
    "SimmCurvatureSensitivity": {
      "additionalProperties": false,
      "description": "One volatility-weighted vega input before SIMM curvature scaling.\n\nThe amount is `sigma * dPV/dsigma` in the sensitivity container's base\ncurrency, before HVR, vega risk weights or concentration. For equity, FX\nand commodity, `sigma` is the paragraph 10(b) prescribed volatility proxy;\nfor rates and credit it is the matching quoted ATM volatility. Preserve\nseparate expiries until `SF(t) = 0.5 * min(1, 14/t_days)` has been applied.",
      "properties": {
        "bucket": {
          "description": "Currency code for IR, credit sector for qualifying credit, numeric\ncommodity bucket, `fx` for FX, or `residual` for equity/non-qualifying credit.",
          "type": "string"
        },
        "expiry_tenor": {
          "description": "Option-expiry tenor from [`SIMM_TENORS`]. Two weeks means 14 calendar\ndays; months use 365/12 days and years use 365 days.",
          "type": "string"
        },
        "factor": {
          "description": "IR subcurve name, credit issuer, equity underlier, commodity name,\nor an FX currency pair such as `EUR/USD`; must be nonempty.",
          "type": "string"
        },
        "risk_class": {
          "$ref": "#/$defs/SimmRiskClass",
          "description": "SIMM risk class selecting the prescribed bucket and correlation rules."
        },
        "risk_tenor": {
          "description": "IR or credit risk-factor tenor. Required for IR and credit; absent for\nequity, commodity and FX. This is distinct from the option expiry.",
          "type": [
            "string",
            "null"
          ]
        },
        "volatility_weighted_vega": {
          "description": "Signed base-currency `sigma * dPV/dsigma` before SF, HVR, VRW or concentration.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "risk_class",
        "bucket",
        "factor",
        "expiry_tenor",
        "volatility_weighted_vega"
      ],
      "type": "object"
    },
    "SimmRiskClass": {
      "description": "Risk classes for SIMM categorization.",
      "oneOf": [
        {
          "const": "interest_rate",
          "description": "Interest rate risk",
          "type": "string"
        },
        {
          "const": "credit_qualifying",
          "description": "Credit qualifying (corporate, sovereign, and index credit, including high yield)",
          "type": "string"
        },
        {
          "const": "credit_non_qualifying",
          "description": "Credit non-qualifying (securitizations and designated non-qualifying exposures)",
          "type": "string"
        },
        {
          "const": "equity",
          "description": "Equity risk",
          "type": "string"
        },
        {
          "const": "commodity",
          "description": "Commodity risk",
          "type": "string"
        },
        {
          "const": "fx",
          "description": "Foreign exchange risk",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/margin/1/simm_sensitivities_json.schema.json",
