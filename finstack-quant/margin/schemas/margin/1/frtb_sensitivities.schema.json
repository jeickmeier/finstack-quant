    "RraoPosition": {
      "description": "A position subject to the Residual Risk Add-On.\n\nRRAO applies to exotic instruments whose risks are not adequately\ncaptured by the delta/vega/curvature framework -- instruments with\ngap risk, correlation risk, or behavioral risk.",
      "properties": {
        "instrument_id": {
