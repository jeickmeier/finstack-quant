{
  "$defs": {
    "DrcPosition": {
      "additionalProperties": false,
      "description": "A position subject to the Default Risk Charge.\n\nPer MAR22.9, gross JTD for a position is:\n\n```text\nlong:  gross = max(LGD * notional + P&L, 0)\nshort: gross = min(LGD * notional + P&L, 0)\n```\n\nwhere the `P&L` term captures any mark-to-market adjustment already\nreflected in the trading-book valuation (e.g. an underwater long bond\nhas a small negative `P&L` that reduces the exposed JTD). `jtd_amount`\nrepresents the signed *notional* (positive = long, negative = short);\n`FrtbSbaEngine` multiplies by [`DrcSeniority`]\nLGD and then applies the `pnl_adjustment` and the sign-preserving floor.",
      "properties": {
        "issuer": {
          "description": "Issuer identifier.",
          "type": "string"
        },
        "jtd_amount": {
          "description": "Signed JTD *notional* (positive = long, negative = short). Does\n**not** include the LGD multiplier — `FrtbSbaEngine` applies LGD.",
          "format": "double",
          "type": "number"
        },
        "maturity_years": {
          "description": "Residual contractual maturity in years; scaled into [0.25, 1.0] for JTD.\nCash equities use the elected three-month or greater-than-one-year horizon.",
          "format": "double",
          "type": "number"
        },
        "pnl_adjustment": {
          "default": 0.0,
          "description": "Mark-to-market / P&L adjustment from MAR22.9. Default 0. Add a\nnegative value for a long position with unrealised loss so the\ngross JTD is correctly floored at zero when the mark-down already\nexceeds `LGD * notional`.",
          "format": "double",
          "type": "number"
        },
        "rating_bucket": {
          "description": "Credit rating bucket (1-based per FRTB specification).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "sector": {
          "$ref": "#/$defs/DrcSector",
          "description": "Sector for DRC bucket assignment."
        },
        "seniority": {
          "$ref": "#/$defs/DrcSeniority",
          "description": "Seniority for LGD determination."
        }
      },
      "required": [
        "maturity_years",
        "issuer",
        "jtd_amount",
        "rating_bucket",
        "sector",
        "seniority"
      ],
      "type": "object"
    },
    "DrcSector": {
      "description": "DRC sector classification.",
      "oneOf": [
        {
          "const": "sovereign",
          "description": "Sovereign entities.",
          "type": "string"
        },
        {
          "const": "corporate",
          "description": "Corporate issuers, including financial institutions and equities.",
          "type": "string"
        },
        {
          "const": "local_government",
          "description": "Local governments and municipalities.",
          "type": "string"
        }
      ]
    },
    "DrcSeniority": {
      "description": "DRC seniority for LGD assignment.",
      "oneOf": [
        {
          "const": "covered_bond",
          "description": "Covered bonds, 25% loss given default.",
          "type": "string"
        },
        {
          "const": "senior_unsecured",
          "description": "Senior unsecured debt.",
          "type": "string"
        },
        {
          "const": "subordinated",
          "description": "Subordinated debt.",
          "type": "string"
        },
        {
          "const": "equity",
          "description": "Equity instruments.",
          "type": "string"
        }
      ]
    },
    "RraoPosition": {
      "description": "A position subject to the Residual Risk Add-On.\n\nRRAO applies to exotic instruments whose risks are not adequately\ncaptured by the delta/vega/curvature framework -- instruments with\ngap risk, correlation risk, or behavioral risk.",
      "properties": {
        "instrument_id": {
          "description": "Instrument identifier.",
          "type": "string"
        },
        "is_exotic": {
          "description": "Whether the instrument bears exotic underlying risk (1.0% weight)\nor other residual risk (0.1% weight).",
          "type": "boolean"
        },
        "notional": {
          "description": "Gross notional amount.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "instrument_id",
        "notional",
        "is_exotic"
      ],
      "type": "object"
    }
  },
