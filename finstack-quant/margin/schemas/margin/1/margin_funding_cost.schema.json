{
  "$id": "https://finstack_quant.dev/schemas/margin/1/margin_funding_cost.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Margin funding cost result.",
  "examples": [
    {
      "annual_cost": {
        "amount": "25000.000000000020000000",
        "currency": "USD"
      },
      "collateral_rate": 0.0525,
      "funding_rate": 0.055,
      "margin_posted": {
        "amount": "10000000",
        "currency": "USD"
      }
    }
  ],
  "properties": {
    "annual_cost": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Net funding cost (annualized)"
    },
    "collateral_rate": {
      "description": "Collateral return rate (e.g., Fed Funds)",
      "format": "double",
      "type": "number"
    },
    "funding_rate": {
      "description": "Funding rate (annualized)",
      "format": "double",
      "type": "number"
    },
    "margin_posted": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Posted margin amount"
    }
  },
  "required": [
    "margin_posted",
    "funding_rate",
    "collateral_rate",
    "annual_cost"
  ],
  "title": "MarginFundingCost",
  "type": "object"
}
