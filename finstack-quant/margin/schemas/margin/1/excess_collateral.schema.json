    },
    "excess": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Excess amount (positive) or shortfall (negative)"
    },
    "required_value": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Required value"
    }
  },
  "required": [
    "collateral_value",
    "required_value",
    "excess"
  ],
  "title": "ExcessCollateral",
  "type": "object"
}
