  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Rating factor table for a specific rating-agency methodology.",
  "properties": {
    "agency": {
      "type": "string"
    },
    "default_factor": {
      "format": "double",
      "type": "number"
    },
    "factors": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "type": "object"
    },
