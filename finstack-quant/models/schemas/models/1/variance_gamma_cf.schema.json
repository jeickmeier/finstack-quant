{
  "$id": "https://finstack_quant.dev/schemas/models/1/variance_gamma_cf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Variance Gamma model characteristic function.",
  "properties": {
    "nu": {
      "description": "Variance rate of the Gamma subordinator (`nu > 0`).",
      "format": "double",
      "type": "number"
    },
    "q": {
      "description": "Dividend yield.",
      "format": "double",
      "type": "number"
    },
    "r": {
      "description": "Risk-free rate.",
      "format": "double",
      "type": "number"
    },
    "sigma": {
      "description": "Volatility of the subordinated Brownian motion (`sigma > 0`).",
      "format": "double",
      "type": "number"
    },
    "theta": {
      "description": "Drift of the subordinated Brownian motion.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "r",
    "q",
    "sigma",
    "nu",
    "theta"
  ],
  "title": "VarianceGammaCf",
  "type": "object"
}
