{
  "$id": "https://finstack_quant.dev/schemas/models/1/brownian_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters for one-dimensional Brownian motion with drift.",
  "properties": {
    "mu": {
      "description": "Constant drift per year.",
      "format": "double",
      "type": "number"
    },
    "sigma": {
      "description": "Constant diffusion scale per square root year.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "mu",
    "sigma"
  ],
  "title": "BrownianParams",
  "type": "object"
}
