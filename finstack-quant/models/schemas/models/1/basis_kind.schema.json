{
  "$id": "https://finstack_quant.dev/schemas/models/1/basis_kind.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Supported regression basis families for LSMC pricers.",
  "oneOf": [
    {
      "const": "laguerre",
