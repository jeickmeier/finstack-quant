{
  "$defs": {
    "CorrelationWire": {
      "description": "Finite correlation coefficient in the closed interval `[-1, 1]`.",
      "format": "double",
      "maximum": 1.0,
      "minimum": -1.0,
      "type": "number"
    },
    "NonNegativeF64Wire": {
      "description": "Finite JSON number greater than or equal to zero.",
      "format": "double",
      "minimum": 0.0,
      "type": "number"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/models/1/latent_factor_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Factor model specification for configuration and serialization.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "mean_reversion": {
          "$ref": "#/$defs/NonNegativeF64Wire",
          "description": "Finite non-negative mean-reversion speed per year."
        },
        "type": {
          "const": "single_factor",
          "type": "string"
        },
        "volatility": {
          "$ref": "#/$defs/NonNegativeF64Wire",
          "description": "Finite non-negative decimal factor volatility."
        }
      },
      "required": [
        "type",
        "volatility",
        "mean_reversion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "correlation": {
          "$ref": "#/$defs/CorrelationWire",
          "description": "Gaussian correlation in [-1, 1], including endpoints."
        },
        "credit_vol": {
          "$ref": "#/$defs/NonNegativeF64Wire",
          "description": "Finite non-negative decimal credit-factor volatility."
        },
        "prepay_vol": {
          "$ref": "#/$defs/NonNegativeF64Wire",
          "description": "Finite non-negative decimal prepayment-factor volatility."
        },
        "type": {
          "const": "two_factor",
          "type": "string"
        }
      },
      "required": [
        "type",
        "prepay_vol",
        "credit_vol",
        "correlation"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "correlations": {
          "description": "Row-major square Gaussian correlation matrix with entries in [-1, 1].",
          "items": {
            "$ref": "#/$defs/CorrelationWire"
          },
          "type": "array"
        },
        "num_factors": {
          "description": "Positive number of factors.",
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "multi_factor",
          "type": "string"
        },
        "volatilities": {
          "description": "One finite non-negative decimal volatility per factor.",
          "items": {
            "$ref": "#/$defs/NonNegativeF64Wire"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "num_factors",
        "volatilities",
        "correlations"
      ],
      "type": "object"
    }
  ],
  "title": "LatentFactorSpec"
}
