    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
      "type": "string"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "Numeric Monte Carlo estimate for discounted path values.\n\nAll fields are unitless `f64` values in the same numeric unit as the\nsimulated discounted payoff. Pricing APIs usually wrap the mean and\nconfidence interval in [`finstack_quant_core::money::Money`] after choosing a\ncurrency.",
      "properties": {
        "ci_95": {
          "description": "95% confidence interval for the discounted mean.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "double",
              "type": "number"
            },
            {
              "format": "double",
              "type": "number"
            }
          ],
          "type": "array"
        },
        "max": {
          "description": "Optional maximum of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "description": "Mean of the discounted path values.",
          "format": "double",
          "type": "number"
        },
        "median": {
          "description": "Optional median of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "description": "Optional minimum of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "num_paths": {
          "description": "Number of independent path estimators contributing to the estimate.\n\nWith variance reduction disabled (`antithetic = false`), this equals the\nnumber of simulated sample paths. With antithetic variates enabled each\nestimator is the mean of an antithetic pair, so\n`num_simulated_paths == 2 * num_paths`. The engine records both so\ndownstream consumers can distinguish statistical sample size from\nsimulation work.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "num_simulated_paths": {
          "description": "Total number of simulated sample paths driving the estimator.\n\nEqual to `num_paths` without variance reduction. When\n[`crate::monte_carlo::engine::McEngineConfig::antithetic`] is enabled this is twice\n`num_paths` because each estimator averages an antithetic pair of\npaths.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "percentile_25": {
          "description": "Optional 25th percentile of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "percentile_75": {
          "description": "Optional 75th percentile of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "std_dev": {
          "description": "Optional sample standard deviation of discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "stderr": {
          "description": "Standard error of the discounted mean.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "stderr",
        "ci_95",
        "num_paths",
        "num_simulated_paths"
      ],
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "MoneyEstimate": {
      "additionalProperties": false,
      "description": "Discounted Monte Carlo estimate tagged with a currency.\n\nThe engine computes these values from discounted path outcomes. `mean` and\n`ci_95` are stored as [`Money`], while the auxiliary statistics remain raw\n`f64` values in the same currency unit as `mean.amount()`.",
      "properties": {
        "ci_95": {
          "description": "95% confidence interval for the discounted mean present value.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Money"
