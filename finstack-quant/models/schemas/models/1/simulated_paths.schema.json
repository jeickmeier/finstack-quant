{
  "$id": "https://finstack_quant.dev/schemas/models/1/simulated_paths.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Results from Monte Carlo path simulation.",
  "properties": {
    "asset_values": {
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "num_paths": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "num_steps": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "times": {
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    }
  },
  "required": [
    "times",
    "asset_values",
    "num_paths",
    "num_steps"
  ],
  "title": "SimulatedPaths",
  "type": "object"
}
