{
  "$id": "https://finstack_quant.dev/schemas/models/1/heston_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Heston stochastic volatility model parameters.",
  "properties": {
    "kappa": {
      "description": "Mean reversion speed.",
      "format": "double",
      "type": "number"
    },
    "rho": {
      "description": "Spot-variance correlation.",
      "format": "double",
      "type": "number"
    },
    "sigma_v": {
      "description": "Vol-of-vol.",
      "format": "double",
      "type": "number"
    },
    "theta": {
      "description": "Long-run variance.",
      "format": "double",
      "type": "number"
    },
    "v0": {
      "description": "Initial variance.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "v0",
    "kappa",
    "theta",
    "sigma_v",
    "rho"
  ],
  "title": "HestonParams",
  "type": "object"
}
