{
  "$defs": {
    "ClosedUnitIntervalF64Wire": {
      "description": "Finite JSON number in the closed interval `[0, 1]`.",
      "format": "double",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "CreditConversionFactor": {
      "additionalProperties": false,
      "description": "Credit Conversion Factor (CCF) for off-balance-sheet exposures.\n\nRepresents the fraction of undrawn commitments expected to be drawn\nat the time of default.",
