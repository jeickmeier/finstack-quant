          "$ref": "#/$defs/ClosedUnitIntervalF64Wire"
        }
      },
      "required": [
        "ccf"
      ],
      "type": "object"
    },
    "NonNegativeF64Wire": {
      "description": "Finite JSON number greater than or equal to zero.",
      "format": "double",
      "minimum": 0.0,
      "type": "number"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/models/1/ead_calculator.schema.json",
