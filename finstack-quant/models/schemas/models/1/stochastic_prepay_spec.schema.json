{
  "$defs": {
    "PrepaymentModelSpec": {
      "description": "Prepayment curve shape.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Constant CPR (no seasoning effect)",
          "properties": {
            "cpr": {
              "description": "Annual decimal CPR in `[0, 1]`.",
              "format": "double",
              "type": "number"
            },
            "curve": {
              "const": "constant",
              "type": "string"
            }
          },
          "required": [
            "curve",
            "cpr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PSA standard curve: ramps to 6% CPR over 30 months",
          "properties": {
            "curve": {
              "const": "psa",
              "type": "string"
            },
            "speed_multiplier": {
              "description": "Speed multiplier (1.0 = 100% PSA)",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "speed_multiplier"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "CMBS-style lockout: zero prepayment for an initial period, then constant CPR.\n\nCommercial mortgage-backed securities typically have prepayment lockout\nperiods (defeasance/yield maintenance) lasting 5-10 years, after which\nvoluntary prepayment resumes at the specified CPR.",
          "properties": {
            "curve": {
              "const": "cmbs_lockout",
              "type": "string"
            },
            "lockout_months": {
              "description": "Number of months with zero prepayment (e.g., 60 for 5-year lockout)",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "post_lockout_cpr": {
              "description": "Annual decimal CPR after lockout, in `[0, 1]`.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "lockout_months",
            "post_lockout_cpr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "ABS speed: each month a constant share of the *original* balance\nprepays, so the single-month mortality rises with seasoning,\n`SMM_t = ABS / (1 − ABS·(t − 1))` (Fabozzi, *Handbook of Fixed Income\nSecurities*, auto-loan ABS convention).",
          "properties": {
            "curve": {
              "const": "abs",
              "type": "string"
            },
            "speed": {
              "description": "Monthly prepayment as a decimal fraction of the original balance\n(`0.015` = 1.5% ABS).",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "speed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit annual CPR for each month of seasoning; the last value is\nheld for later months.",
          "properties": {
            "curve": {
              "const": "vector",
              "type": "string"
            },
            "monthly_cpr": {
              "description": "Annual CPR per month of seasoning as decimals, month 1 first.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "curve",
            "monthly_cpr"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/models/1/stochastic_prepay_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stochastic prepayment model specification.",
  "oneOf": [
    {
      "description": "Use deterministic prepayment model (no stochastic component).",
      "oneOf": [
        {
          "description": "Constant CPR (no seasoning effect)",
          "properties": {
            "cpr": {
              "description": "Annual decimal CPR in `[0, 1]`.",
              "format": "double",
              "type": "number"
            },
            "curve": {
              "const": "constant",
              "type": "string"
            }
          },
          "required": [
            "curve",
            "cpr"
          ],
          "type": "object"
        },
        {
          "description": "PSA standard curve: ramps to 6% CPR over 30 months",
          "properties": {
            "curve": {
              "const": "psa",
              "type": "string"
            },
            "speed_multiplier": {
              "description": "Speed multiplier (1.0 = 100% PSA)",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "speed_multiplier"
          ],
          "type": "object"
        },
        {
          "description": "CMBS-style lockout: zero prepayment for an initial period, then constant CPR.\n\nCommercial mortgage-backed securities typically have prepayment lockout\nperiods (defeasance/yield maintenance) lasting 5-10 years, after which\nvoluntary prepayment resumes at the specified CPR.",
          "properties": {
            "curve": {
              "const": "cmbs_lockout",
              "type": "string"
            },
            "lockout_months": {
              "description": "Number of months with zero prepayment (e.g., 60 for 5-year lockout)",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "post_lockout_cpr": {
              "description": "Annual decimal CPR after lockout, in `[0, 1]`.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "lockout_months",
            "post_lockout_cpr"
          ],
          "type": "object"
        },
        {
          "description": "ABS speed: each month a constant share of the *original* balance\nprepays, so the single-month mortality rises with seasoning,\n`SMM_t = ABS / (1 − ABS·(t − 1))` (Fabozzi, *Handbook of Fixed Income\nSecurities*, auto-loan ABS convention).",
          "properties": {
            "curve": {
              "const": "abs",
              "type": "string"
            },
            "speed": {
              "description": "Monthly prepayment as a decimal fraction of the original balance\n(`0.015` = 1.5% ABS).",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "curve",
            "speed"
          ],
          "type": "object"
        },
        {
          "description": "Explicit annual CPR for each month of seasoning; the last value is\nheld for later months.",
          "properties": {
            "curve": {
              "const": "vector",
              "type": "string"
            },
            "monthly_cpr": {
              "description": "Annual CPR per month of seasoning as decimals, month 1 first.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "curve",
            "monthly_cpr"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "model": {
          "const": "deterministic",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Factor-correlated prepayment model.\n\nSimple stochastic model that shocks base CPR by systematic factor.",
      "properties": {
        "base_spec": {
          "$ref": "#/$defs/PrepaymentModelSpec",
          "description": "Base deterministic prepayment specification"
        },
        "cpr_volatility": {
          "description": "CPR volatility (typical: 0.15-0.30)",
          "format": "double",
          "type": "number"
        },
        "factor_loading": {
          "description": "Factor loading (typical: 0.3-0.5)",
          "format": "double",
          "type": "number"
        },
        "model": {
          "const": "factor_correlated",
          "type": "string"
        }
      },
      "required": [
        "model",
        "base_spec",
        "factor_loading",
        "cpr_volatility"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Richard-Roll prepayment model for RMBS.\n\nFull stochastic model with refinancing incentive, seasoning and\nburnout.",
      "properties": {
        "base_cpr": {
          "description": "Base CPR at full seasoning",
          "format": "double",
          "type": "number"
        },
        "burnout_rate": {
          "description": "Burnout decay rate",
          "format": "double",
          "type": "number"
        },
        "cpr_volatility": {
          "default": 0.2,
          "description": "CPR volatility",
          "format": "double",
          "type": "number"
        },
        "factor_loading": {
          "default": 0.4,
          "description": "Factor loading for correlation",
          "format": "double",
          "type": "number"
        },
        "model": {
          "const": "richard_roll",
          "type": "string"
        },
        "pool_coupon": {
          "description": "AssetPool weighted average coupon",
          "format": "double",
          "type": "number"
        },
        "refi_sensitivity": {
          "description": "Refinancing sensitivity (gamma)",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "model",
        "base_cpr",
        "refi_sensitivity",
        "pool_coupon",
        "burnout_rate"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Regime-switching prepayment model.\n\nTwo-state Markov model, initially in the low regime at origination.\nEvery simulated month transitions before computing its monthly rate.\nLatent transition draws are independent of the systematic CPR shock.",
      "properties": {
        "cpr_volatility": {
          "default": 0.2,
          "description": "CPR volatility for systematic prepayment shocks.",
          "format": "double",
          "type": "number"
        },
        "factor_loading": {
          "default": 0.4,
          "description": "Factor loading for systematic prepayment shocks.",
          "format": "double",
          "type": "number"
        },
        "high_cpr": {
          "description": "CPR in high prepayment regime",
          "format": "double",
          "type": "number"
        },
        "low_cpr": {
          "description": "CPR in low prepayment regime",
          "format": "double",
          "type": "number"
        },
        "model": {
          "const": "regime_switching",
          "type": "string"
        },
        "transition_down": {
          "description": "Transition probability: high -> low (per month)",
          "format": "double",
          "type": "number"
        },
        "transition_up": {
          "description": "Transition probability: low -> high (per month)",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "model",
        "low_cpr",
        "high_cpr",
        "transition_up",
        "transition_down"
      ],
      "type": "object"
    }
  ],
  "title": "StochasticPrepaySpec"
}
