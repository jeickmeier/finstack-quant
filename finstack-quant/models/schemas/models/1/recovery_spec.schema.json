{
  "$id": "https://finstack_quant.dev/schemas/models/1/recovery_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Recovery model specification for configuration and serialization.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "rate": {
          "format": "double",
          "type": "number"
        },
        "type": {
          "const": "constant",
          "type": "string"
        }
      },
      "required": [
        "type",
        "rate"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "factor_correlation": {
          "format": "double",
          "type": "number"
        },
        "mean_recovery": {
          "format": "double",
          "type": "number"
        },
        "recovery_volatility": {
          "format": "double",
          "type": "number"
        },
        "type": {
          "const": "market_correlated",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mean_recovery",
        "recovery_volatility",
        "factor_correlation"
      ],
      "type": "object"
    }
  ],
  "title": "RecoverySpec"
}
