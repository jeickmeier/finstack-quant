    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "MoneyEstimate": {
      "additionalProperties": false,
      "description": "Discounted Monte Carlo estimate tagged with a currency.\n\nThe engine computes these values from discounted path outcomes. `mean` and\n`ci_95` are stored as [`Money`], while the auxiliary statistics remain raw\n`f64` values in the same currency unit as `mean.amount()`.",
      "properties": {
        "ci_95": {
          "description": "95% confidence interval for the discounted mean present value.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "$ref": "#/$defs/Money"
            }
          ],
          "type": "array"
        },
        "max": {
          "description": "Optional maximum of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "$ref": "#/$defs/Money",
          "description": "Discounted mean present value."
        },
        "median": {
          "description": "Optional median of captured discounted path values.\n\nThis is populated only when captured-path diagnostics are available.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "description": "Optional minimum of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "num_paths": {
          "description": "Number of independent path estimators contributing to the estimate.\n\nSee [`crate::monte_carlo::estimate::Estimate::num_paths`] for the full semantics,\nincluding how antithetic variates split simulated work across\nestimators.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "num_simulated_paths": {
          "description": "Total number of simulated sample paths driving the estimator.\n\nSee [`crate::monte_carlo::estimate::Estimate::num_simulated_paths`]. Equal to\n`num_paths` without variance reduction, or `2 * num_paths` with\nantithetic variates.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "percentile_25": {
          "description": "Optional 25th percentile of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "percentile_75": {
          "description": "Optional 75th percentile of captured discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "std_dev": {
          "description": "Optional sample standard deviation of discounted path values.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "stderr": {
          "description": "Standard error of the discounted mean, in `mean.amount()` units.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "stderr",
        "ci_95",
        "num_paths",
        "num_simulated_paths"
      ],
      "type": "object"
    },
    "PathDataset": {
      "description": "Captured-path collection plus the metadata needed to interpret it.\n\nThe dataset may contain every path or only a deterministic sample of the\nfull simulation, depending on the value of `sampling_method`.",
      "properties": {
        "num_paths_total": {
          "description": "Total number of paths simulated by the engine.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "paths": {
          "description": "Captured paths in deterministic order.",
          "items": {
            "$ref": "#/$defs/SimulatedPath"
          },
          "type": "array"
        },
        "process_params": {
          "$ref": "#/$defs/ProcessParams",
          "description": "Metadata needed to interpret captured state vectors."
        },
        "sampling_method": {
          "$ref": "#/$defs/PathSamplingMethod",
          "description": "Sampling method used to retain `paths`."
        }
      },
      "required": [
        "paths",
        "num_paths_total",
        "sampling_method",
        "process_params"
      ],
      "type": "object"
    },
    "PathPoint": {
      "description": "A single captured point along a Monte Carlo path.\n\nCaptures the process state at a specific time step, together with any\ncashflows emitted at that step and, optionally, a payoff snapshot.\n\n# State Vector Layout\n\nThe `state` vector contains the raw state variables in process-defined order.\nFor simple single-asset models, the crate's internal `state_indices`\nconstants provide common aliases.\nFor multi-asset or process-specific layouts, consult\n[`PathDataset::process_params.factor_names`](PathDataset::process_params) or\n[`PathDataset::state_var_keys`].",
      "properties": {
        "cashflows": {
          "default": [],
          "description": "Typed cashflows generated at this time step as `(time, amount, type)`.\n\nAmounts follow the sign convention `positive = inflow`,\n`negative = outflow`.",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "format": "double",
                "type": "number"
              },
              {
                "format": "double",
                "type": "number"
              },
              {
                "$ref": "#/$defs/CashflowType"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "payoff_value": {
          "description": "Optional payoff snapshot at this point.\n\nThis is populated only when path capture requested payoff snapshots. It\nuses the payoff's native amount units and is not additionally discounted\ninside `PathPoint`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "description": "State variables at this point (spot, variance, rate, etc.)\nIndexed by position - see `state_indices` for standard layout",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "step": {
          "description": "Time step index (0 = initial, N = final)",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "description": "Time in years from valuation date",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "step",
        "time",
        "state"
      ],
      "type": "object"
    },
    "PathSamplingMethod": {
      "description": "Records how a captured dataset was selected from the full simulation.",
      "oneOf": [
        {
          "const": "all",
          "description": "Every path in the run was captured.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Deterministic sample with target size `count`.\n\nThe engine uses deterministic Bernoulli sampling, so `count` is the\ntarget number of captured paths on average rather than a strict promise.",
          "properties": {
            "random_sample": {
              "additionalProperties": false,
              "properties": {
                "count": {
                  "description": "Target number of paths to capture on average.",
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "seed": {
                  "description": "Seed used by the deterministic sampling rule.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "count",
                "seed"
              ],
              "type": "object"
            }
          },
          "required": [
            "random_sample"
          ],
          "type": "object"
        }
      ]
    },
    "ProcessParams": {
      "description": "Metadata describing the process behind a captured dataset.\n\nThis structure is typically populated by\n[`crate::monte_carlo::process::metadata::ProcessMetadata`] implementations and stored in a\n[`PathDataset`]. It describes how to interpret captured state vectors rather\nthan how to price the instrument.",
      "properties": {
        "correlation": {
          "description": "Optional row-major `n x n` correlation matrix.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "factor_names": {
          "description": "Names describing the order of captured state-vector entries.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Process parameters keyed by implementation-defined names such as `r`,\n`q`, `sigma`, `kappa`, or `theta`.",
          "type": "object"
        },
        "process_type": {
          "description": "Process type identifier, such as `\"GBM\"` or `\"Heston\"`.",
          "type": "string"
        }
      },
      "required": [
        "process_type",
        "parameters",
        "factor_names"
      ],
      "type": "object"
    },
    "RunMetadata": {
      "description": "Reproducibility metadata stamped on a Monte Carlo pricing run.\n\nRecords the execution policy that produced an estimate so results are\nauditable and replayable: the same `(seed, num_paths, num_steps,\nchunk_size)` reproduces the run bit-for-bit regardless of thread count or\nhost (see the determinism notes on [`crate::monte_carlo::engine::McEngine::price`]).",
      "properties": {
        "antithetic": {
          "default": false,
          "description": "Whether antithetic variates were enabled.",
          "type": "boolean"
        },
        "chunk_size": {
          "default": 0,
          "description": "Effective chunk size of the deterministic reduction tree.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "num_steps": {
          "default": 0,
          "description": "Number of time-grid steps.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "default": null,
          "description": "Root RNG seed, when the calling pricer derived the stream from one.\n\n`None` when the engine was driven by an externally constructed\n[`crate::monte_carlo::traits::RandomStream`] whose seed the engine cannot observe.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "use_parallel": {
          "default": false,
          "description": "Whether the run used the parallel execution path.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SimulatedPath": {
      "description": "A complete captured Monte Carlo path.\n\nContains all captured points for a single simulated path, plus the final\ndiscounted value used in summary statistics.",
      "properties": {
        "final_value": {
          "description": "Final discounted payoff value for this path.\n\nThis is the path-level amount after the engine applies the run's\n`discount_factor`.",
          "format": "double",
          "type": "number"
        },
        "irr": {
          "default": null,
          "description": "Internal rate of return inferred from the captured cashflow amounts, if calculable.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "path_id": {
          "description": "Path identifier (0-indexed)",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "points": {
          "description": "Time points along the path",
          "items": {
            "$ref": "#/$defs/PathPoint"
          },
          "type": "array"
        }
      },
      "required": [
        "path_id",
        "points",
        "final_value"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/models/1/monte_carlo_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Monte Carlo pricing result with optional captured paths.",
  "properties": {
    "estimate": {
      "$ref": "#/$defs/MoneyEstimate",
      "description": "Discounted pricing estimate for the full simulation."
    },
    "paths": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathDataset"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional captured-path subset for diagnostics and visualization."
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reproducibility metadata for the run (execution policy and seed)."
    }
  },
  "required": [
    "estimate"
  ],
  "title": "MonteCarloResult",
  "type": "object"
}
