{
  "$defs": {
    "BaseVolatility": {
      "description": "Cheyette base volatility in decimal rate units per square-root model year.\n\nA level of 0.005 is a 50 basis point rate amplitude. The process samples\nthe amplitude at the left endpoint of each step and squares it for the\nvariance-state drift.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "amplitudes": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "format": "double",
                    "type": "number"
                  },
                  {
                    "format": "double",
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "interpolation": {
              "const": "linear",
              "type": "string"
            }
          },
          "required": [
            "interpolation",
            "amplitudes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amplitudes": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "format": "double",
                    "type": "number"
                  },
                  {
                    "format": "double",
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "interpolation": {
              "const": "constant_intervals",
              "type": "string"
            }
          },
          "required": [
            "interpolation",
            "amplitudes"
          ],
          "type": "object"
        }
      ]
    },
    "HurstExponent": {
      "additionalProperties": false,
      "description": "Validated Hurst exponent H ∈ (0, 1).\n\nThe Hurst exponent determines the roughness of fractional Brownian motion:\n\n- H < 0.5 — rough (anti-persistent increments)\n- H = 0.5 — standard Brownian motion\n- H > 0.5 — more regular paths with persistent increments",
      "properties": {
        "h": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "h"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/models/1/cheyette_rough_vol_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Cheyette + rough stochastic volatility model parameters.",
  "properties": {
    "eta": {
      "description": "Vol-of-vol scaling (η > 0).",
      "format": "double",
      "type": "number"
    },
    "hurst": {
      "$ref": "#/$defs/HurstExponent",
      "description": "Hurst exponent H ∈ (0, 0.5) for the rough vol driver."
    },
    "kappa": {
      "description": "Mean reversion of the short rate (κ > 0).",
      "format": "double",
      "type": "number"
    },
    "phi_times": {
      "description": "Time knots for the initial forward rate curve φ(t) = f(0, t).",
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "phi_values": {
      "description": "Value knots for the initial forward rate curve φ(t) = f(0, t).",
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "rho": {
      "description": "Correlation between rate and vol innovations ρ ∈ [-1, 1].",
      "format": "double",
      "type": "number"
    },
    "sigma_base": {
      "$ref": "#/$defs/BaseVolatility",
      "description": "Base volatility term structure σ₀(t) for the rate process."
    }
  },
  "required": [
    "kappa",
    "sigma_base",
    "hurst",
    "eta",
    "rho",
    "phi_times",
    "phi_values"
  ],
  "title": "CheyetteRoughVolParams",
  "type": "object"
}
