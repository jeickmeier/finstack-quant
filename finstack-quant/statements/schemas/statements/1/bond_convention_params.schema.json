{
  "$defs": {
    "BondConvention": {
      "description": "Standard bond market conventions by region/issuer.\n\nEach variant provides market-standard defaults for day count, frequency,\nsettlement days, and other conventions. Use [`BondConvention::settlement_days`]\nto get the standard settlement lag for each market.\n\n# Market Standards Reference\n\n| Convention | Day Count | Frequency | Settlement | Source |\n|------------|-----------|-----------|------------|--------|\n| US Treasury | ACT/ACT ICMA | Semi-annual | T+1 | Treasury Direct |\n| US Agency | 30/360 | Semi-annual | T+1 | SIFMA |\n| US Corporate | 30/360 | Semi-annual | T+1 | SIFMA (May 2024) |\n| EUR Corporate | ACT/ACT ICMA | Annual | T+2 | ICMA / TARGET2 |\n| German Bund | ACT/ACT ICMA | Annual | T+2 | Eurex |\n| UK Gilt | ACT/ACT ICMA | Semi-annual | T+1 | DMO |\n| French OAT | ACT/ACT ICMA | Annual | T+2 | AFT |\n| JGB | ACT/365F | Semi-annual | T+2 | JSCC (cross-border) |",
      "oneOf": [
        {
          "const": "us_treasury",
          "description": "US Treasury: Semi-annual, ACT/ACT ICMA, T+1 settlement",
          "type": "string"
        },
        {
          "const": "us_agency",
          "description": "US Agency (FNMA, FHLMC, FHLB): Semi-annual, 30/360, T+1 settlement",
          "type": "string"
        },
        {
          "const": "german_bund",
          "description": "German Bund: Annual, ACT/ACT ICMA, T+2 settlement",
          "type": "string"
        },
        {
          "const": "uk_gilt",
          "description": "UK Gilt: Semi-annual, ACT/ACT ICMA, T+1 settlement, 7-day ex-coupon",
          "type": "string"
        },
        {
          "const": "french_oat",
          "description": "French OAT: Annual, ACT/ACT ICMA, T+2 settlement",
          "type": "string"
        },
        {
          "const": "jgb",
          "description": "Japanese Government Bond (cross-border): Semi-annual, ACT/365F, T+2.\n\nDomestic JGB settlement moved to T+1 in May 2018 (JSCC). Cross-border\ntransactions settle T+2 (BOJ). This variant uses T+2 as the safer\ndefault for international participants.\n\nTokyo quotes the bond on **Japanese simple yield**\n(`japanese_simple_yield`, 単利). Street [`crate::metrics::MetricId::Ytm`]\nremains the secondary-market IRR and is **not** switched for `Jgb`.",
          "type": "string"
        },
        {
          "const": "us_corporate",
