{
  "$defs": {
    "MetricDefinition": {
      "additionalProperties": false,
      "description": "Individual metric definition.\n\nEach definition maps directly to a JSON object in a registry file and is\nconverted into a [`NodeSpec`](crate::types::NodeSpec) when registered.",
      "properties": {
        "category": {
          "description": "Category for grouping (e.g., \"margins\", \"returns\", \"leverage\")",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Description of what this metric represents",
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "description": "Formula text (in statements DSL)",
          "type": "string"
        },
        "id": {
          "description": "Unique identifier within the namespace",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "description": "Additional metadata",
          "type": "object"
        },
        "name": {
          "description": "Human-readable name",
          "type": "string"
        },
        "requires": {
          "description": "List of required node dependencies",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rollup": {
          "anyOf": [
            {
              "$ref": "#/$defs/RollupMethod"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the metric combines over the source periods of a coarser period\nwhen results are rolled up. A ratio or a multiple declares `formula`\nso it is recomputed from the rolled-up inputs; a metric that leaves\nthis unset follows the rollup default and is summed."
        },
        "tags": {
          "description": "Tags for filtering/searching",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unit_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unit type (percentage, currency, ratio, count)"
        }
      },
      "required": [
        "id",
        "name",
        "formula"
      ],
      "type": "object"
    },
    "RollupMethod": {
      "description": "How one node's values combine over the source periods of a target period.",
      "oneOf": [
        {
          "const": "sum",
          "description": "Sum the source periods: flows such as revenue, expenses and cash flows.\nA missing source value leaves the target value missing.",
          "type": "string"
        },
        {
          "const": "period_end",
          "description": "Take the last source period's value: balances such as cash, debt and\nequity, and trailing metrics such as last-twelve-month EBITDA.",
          "type": "string"
        },
        {
          "const": "formula",
          "description": "Re-evaluate the node's formula (and `where` clause) on the rolled-up\nvalues: ratios such as margins, leverage and coverage. Time-series\nfunctions then run at the target frequency, so `lag(x, 1)` is the\nprior target period.",
          "type": "string"
        }
      ]
    },
    "SchemaVersion": {
      "description": "Numeric schema revision for contracts whose sole supported revision is v1.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "UnitType": {
      "description": "Unit type for metric values.",
      "oneOf": [
        {
          "const": "percentage",
          "description": "Percentage (0.15 = 15%)",
          "type": "string"
        },
        {
          "const": "currency",
          "description": "Currency amount",
          "type": "string"
        },
        {
          "const": "ratio",
          "description": "Ratio (dimensionless)",
          "type": "string"
        },
        {
          "const": "count",
          "description": "Count (integer-like)",
          "type": "string"
        },
        {
          "const": "time_period",
          "description": "Time period (days, months, years)",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/statements/1/metric_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Namespaced catalog of reusable metric definitions.",
  "examples": [
    {
      "metrics": [
        {
          "category": "margins",
          "description": "Gross profit as a share of revenue.",
          "formula": "gross_profit / revenue",
          "id": "gross_margin",
          "name": "Gross Margin",
          "requires": [
            "gross_profit",
            "revenue"
          ],
          "unit_type": "percentage"
        }
      ],
      "namespace": "fin",
      "schema_version": 1
    }
  ],
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "Additional metadata",
      "type": "object"
    },
    "metrics": {
      "description": "List of metric definitions contained in the registry",
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "type": "array"
    },
    "namespace": {
      "description": "Namespace for all metrics in this registry (e.g., \"fin\", \"custom\")",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "description": "Required schema version. Only numeric `1` is accepted."
    }
  },
  "required": [
    "namespace",
    "schema_version",
    "metrics"
  ],
  "title": "MetricRegistry",
  "type": "object"
}
