{
  "namespace": "fin",
  "schema_version": 1,
  "metrics": [
    {
      "id": "gross_profit",
      "name": "Gross Profit",
      "formula": "revenue - cogs",
      "description": "Revenue minus cost of goods sold",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["revenue", "cogs"],
      "tags": ["income_statement", "profitability"]
    },
    {
      "id": "operating_income",
      "name": "Operating Income",
      "formula": "gross_profit - opex",
      "description": "Gross profit minus reported operating expenses. CONVENTION: `cogs` and `opex` are reported costs that include their depreciation and amortization.",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["gross_profit", "opex"],
      "tags": ["income_statement", "profitability"]
    },
    {
      "id": "ebitda",
      "name": "EBITDA",
      "formula": "ebit + depreciation + amortization",
      "description": "EBIT plus the depreciation and amortization included in reported COGS and OPEX, added back once. CONVENTION: `cogs` and `opex` are reported costs that include their depreciation and amortization. Supply only the D&A those lines include.",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["ebit", "depreciation", "amortization"],
      "tags": ["income_statement", "profitability", "cash_proxy"]
    },
    {
      "id": "ebit",
      "name": "EBIT",
      "formula": "operating_income",
      "description": "Earnings before interest and taxes: operating income.",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["operating_income"],
      "tags": ["income_statement", "profitability"]
    },
    {
      "id": "ebt",
      "name": "EBT",
      "formula": "ebit - interest_expense",
      "description": "Earnings before tax: EBIT minus statement interest expense.",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["ebit", "interest_expense"],
      "tags": ["income_statement", "profitability"]
    },
    {
      "id": "net_income",
      "name": "Net Income",
      "formula": "ebt - tax_expense",
      "description": "EBT minus statement tax expense.",
      "category": "income_statement",
      "unit_type": "currency",
      "rollup": "sum",
      "requires": ["ebt", "tax_expense"],
      "tags": ["income_statement", "profitability", "bottom_line"]
    }
  ]
}
