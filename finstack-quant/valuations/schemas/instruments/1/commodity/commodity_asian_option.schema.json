{
  "$defs": {
    "AveragingMethod": {
      "description": "Averaging method for Asian options.",
      "oneOf": [
        {
          "const": "arithmetic",
          "description": "Arithmetic average: (1/n) Σ S_i",
          "type": "string"
        },
        {
          "const": "geometric",
          "description": "Geometric average: (Π S_i)^(1/n)",
          "type": "string"
        }
      ]
    },
    "CommodityAsianOption": {
      "additionalProperties": false,
      "description": "Commodity Asian option: option on the arithmetic or geometric average of\ncommodity prices.\n\nThis is the dominant option type in commodity markets. The average is\ntypically computed over commodity forward/futures prices for specific\ndelivery periods.\n\n# Pricing Models\n\n| Averaging | Model | Accuracy |\n|-----------|-------|----------|\n| Geometric | Kemna-Vorst (1990) with forwards | Exact closed-form |\n| Arithmetic | Turnbull-Wakeman (1991) with forwards | ~1% vs Monte Carlo |\n\n# Forward-Based Averaging\n\nFor each future fixing date `t_i`, the forward price `F(t_i)` is read from\nthe price curve. The average forward is:\n```text\nF_avg = (Σ_realized + Σ F(t_i)) / n\n```\nwhere the sum includes both realized fixings and projected forwards.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {},
          "description": "Attributes for scenario selection and grouping.\nAttributes for scenario selection and tagging"
        },
        "averaging_method": {
          "$ref": "#/$defs/AveragingMethod",
          "description": "Averaging method (arithmetic or geometric)."
        },
        "commodity_type": {
          "description": "Commodity type (e.g., \"Energy\", \"Metal\", \"Agricultural\")",
          "type": "string"
        },
        "currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Base currency for pricing"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "default": "act_365f",
          "description": "Day count convention."
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations."
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Option expiry/settlement date for the payoff."
        },
        "fixing_dates": {
          "description": "Dates on which the commodity price is observed for averaging.\n\n**Note**: These dates should be pre-adjusted for business day conventions.",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "forward_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Forward/futures price curve ID."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Option type (call or put)."
        },
        "quantity": {
          "$ref": "#/$defs/PositiveF64Wire",
          "description": "Contract quantity in commodity units."
        },
        "realized_fixings": {
          "default": [],
          "description": "Already observed fixings for seasoned options (ex-date, price pairs).",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "strike": {
          "$ref": "#/$defs/PositiveF64Wire",
          "description": "Strike price per unit."
        },
        "ticker": {
          "description": "Ticker/identifier for market data lookup (e.g., \"CL\", \"GC\", \"NG\")",
          "type": "string"
        },
        "unit": {
          "description": "Unit of measurement (e.g., \"BBL\", \"OZ\", \"MT\", \"MMBTU\")",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID for implied vol."
        }
      },
      "required": [
        "id",
        "commodity_type",
        "ticker",
        "unit",
        "currency",
        "strike",
        "option_type",
        "averaging_method",
        "fixing_dates",
        "quantity",
        "expiry",
        "forward_curve_id",
        "discount_curve_id",
        "vol_surface_id"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    },
    "PositiveF64Wire": {
      "description": "Finite JSON number that is strictly greater than zero.\n\nThis type is used by serde field adapters so runtime deserialization and\ngenerated schemas enforce the same positive-number contract.",
      "exclusiveMinimum": 0.0,
      "format": "double",
      "type": "number"
    },
    "commodity_asian_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/CommodityAsianOption"
        },
        "type": {
          "const": "commodity_asian_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/commodity/commodity_asian_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "averaging_method": "arithmetic",
          "commodity_type": "Energy",
          "currency": "USD",
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "expiry": "2025-07-02",
          "fixing_dates": [
            "2025-01-31",
            "2025-02-28",
            "2025-03-31",
            "2025-04-30",
            "2025-05-31",
            "2025-06-30"
          ],
          "forward_curve_id": "CL-FORWARD",
          "id": "WTI-ASIAN-6M",
          "option_type": "call",
          "quantity": 1000.0,
          "realized_fixings": [],
          "strike": 75.0,
          "ticker": "CL",
          "unit": "BBL",
          "vol_surface_id": "CL-VOL"
        },
        "type": "commodity_asian_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/commodity_asian_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "commodity_asian_option",
  "type": "object"
}
