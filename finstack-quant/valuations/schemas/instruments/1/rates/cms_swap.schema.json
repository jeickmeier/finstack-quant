{
  "$defs": {
    "CmsSwap": {
      "additionalProperties": false,
      "description": "CMS (Constant Maturity Swap) swap instrument.\n\nOne leg pays a CMS rate (the par swap rate for a reference tenor, e.g., 10Y)\nobserved on each fixing date, and the other leg pays a fixed or floating rate.\n\nThe CMS rate requires a convexity adjustment because the CMS rate is not a\nmartingale under the payment measure. The adjustment depends on the correlation\nbetween the CMS rate and the numeraire (annuity).\n\n# Reference\n\nHagan, P. S. (2003). \"Convexity Conundrums: Pricing CMS Swaps, Caps, and Floors.\"\n*Wilmott Magazine*, March, 38-44. `docs/REFERENCES.md#hagan-2003-cms-convexity`",
      "properties": {
        "accrual_fractions": {
          "description": "Accrual fractions for each CMS period.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {},
          "description": "Attributes for scenario selection and grouping."
        },
        "cms_cap": {
          "description": "Optional cap on the CMS rate (decimal).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "cms_floor": {
          "description": "Optional floor on the CMS rate (decimal).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "cms_spread_bp": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/decimal.schema.json",
          "default": "0",
          "description": "Additive spread over the CMS rate in basis points (10 = 10bp)."
        },
        "cms_tenor": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
          "description": "Tenor of the CMS reference swap (e.g. 10Y); must be month- or year-based."
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention for CMS leg accrual."
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations."
        },
        "fixing_dates": {
          "description": "Fixing dates for CMS rate observations.",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "forward_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Forward/projection curve ID for CMS rate projection."
        },
        "funding_leg": {
          "$ref": "#/$defs/FundingLeg",
          "description": "Funding leg definition (fixed or floating)."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "index_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rate-index convention-registry key of the underlying swap (e.g. `USD-SOFR-OIS`)."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount."
        },
        "payment_dates": {
          "description": "Payment dates for the CMS leg.",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "side": {
          "$ref": "#/$defs/PayReceive",
          "description": "Pay direction: `Pay` means pay CMS leg, receive funding leg."
        },
        "swap_fixed_day_count": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Day count of the underlying swap fixed leg (overrides convention)."
        },
        "swap_fixed_frequency": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed leg frequency of the underlying swap (overrides convention)."
        },
        "swap_float_day_count": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Day count of the underlying swap floating leg (overrides convention)."
        },
        "swap_float_frequency": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Floating leg frequency of the underlying swap (overrides convention)."
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID for CMS convexity adjustment."
        }
      },
      "required": [
        "id",
        "notional",
        "side",
        "cms_tenor",
        "fixing_dates",
        "payment_dates",
        "accrual_fractions",
        "day_count",
        "funding_leg",
        "discount_curve_id",
        "forward_curve_id",
        "vol_surface_id"
      ],
      "type": "object"
    },
    "FundingLeg": {
      "description": "Funding leg specification for a CMS swap.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Fixed rate funding leg.",
          "properties": {
            "accrual_fractions": {
              "description": "Accrual fractions for each period.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            },
            "day_count": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
              "description": "Day count convention."
            },
            "payment_dates": {
              "description": "Payment dates for each period.",
              "items": {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              "type": "array"
            },
            "rate": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/decimal.schema.json",
              "description": "Fixed coupon rate as a decimal annual rate (0.03 = 3%)."
            },
            "type": {
              "const": "fixed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rate",
            "payment_dates",
            "accrual_fractions",
            "day_count"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Floating rate funding leg.\n\n# Convention: no payment lag\n\nThis leg models each period by its `payment_dates` only and assumes the\n**accrual end equals the payment date** (no payment lag, no\naccrual-vs-pay adjustment). The pricer projects the floating forward over\n`[previous payment date, payment date]` and discounts to the payment\ndate. For funding with a genuine payment lag or accrual end ≠ payment\ndate, model the floating side as a full IRS float leg (which carries\nexplicit accrual start/end and payment dates) instead of this simplified\nfunding leg.",
          "properties": {
            "accrual_fractions": {
              "description": "Accrual fractions for each period.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            },
            "day_count": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
              "description": "Day count convention."
            },
            "forward_curve_id": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
              "description": "Forward curve for floating rate projection."
            },
            "payment_dates": {
              "description": "Payment dates for each period. Each is also treated as the period's\naccrual-end date (no payment lag — see the variant docs).",
              "items": {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              "type": "array"
            },
            "spread_bp": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/decimal.schema.json",
              "description": "Additive spread over the floating index in basis points (10 = 10bp)."
            },
            "type": {
              "const": "floating",
              "type": "string"
            }
          },
          "required": [
            "type",
            "spread_bp",
            "payment_dates",
            "accrual_fractions",
            "day_count",
            "forward_curve_id"
          ],
          "type": "object"
        }
      ]
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "PayReceive": {
      "description": "Direction for instrument legs (universal for IRS, CDS, variance swaps, etc.)\n\nFor interest rate swaps: Pay = pay fixed/receive floating, Receive = receive fixed/pay floating\nFor credit default swaps: Pay = buy protection (pay premium), Receive = sell protection (receive premium)\nFor variance swaps: Pay = short variance, Receive = long variance",
      "oneOf": [
        {
          "const": "pay",
          "description": "Pay the primary leg (fixed rate in IRS, protection premium in CDS, short variance)",
          "type": "string"
        },
        {
          "const": "receive",
          "description": "Receive the primary leg (fixed rate in IRS, protection premium in CDS, long variance)",
          "type": "string"
        }
      ]
    },
    "cms_swap": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/CmsSwap"
        },
        "type": {
          "const": "cms_swap",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/rates/cms_swap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "accrual_fractions": [
            0.25,
            0.25,
            0.25,
            0.25
          ],
          "attributes": {},
          "cms_spread_bp": "0",
          "cms_tenor": {
            "count": 10,
            "unit": "years"
          },
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "fixing_dates": [
            "2025-03-20",
            "2025-06-20",
            "2025-09-22",
            "2025-12-22"
          ],
          "forward_curve_id": "USD-LIBOR-3M",
          "funding_leg": {
            "accrual_fractions": [
              0.25,
              0.25,
              0.25,
              0.25
            ],
            "day_count": "30_360",
            "payment_dates": [
              "2025-06-20",
              "2025-09-22",
              "2025-12-22",
              "2026-03-20"
            ],
            "rate": "0.03",
            "type": "fixed"
          },
          "id": "CMSSWAP-10Y-USD",
          "index_id": "USD-SOFR-OIS",
          "notional": {
            "amount": "10000000",
            "currency": "USD"
          },
          "payment_dates": [
            "2025-06-20",
            "2025-09-22",
            "2025-12-22",
            "2026-03-20"
          ],
          "side": "pay",
          "swap_float_day_count": "act_360",
          "vol_surface_id": "USD-CMS10Y-VOL"
        },
        "type": "cms_swap"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/cms_swap"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "cms_swap",
  "type": "object"
}
