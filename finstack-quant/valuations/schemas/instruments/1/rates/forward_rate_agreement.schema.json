{
  "$defs": {
    "ForwardRateAgreement": {
      "additionalProperties": false,
      "description": "Forward Rate Agreement instrument.\n\nA FRA is a forward contract on an interest rate. The holder receives\nthe difference between the realized rate and the fixed rate, paid at\nthe start of the interest period (FRA convention).\n\n# Direction Convention\n\n- `side = PayReceive::Receive`: Receive fixed rate, pay floating rate.\n  When forward rate > fixed rate, PV is negative (you're paying more than receiving).\n- `side = PayReceive::Pay`: Pay fixed rate, receive floating rate.\n  When forward rate > fixed rate, PV is positive (you're receiving more than paying).\n\n# Side field\n\nUse `side` to indicate the fixed leg direction. If omitted in JSON,\ndeserialization defaults to `Pay`.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and tagging"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention for interest accrual"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve identifier"
        },
        "fixed_rate": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/decimal.schema.json",
          "description": "Fixed rate (decimal, e.g., 0.05 for 5%)"
        },
        "fixing_business_day_convention": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/business_day_convention.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional business day convention for fixing date adjustment (default: ModifiedFollowing)"
        },
        "fixing_calendar_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional fixing calendar identifier for business day adjustment"
        },
        "fixing_date": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rate fixing date. If `None`, inferred from `start_date - reset_lag_days` business days."
        },
        "forward_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Forward curve identifier"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique identifier"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "maturity": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Interest period end date"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount"
        },
        "observed_fixing": {
          "description": "Optional observed fixing (locked rate) when known",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reset_lag_days": {
          "description": "Reset lag in business days (fixing to value date)",
          "format": "int32",
          "type": "integer"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "side": {
          "$ref": "#/$defs/PayReceive",
          "default": "pay",
          "description": "Direction of the FRA: Pay means paying the fixed rate (receiving floating),\nReceive means receiving the fixed rate (paying floating)."
        },
        "start_date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Interest period start date"
        }
      },
      "required": [
        "id",
        "notional",
        "start_date",
        "maturity",
        "fixed_rate",
        "day_count",
        "reset_lag_days",
        "discount_curve_id",
        "forward_curve_id",
        "attributes"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "PayReceive": {
      "description": "Direction for instrument legs (universal for IRS, CDS, variance swaps, etc.)\n\nFor interest rate swaps: Pay = pay fixed/receive floating, Receive = receive fixed/pay floating\nFor credit default swaps: Pay = buy protection (pay premium), Receive = sell protection (receive premium)\nFor variance swaps: Pay = short variance, Receive = long variance",
      "oneOf": [
        {
          "const": "pay",
          "description": "Pay the primary leg (fixed rate in IRS, protection premium in CDS, short variance)",
          "type": "string"
        },
        {
          "const": "receive",
          "description": "Receive the primary leg (fixed rate in IRS, protection premium in CDS, long variance)",
          "type": "string"
        }
      ]
    },
    "forward_rate_agreement": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/ForwardRateAgreement"
        },
        "type": {
          "const": "forward_rate_agreement",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/rates/forward_rate_agreement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "day_count": "act_360",
          "discount_curve_id": "USD-OIS",
          "fixed_rate": "0.045",
          "fixing_date": "2024-04-01",
          "forward_curve_id": "USD-SOFR-3M",
          "id": "FRA-3X6-USD",
          "maturity": "2024-07-03",
          "notional": {
            "amount": "10000000",
            "currency": "USD"
          },
          "reset_lag_days": 2,
          "side": "receive",
          "start_date": "2024-04-03"
        },
        "type": "forward_rate_agreement"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/forward_rate_agreement"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "forward_rate_agreement",
  "type": "object"
}
