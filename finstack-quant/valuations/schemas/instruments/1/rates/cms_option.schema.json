{
  "$defs": {
    "CmsOption": {
      "additionalProperties": false,
      "description": "CMS option instrument (cap/floor on CMS rates).",
      "properties": {
        "accrual_fractions": {
          "description": "Finite nonnegative accrual fractions for each period; zero gives a zero coupon.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {},
          "description": "Attributes for scenario selection and grouping"
        },
        "cms_tenor": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
          "description": "Tenor of the CMS reference swap (e.g. 10Y); must be month- or year-based."
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention for the option accrual"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations"
        },
        "fixing_dates": {
          "description": "Observation/fixing dates for CMS rate",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "forward_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Forward/projection curve ID for CMS rate projection"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "index_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rate-index convention-registry key of the underlying swap (e.g. `USD-SOFR-OIS`).\n\nWhen set, provides default values for `swap_fixed_frequency`, `swap_float_frequency`,\n`swap_fixed_day_count`, and `swap_float_day_count`. Individual fields still\noverride the convention when explicitly set. Required for USD CMS."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Option type (call or put on CMS rate)"
        },
        "payment_dates": {
          "description": "Payment dates for each period (usually fixing date + lag or period end)",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "strike": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/decimal.schema.json",
          "description": "Strike (fixed rate for CMS option)"
        },
        "swap_fixed_day_count": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Day count convention of the underlying swap fixed leg (overrides convention if set)"
        },
        "swap_fixed_frequency": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed leg frequency of the underlying swap (overrides convention if set)"
        },
        "swap_float_day_count": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional day count convention of the underlying swap floating leg"
        },
        "swap_float_frequency": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Floating leg frequency of the underlying swap (overrides convention if set)"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID for CMS rates"
        }
      },
      "required": [
        "id",
        "strike",
        "cms_tenor",
        "fixing_dates",
        "payment_dates",
        "accrual_fractions",
        "option_type",
        "notional",
        "day_count",
        "discount_curve_id",
        "forward_curve_id",
        "vol_surface_id"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    },
    "cms_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/CmsOption"
        },
        "type": {
          "const": "cms_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/rates/cms_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "accrual_fractions": [
            0.25,
            0.25,
            0.25,
            0.25
          ],
          "attributes": {},
          "cms_tenor": {
            "count": 10,
            "unit": "years"
          },
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "fixing_dates": [
            "2025-03-20",
            "2025-06-20",
            "2025-09-22",
            "2025-12-22"
          ],
          "forward_curve_id": "USD-LIBOR-3M",
          "id": "CMSOPT-10Y-USD",
          "index_id": "USD-SOFR-OIS",
          "notional": {
            "amount": "10000000",
            "currency": "USD"
          },
          "option_type": "call",
          "payment_dates": [
            "2025-06-20",
            "2025-09-22",
            "2025-12-22",
            "2026-03-20"
          ],
          "strike": "0.025",
          "swap_float_day_count": "act_360",
          "vol_surface_id": "USD-CMS10Y-VOL"
        },
        "type": "cms_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/cms_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "cms_option",
  "type": "object"
}
