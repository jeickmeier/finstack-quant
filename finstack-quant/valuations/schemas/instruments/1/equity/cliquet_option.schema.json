{
  "$defs": {
    "CliquetOption": {
      "additionalProperties": false,
      "description": "Cliquet option instrument.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and grouping"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional dividend-yield scalar ID.\n\n`Some(id)`: lookup MUST succeed (a missing or non-unitless scalar\nreturns an error). `None`: no implicit default; treated as zero\ncontinuous dividend yield. Set explicitly for index underlyings."
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Explicit terminal expiry date for the structure."
        },
        "global_cap": {
          "description": "Global cap on sum of all period returns",
          "format": "double",
          "type": "number"
        },
        "global_floor": {
          "description": "Global floor on sum of all period returns (default 0.0)",
          "format": "double",
          "type": "number"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "initial_level": {
          "default": null,
          "description": "Strike-set underlying level anchoring the first period's return.\n\n`None` (the default) uses the spot at the valuation date, which is only\ncorrect for a new trade priced on its strike-set date. **Required for\nseasoned trades** (any reset date strictly before `as_of`): pricing\nerrors otherwise. Do not duplicate the strike-set date inside\n`reset_dates` when providing this — reset dates are period-end\nobservations.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {},
          "description": "Instrument-owned pricing inputs."
        },
        "local_cap": {
          "description": "Local cap on individual period returns",
          "format": "double",
          "type": "number"
        },
        "local_floor": {
          "description": "Local floor on individual period returns (default 0.0)",
          "format": "double",
          "type": "number"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "theta_period": null
          },
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount"
        },
        "past_fixings": {
          "default": [],
          "description": "Observed underlying fixings for seasoned trades (date, level pairs).\n\nEvery reset date strictly before the valuation date must have a\nmatching fixing here; pricing errors otherwise. Locked-in period\nreturns are computed deterministically from these fixings (with local\ncap/floor applied) and only the remaining future periods are simulated.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "path_model": {
          "$ref": "#/$defs/EquityPathModel",
          "description": "Explicit path model selection; required to acknowledge model risk."
        },
        "payoff_type": {
          "$ref": "#/$defs/CliquetPayoffType",
          "default": "additive",
          "description": "Payoff aggregation type (default: Additive)"
        },
        "reset_dates": {
          "description": "Reset dates for periodic return locking",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {},
          "description": "Scenario-only pricing adjustments."
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Spot price identifier"
        },
        "underlying_ticker": {
          "description": "Underlying asset ticker symbol",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "reset_dates",
        "expiry",
        "local_cap",
        "local_floor",
        "global_cap",
        "global_floor",
        "notional",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "path_model",
        "attributes"
      ],
      "type": "object"
    },
    "CliquetPayoffType": {
      "description": "Cliquet payoff aggregation type.",
      "oneOf": [
        {
          "const": "additive",
          "description": "Additive: Sum of period returns",
          "type": "string"
        },
        {
          "const": "multiplicative",
          "description": "Multiplicative: Product of (1 + period returns) - 1",
          "type": "string"
        }
      ]
    },
    "EquityPathModel": {
      "const": "atm_term_gbm",
      "description": "Explicit stochastic model policy for path-dependent equity structures.",
      "type": "string"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "cliquet_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/CliquetOption"
        },
        "type": {
          "const": "cliquet_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/cliquet_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-31",
          "global_cap": 0.2,
          "global_floor": 0.0,
          "id": "CLIQ-SPX-QTR",
          "initial_level": null,
          "local_cap": 0.05,
          "local_floor": 0.0,
          "notional": {
            "amount": "100000",
            "currency": "USD"
          },
          "past_fixings": [],
          "path_model": "atm_term_gbm",
          "payoff_type": "additive",
          "reset_dates": [
            "2024-03-29",
            "2024-06-28",
            "2024-09-30",
            "2024-12-31"
          ],
          "spot_id": "SPX-SPOT",
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "cliquet_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/cliquet_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "cliquet_option",
  "type": "object"
}
