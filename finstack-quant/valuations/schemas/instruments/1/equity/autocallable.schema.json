{
  "$defs": {
    "Autocallable": {
      "additionalProperties": false,
      "description": "Autocallable structured product instrument.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and grouping"
        },
        "autocall_barriers": {
          "description": "Autocall barrier levels (as ratios of initial spot, e.g., 1.0 = 100%).\n\nEach barrier corresponds to the observation date at the same index.\nIf spot ≥ barrier × initial_spot on the observation date, the product autocalls.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "cap_level": {
          "description": "Cap level for final payoff (maximum return)",
          "format": "double",
          "type": "number"
        },
        "coupon_barriers": {
          "description": "Coupon barriers corresponding to observation dates.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "coupons": {
          "description": "Coupon return amounts for each observation date.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention for interest calculations"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional dividend-yield scalar ID.\n\n`Some(id)`: lookup MUST succeed (a missing or non-unitless scalar\nreturns an error). `None`: no implicit default; treated as zero\ncontinuous dividend yield. Set explicitly for index underlyings."
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Explicit terminal expiry date for the structure."
        },
        "final_barrier": {
          "description": "Final barrier level for final payoff determination",
          "format": "double",
          "type": "number"
        },
        "final_payoff_type": {
          "$ref": "#/$defs/FinalPayoffType",
          "description": "Type of final payoff (capital protection, participation, knock-in put)"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "initial_level": {
          "default": null,
          "description": "Initial (strike-set) underlying level S_0 used as the reference for\nbarrier and payoff ratios.\n\n`None` (the default) uses the spot at the valuation date, which is only\ncorrect for a new trade priced on its strike-set date. **Required for\nseasoned trades** (any observation date on or before `as_of`): pricing\nerrors if past observation dates exist without it.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {},
          "description": "Instrument-owned pricing inputs."
        },
        "memory_coupons": {
          "default": false,
          "description": "Memory (\"Phoenix\") coupon feature.\n\nMissed coupons accrue until a later coupon barrier is met.",
          "type": "boolean"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "theta_period": null
          },
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount"
        },
        "observation_dates": {
          "description": "Observation dates for autocall and coupon checks.\n\nBarriers are monitored **discretely** at these exact dates only.\nThe Monte Carlo time grid is constructed to include these dates precisely.",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "past_fixings": {
          "default": [],
          "description": "Observed underlying fixings for seasoned trades (date, level pairs).\n\nFor a mid-life autocallable, every observation date on or before the\nvaluation date must have a matching fixing here; pricing errors\notherwise. Past fixings are evaluated deterministically (autocall,\nmissed memory coupons, discrete knock-in monitoring) and only the\nremaining future observation dates are simulated.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "path_model": {
          "$ref": "#/$defs/EquityPathModel",
          "description": "Explicit path model selection; required to acknowledge model risk."
        },
        "payment_dates": {
          "description": "Contractual payment dates corresponding to observation dates.",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {},
          "description": "Scenario-only pricing adjustments."
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Spot price identifier for underlying asset"
        },
        "underlying_ticker": {
          "description": "Underlying asset ticker symbol",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID for option pricing"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "observation_dates",
        "payment_dates",
        "expiry",
        "autocall_barriers",
        "coupon_barriers",
        "coupons",
        "final_barrier",
        "final_payoff_type",
        "cap_level",
        "notional",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "path_model",
        "attributes"
      ],
      "type": "object"
    },
    "EquityPathModel": {
      "const": "atm_term_gbm",
      "description": "Explicit stochastic model policy for path-dependent equity structures.",
      "type": "string"
    },
    "FinalPayoffType": {
      "description": "Final payoff type for autocallable products.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capital protection: max(floor, participation_rate * min(S_T/S_0, cap_level))",
          "properties": {
            "capital_protection": {
              "additionalProperties": false,
              "properties": {
                "floor": {
                  "description": "Minimum return floor (e.g., 1.0 for 100% protection)",
                  "format": "double",
                  "type": "number"
                },
                "participation_rate": {
                  "description": "Decimal multiplier on the capped performance ratio (1.0 = 100%).",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "floor",
                "participation_rate"
              ],
              "type": "object"
            }
          },
          "required": [
            "capital_protection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Participation: 1 + participation_rate * max(0, min(S_T/S_0, cap_level) - 1)",
          "properties": {
            "participation": {
              "additionalProperties": false,
              "properties": {
                "participation_rate": {
                  "description": "Decimal multiplier on the capped upside (1.0 = 100% participation).",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "participation_rate"
              ],
              "type": "object"
            }
          },
          "required": [
            "participation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Knock-in put: Put option if barrier breached, otherwise return principal",
          "properties": {
            "knock_in_put": {
              "additionalProperties": false,
              "properties": {
                "strike_ratio": {
                  "description": "Put strike as a ratio of the initial level (`1.0` = 100%, the same\nunits as `final_barrier`); the put loss is\n`max(strike_ratio - S_T / S_0, 0)`.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "strike_ratio"
              ],
              "type": "object"
            }
          },
          "required": [
            "knock_in_put"
          ],
          "type": "object"
        }
      ]
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "autocallable": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/Autocallable"
        },
        "type": {
          "const": "autocallable",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/autocallable.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "autocall_barriers": [
            1.0,
            1.0,
            1.0,
            1.0
          ],
          "cap_level": 1.5,
          "coupon_barriers": [
            0.7,
            0.7,
            0.7,
            0.7
          ],
          "coupons": [
            0.02,
            0.02,
            0.02,
            0.02
          ],
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-31",
          "final_barrier": 0.6,
          "final_payoff_type": {
            "participation": {
              "participation_rate": 1.0
            }
          },
          "id": "AUTO-SPX-QTR",
          "initial_level": null,
          "memory_coupons": false,
          "notional": {
            "amount": "100000",
            "currency": "USD"
          },
          "observation_dates": [
            "2024-03-29",
            "2024-06-28",
            "2024-09-30",
            "2024-12-31"
          ],
          "past_fixings": [],
          "path_model": "atm_term_gbm",
          "payment_dates": [
            "2024-03-29",
            "2024-06-28",
            "2024-09-30",
            "2024-12-31"
          ],
          "spot_id": "SPX-SPOT",
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "autocallable"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/autocallable"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "autocallable",
  "type": "object"
}
