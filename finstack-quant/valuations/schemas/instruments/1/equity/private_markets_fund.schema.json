{
  "$defs": {
    "CatchUpMode": {
      "description": "Catch-up mode for GP profit sharing.",
      "oneOf": [
        {
          "const": "full",
          "description": "Full catch-up: GP gets 100% until target split is reached",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Partial catch-up: GP gets configured percentage",
          "type": "string"
        }
      ]
    },
    "ClawbackSettle": {
      "description": "Clawback settlement trigger.",
      "oneOf": [
        {
          "const": "fund_end",
          "description": "Settle at fund termination",
          "type": "string"
        },
        {
          "const": "periodic",
          "description": "Settle periodically (quarterly/annually)",
          "type": "string"
        }
      ]
    },
    "ClawbackSpec": {
      "additionalProperties": false,
      "description": "Clawback specification for GP carry reconciliation.",
      "properties": {
        "holdback_decimal": {
          "description": "Optional share of GP carry held back until settlement, as a decimal\nfraction in `[0, 1]` (`0.2` = 20%)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "settle_on": {
          "$ref": "#/$defs/ClawbackSettle",
          "description": "When to settle clawback"
        }
      },
      "required": [
        "settle_on"
      ],
      "type": "object"
    },
    "FundEvent": {
      "additionalProperties": false,
      "description": "Single fund cash flow event.",
      "properties": {
        "amount": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Amount (positive for all event types, sign determined by kind)"
        },
        "date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Date of the event"
        },
        "deal_id": {
          "description": "Deal identifier. Required for every event in an American-style\ndeal-by-deal waterfall.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FundEventKind",
          "description": "Type of event"
        }
      },
      "required": [
        "date",
        "amount",
        "kind"
      ],
      "type": "object"
    },
    "FundEventKind": {
      "description": "Type of fund event.",
      "oneOf": [
        {
          "const": "contribution",
          "description": "Capital contribution from LP",
          "type": "string"
        },
        {
          "const": "distribution",
          "description": "Distribution to LP",
          "type": "string"
        },
        {
          "const": "proceeds",
          "description": "Sale proceeds from investment",
          "type": "string"
        }
      ]
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "PeFundWaterfallSpec": {
      "additionalProperties": false,
      "description": "Complete waterfall specification.",
      "properties": {
        "catch_up_mode": {
          "$ref": "#/$defs/CatchUpMode",
          "default": "full",
          "description": "Catch-up mode"
        },
        "clawback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClawbackSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clawback specification; `None` means no clawback (presence is the switch)"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "default": "act_365f",
          "description": "Day count for LP/fund IRR year fractions and hurdle compounding\n`(1 + hurdle_irr)^years` (default Act/365F)"
        },
        "style": {
          "$ref": "#/$defs/WaterfallStyle",
          "description": "Allocation style (European vs American)"
        },
        "tranches": {
          "description": "Ordered sequence of waterfall tranches",
          "items": {
            "$ref": "#/$defs/PeFundWaterfallTranche"
          },
          "type": "array"
        }
      },
      "required": [
        "style",
        "tranches"
      ],
      "type": "object"
    },
    "PeFundWaterfallTranche": {
      "description": "Individual tranche in the waterfall.",
      "oneOf": [
        {
          "const": "return_of_capital",
          "description": "Return LP capital contributions before any profit sharing",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Preferred return to LPs at specified IRR",
          "properties": {
            "preferred_irr": {
              "additionalProperties": false,
              "properties": {
                "hurdle_irr": {
                  "description": "LP preferred-return hurdle as an annual decimal IRR (`0.08` = 8%),\ncompounded on the spec's `day_count`.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "hurdle_irr"
              ],
              "type": "object"
            }
          },
          "required": [
            "preferred_irr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Catch-up allocation to GP",
          "properties": {
            "catch_up": {
              "additionalProperties": false,
              "properties": {
                "gp_share": {
                  "description": "GP share of each catch-up dollar, in `[0, 1]`. In\n[`CatchUpMode::Partial`] this caps the GP's take per dollar; in\n[`CatchUpMode::Full`] the GP takes 100% of catch-up dollars and\nthis value is only the fallback target share when no promote tier\nfollows.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "gp_share"
              ],
              "type": "object"
            }
          },
          "required": [
            "catch_up"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Promote tier with hurdle and LP/GP split.\n\n**Hard-hurdle gating semantics**: before the split activates, the LP\nis paid at 100% until the LP-net IRR reaches this tier's `hurdle_irr`;\nonly cash above the hurdle is split `lp_share`/`gp_share` (cascading\nto the next tier once the next tier's hurdle is reached). If a\n[`PeFundWaterfallTranche::CatchUp`] precedes a promote tier whose `hurdle_irr` sits above\nthe preferred return, the LP-100% infill between the catch-up and the\nhurdle dilutes the GP's realized share back below the catch-up\ntarget. LPAs where all post-catch-up dollars split continuously at\n`lp_share`/`gp_share` should set this tier's hurdle equal to the\npreceding preferred return (or `0.0` when there is no gap to fill),\nso the LP-100% infill is empty.",
          "properties": {
            "promote_tier": {
              "additionalProperties": false,
              "properties": {
                "gp_share": {
                  "description": "GP share of each split dollar, in `[0, 1]`; must sum to 1 with\n`lp_share`.",
                  "format": "double",
                  "type": "number"
                },
                "hurdle_irr": {
                  "description": "Annual decimal IRR hurdle (`0.12` = 12%) the LP must reach (at\n100% payout) before this tier's split activates.",
                  "format": "double",
                  "type": "number"
                },
                "lp_share": {
                  "description": "LP share of each split dollar, in `[0, 1]`; must sum to 1 with\n`gp_share`.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "hurdle_irr",
                "lp_share",
                "gp_share"
              ],
              "type": "object"
            }
          },
          "required": [
            "promote_tier"
          ],
          "type": "object"
        }
      ]
    },
    "PrivateMarketsFund": {
      "additionalProperties": false,
      "description": "Private markets fund investment instrument.\n\nModels a private equity, private credit, or alternative fund with a\ncashflow waterfall that determines LP/GP allocation. Future LP cashflows\nare selected relative to the caller's valuation date and optionally\ndiscounted with `discount_curve_id`.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "default": {},
          "description": "Attributes for scenario selection and tagging."
        },
        "currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Functional currency of the fund."
        },
        "discount_curve_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional discount curve for future LP cashflows.\n\nWhen `None`, future cashflows are included undiscounted relative to the\ncaller's valuation date."
        },
        "events": {
          "description": "Time-ordered list of fund events (contributions, proceeds, distributions).",
          "items": {
            "$ref": "#/$defs/FundEvent"
          },
          "type": "array"
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "unrealized_nav": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unrealized net asset value attributable to the LP, stated as of the\nfund's valuation date.\n\nHolder-view residual value : the fund's present\nvalue is the PV of LP cashflows strictly after the valuation date plus\nthis NAV. When `None`, the residual value is zero — a fully realized\nfund prices to ~0.\n\n**Do not combine a NAV mark with forecast distribution events after\nthe valuation date.** The NAV mark already embeds the value of the\nfund's future realizations, so supplying both double counts them:\nmodel either realized history + NAV mark (marked fund), or realized\nhistory + projected future events with no NAV (cashflow projection).\nThe NAV is added undiscounted, taken as stated at the valuation date."
        },
        "waterfall_spec": {
          "$ref": "#/$defs/PeFundWaterfallSpec",
          "description": "Waterfall specification defining LP/GP allocation tiers."
        }
      },
      "required": [
        "id",
        "currency",
        "waterfall_spec",
        "events"
      ],
      "type": "object"
    },
    "WaterfallStyle": {
      "description": "Waterfall allocation style.",
      "oneOf": [
        {
          "const": "european",
          "description": "European style: aggregate all events at fund level",
          "type": "string"
        },
        {
          "const": "american",
          "description": "American style: deal-by-deal allocation. Every event must carry a\nnon-empty `deal_id`; capital, preferred return, catch-up, and carry are\ntracked independently for each deal, while clawback remains a fund-level\nlifetime reconciliation.",
          "type": "string"
        }
      ]
    },
    "private_markets_fund": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/PrivateMarketsFund"
        },
        "type": {
          "const": "private_markets_fund",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/private_markets_fund.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "currency": "USD",
          "discount_curve_id": "USD-OIS",
          "events": [
            {
              "amount": {
                "amount": "5000000",
                "currency": "USD"
              },
              "date": "2024-01-15",
              "deal_id": null,
              "kind": "contribution"
            },
            {
              "amount": {
                "amount": "2000000",
                "currency": "USD"
              },
              "date": "2024-06-15",
              "deal_id": null,
              "kind": "contribution"
            },
            {
              "amount": {
                "amount": "4000000",
                "currency": "USD"
              },
              "date": "2026-03-01",
              "deal_id": "DEAL-1",
              "kind": "proceeds"
            },
            {
              "amount": {
                "amount": "4000000",
                "currency": "USD"
              },
              "date": "2027-01-01",
              "deal_id": null,
              "kind": "distribution"
            }
          ],
          "id": "PMF-EXAMPLE",
          "waterfall_spec": {
            "catch_up_mode": "full",
            "clawback": null,
            "day_count": "act_365f",
            "style": "european",
            "tranches": [
              "return_of_capital",
              {
                "preferred_irr": {
                  "hurdle_irr": 0.08
                }
              },
              {
                "catch_up": {
                  "gp_share": 0.5
                }
              },
              {
                "promote_tier": {
                  "gp_share": 0.2,
                  "hurdle_irr": 0.12,
                  "lp_share": 0.8
                }
              }
            ]
          }
        },
        "type": "private_markets_fund"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/private_markets_fund"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "private_markets_fund",
  "type": "object"
}
