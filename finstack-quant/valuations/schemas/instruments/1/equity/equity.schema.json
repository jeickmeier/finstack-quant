{
  "$defs": {
    "Equity": {
      "additionalProperties": false,
      "description": "Simple equity (spot) instrument.\n\nRepresents a spot equity position that can be priced using market data.\nThe price can come from direct market quotes or be computed from\nunderlying fundamentals.\n\nSee unit tests and `examples/` for usage.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and tagging"
        },
        "currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Currency in which the equity is quoted"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for pricing"
        },
        "discrete_dividends": {
          "default": [],
          "description": "Optional discrete cash dividends `(ex_date, amount)` for single-name forwards.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit scalar identifier used to resolve the dividend yield."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique identifier for the equity"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "price_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit scalar identifier used to resolve the spot price."
        },
        "price_quote": {
          "description": "Optional price quote (if not provided, will look up from market data)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "shares": {
          "description": "Optional number of shares (defaults to 1 if not specified)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ticker": {
          "description": "Ticker symbol (e.g., \"AAPL\", \"MSFT\")",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticker",
        "currency",
        "discount_curve_id",
        "attributes"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "equity": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/Equity"
        },
        "type": {
          "const": "equity",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/equity/equity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "currency": "USD",
          "discount_curve_id": "USD",
          "discrete_dividends": [],
          "div_yield_id": "AAPL-DIV",
          "id": "EQUITY-AAPL",
          "price_id": "AAPL-SPOT",
          "price_quote": null,
          "shares": 100.0,
          "ticker": "AAPL"
        },
        "type": "equity"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/equity"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "equity",
  "type": "object"
}
