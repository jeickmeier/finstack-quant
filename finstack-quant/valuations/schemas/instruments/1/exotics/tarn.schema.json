{
  "$defs": {
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "Tarn": {
      "additionalProperties": false,
      "description": "Target Redemption Note (TARN).\n\nPays periodic coupons = max(fixed_rate - floating_rate, floor) until the\ncumulative coupon reaches a target level, at which point the note redeems\nat par. Path-dependent due to the knockout on cumulative coupon.\n\n# Coupon Formula\n\n```text\nc_i = max(fixed_rate - L_i, floor)\n```\n\nwhere L_i is the floating rate (e.g., SOFR) for period i.\n\n# Target Knockout\n\n```text\nIf sum(c_1, ..., c_i) >= target => redeem at par, stop paying coupons\n```\n\nThe final coupon is reduced so the cumulative equals the target exactly.\n\n# References\n\n- Brigo, D., & Mercurio, F. (2006). *Interest Rate Models - Theory and\n  Practice* (2nd ed.). Springer. Chapter 14: Exotic Derivatives. `docs/REFERENCES.md#brigo-mercurio-2006-interest-rate-models`",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection."
        },
        "coupon_dates": {
          "description": "Coupon payment dates (must be sorted ascending).",
          "items": {
            "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
          },
          "type": "array"
        },
        "coupon_floor": {
          "description": "Floor on each period's coupon (typically 0.0).",
          "format": "double",
          "type": "number"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention for coupon accrual."
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for PV calculations."
        },
        "fixed_rate": {
          "description": "Fixed coupon rate (the \"strike\" rate).",
          "format": "double",
          "type": "number"
        },
        "forward_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Rates forward curve that projects the floating index (also the fixing-series key)."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "index_tenor": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
          "description": "Contractual tenor of the observed floating index (e.g. 3M, 6M); must match the forward curve tenor."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount."
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "target_coupon": {
          "description": "Target cumulative coupon level (triggers early redemption).\n\nA zero target is allowed and represents redemption at the first\nfuture coupon date without coupon accrual.",
          "format": "double",
          "type": "number"
        },
        "vol_surface_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional normal-vol surface used to infer HW1F short-rate σ for stress scenarios."
        }
      },
      "required": [
        "id",
        "fixed_rate",
        "coupon_floor",
        "target_coupon",
        "notional",
        "coupon_dates",
        "index_tenor",
        "forward_curve_id",
        "discount_curve_id",
        "day_count",
        "attributes"
      ],
      "type": "object"
    },
    "tarn": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/Tarn"
        },
        "type": {
          "const": "tarn",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/exotics/tarn.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "coupon_dates": [
            "2026-06-30",
            "2026-12-31",
            "2027-06-30",
            "2027-12-31",
            "2028-06-30",
            "2028-12-31",
            "2029-06-30",
            "2029-12-31",
            "2030-06-30",
            "2030-12-31"
          ],
          "coupon_floor": 0.0,
          "day_count": "act_360",
          "discount_curve_id": "USD-OIS",
          "fixed_rate": 0.06,
          "forward_curve_id": "USD-SOFR-6M",
          "id": "TARN-USD-5Y",
          "index_tenor": {
            "count": 6,
            "unit": "months"
          },
          "notional": {
            "amount": "1000000",
            "currency": "USD"
          },
          "target_coupon": 0.15,
          "vol_surface_id": "USD-SOFR-HW-VOL"
        },
        "type": "tarn"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/tarn"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "tarn",
  "type": "object"
}
