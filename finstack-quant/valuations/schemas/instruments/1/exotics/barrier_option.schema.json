{
  "$defs": {
    "BarrierOption": {
      "additionalProperties": false,
      "description": "Barrier option with a total trade rebate and explicit contractual monitoring.\nContinuous monitoring uses closed-form pricing by default. Discrete monitoring\nobserves only the supplied dates and uses Monte Carlo by default.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and grouping"
        },
        "barrier": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Barrier level (price that triggers knock-in/out)"
        },
        "barrier_type": {
          "$ref": "#/$defs/BarrierType",
          "description": "Barrier type (up/down, in/out)"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional dividend-yield scalar ID"
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Option expiry date"
        },
        "expiry_fixing": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal underlying fixing observed at expiry.\n\nRequired when valuing after expiry so the realized intrinsic value is\ninvariant to later market spot updates. At expiry, the current market\nspot is used when this field is absent."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Pricing overrides (manual price, yield, spread)"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-only pricing controls."
        },
        "monitoring": {
          "$ref": "#/$defs/Monitoring",
          "default": {
            "type": "continuous"
          },
          "description": "Contractual monitoring: continuous or an explicit, strictly increasing\nset of observation dates no later than expiry. Discrete pricing does not\ninterpolate hits between those dates."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount"
        },
        "observed_barrier_breached": {
          "description": "Observed barrier state for expired options.\n\nHistorical barrier monitoring must be supplied explicitly for expired\noptions because terminal spot alone does not reveal whether the barrier\nwas breached intralife and then reversed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Option type (call or put)"
        },
        "rebate": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total contractual trade rebate in the payoff currency, independent of\nnotional. Knock-outs pay on a hit according to `rebate_timing`;\nknock-ins pay at expiry only if no hit occurred."
        },
        "rebate_timing": {
          "$ref": "#/$defs/RebateTiming",
          "default": "at_hit",
          "description": "Timing of the knock-out rebate payment.\n\n`at_hit` (default, market standard) pays the rebate the moment a\nknock-out barrier is breached; `at_expiry` defers payment to expiry.\nKnock-in rebates always pay at expiry (a no-hit is only known then),\nso this setting does not affect them. The analytical pricer values\nat-hit rebates via the discounted first-passage closed form. Monte\nCarlo applies at-hit when `rebate_timing == AtHit` via\n`with_rebate_at_hit`; the crate primitive defaults to at-expiry."
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only valuation adjustments."
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Spot price identifier"
        },
        "strike": {
          "description": "Strike price",
          "format": "double",
          "type": "number"
        },
        "underlying_ticker": {
          "description": "Underlying asset ticker symbol",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "strike",
        "barrier",
        "option_type",
        "barrier_type",
        "expiry",
        "notional",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "BarrierType": {
      "description": "Four-state barrier option classification.",
      "oneOf": [
        {
          "const": "up_and_out",
          "description": "Up-and-out: knocked out when spot touches or rises above the barrier.",
          "type": "string"
        },
        {
          "const": "up_and_in",
          "description": "Up-and-in: activated when spot touches or rises above the barrier.",
          "type": "string"
        },
        {
          "const": "down_and_out",
          "description": "Down-and-out: knocked out when spot touches or falls below the barrier.",
          "type": "string"
        },
        {
          "const": "down_and_in",
          "description": "Down-and-in: activated when spot touches or falls below the barrier.",
          "type": "string"
        }
      ]
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "Monitoring": {
      "description": "Contractual barrier-monitoring convention.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Monitor continuously through the contractual monitoring interval.",
          "properties": {
            "type": {
              "const": "continuous",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Monitor only at the stated contractual observation dates.",
          "properties": {
            "observation_dates": {
              "description": "Strictly increasing dates on which the barrier level is observed.",
              "items": {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              "type": "array"
            },
            "type": {
              "const": "discrete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "observation_dates"
          ],
          "type": "object"
        }
      ]
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    },
    "RebateTiming": {
      "description": "Timing of a knock-out rebate payment.\n\nMarket-standard KO rebates pay **at hit** (the moment the barrier is\nbreached); paying at expiry is the less common variant. Knock-in rebates\nalways pay at expiry by definition (only at expiry is it known that the\noption failed to knock in), so this setting does not affect them.",
      "oneOf": [
        {
          "const": "at_hit",
          "description": "Rebate is paid at the barrier hit time (market standard for KO rebates).",
          "type": "string"
        },
        {
          "const": "at_expiry",
          "description": "Rebate is paid at option expiry.",
          "type": "string"
        }
      ]
    },
    "barrier_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/BarrierOption"
        },
        "type": {
          "const": "barrier_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/exotics/barrier_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "barrier": {
            "amount": "5000",
            "currency": "USD"
          },
          "barrier_type": "up_and_out",
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-20",
          "id": "BAR-SPX-UO-CALL",
          "monitoring": {
            "type": "continuous"
          },
          "notional": {
            "amount": "100000",
            "currency": "USD"
          },
          "option_type": "call",
          "rebate": {
            "amount": "50",
            "currency": "USD"
          },
          "rebate_timing": "at_hit",
          "spot_id": "SPX-SPOT",
          "strike": 4500.0,
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "barrier_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/barrier_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "barrier_option",
  "type": "object"
}
