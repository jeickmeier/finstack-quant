{
  "$defs": {
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "LookbackOption": {
      "additionalProperties": false,
      "description": "Lookback option instrument.\n\n# Monitoring Convention\n\nThis instrument uses **continuous monitoring** for analytical pricing. Real-world\nlookback options are typically monitored discretely (daily closes). The continuous\nformulas provide an upper bound; for accurate discrete pricing, use Monte Carlo.\n\nSee module-level documentation for details on discrete monitoring adjustments.\n\n# Observed Extrema\n\nFor seasoned options (where some monitoring has already occurred), provide:\n- `observed_min`: Minimum spot observed so far (for floating calls / fixed puts)\n- `observed_max`: Maximum spot observed so far (for floating puts / fixed calls)\n\nIf not provided, the current spot is used as the starting extremum.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and grouping"
        },
        "currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Currency of the strike, premium and present value."
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "description": "Day count convention"
        },
        "discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID for present value calculations"
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional dividend-yield scalar ID"
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Option expiry date"
        },
        "expiry_fixing": {
          "description": "Terminal underlying fixing observed at expiry, in the same quote units\nas `strike`.\n\nRequired when valuing after expiry so the realized payoff cannot move\nwith a later market spot snapshot. At expiry itself, the current market\nspot is treated as the terminal fixing when this field is absent.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "lookback_type": {
          "$ref": "#/$defs/LookbackType",
          "description": "Lookback type (fixed or floating strike)"
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "monitoring": {
          "$ref": "#/$defs/Monitoring",
          "default": {
            "type": "continuous"
          },
          "description": "Contractual monitoring of the path extremum.\n\n`continuous` (default) prices with the Goldman-Sosin-Gatto closed form.\n`discrete` observes the extremum only on the strictly increasing\n`observation_dates` (no later than expiry) and prices by Monte Carlo."
        },
        "observed_max": {
          "description": "Observed maximum underlying level since inception, in the same quote\nunits as `strike` (required for Floating Put / Fixed Call once seasoned).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "observed_min": {
          "description": "Observed minimum underlying level since inception, in the same quote\nunits as `strike` (required for Floating Call / Fixed Put once seasoned).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Option type (call or put)"
        },
        "quantity": {
          "description": "Number of underlying units the option is written on; PV and Greeks scale linearly with it.",
          "format": "double",
          "type": "number"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Spot price identifier"
        },
        "strike": {
          "description": "Strike price (None for floating strike lookbacks)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "underlying_ticker": {
          "description": "Underlying asset ticker symbol",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Volatility surface ID"
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "option_type",
        "lookback_type",
        "expiry",
        "quantity",
        "currency",
        "day_count",
        "discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "LookbackType": {
      "description": "Lookback option type.",
      "oneOf": [
        {
          "const": "fixed_strike",
          "description": "Fixed strike lookback: payoff depends on max/min relative to fixed strike",
          "type": "string"
        },
        {
          "const": "floating_strike",
          "description": "Floating strike lookback: strike is determined by path extremum",
          "type": "string"
        }
      ]
    },
    "Monitoring": {
      "description": "Contractual barrier-monitoring convention.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Monitor continuously through the contractual monitoring interval.",
          "properties": {
            "type": {
              "const": "continuous",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Monitor only at the stated contractual observation dates.",
          "properties": {
            "observation_dates": {
              "description": "Strictly increasing dates on which the barrier level is observed.",
              "items": {
                "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
              },
              "type": "array"
            },
            "type": {
              "const": "discrete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "observation_dates"
          ],
          "type": "object"
        }
      ]
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    },
    "lookback_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/LookbackOption"
        },
        "type": {
          "const": "lookback_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/exotics/lookback_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "currency": "USD",
          "day_count": "act_365f",
          "discount_curve_id": "USD-OIS",
          "div_yield_id": "SPX-DIV",
          "expiry": "2024-12-20",
          "id": "LOOKBACK-SPX-FIXED-CALL",
          "lookback_type": "fixed_strike",
          "monitoring": {
            "type": "continuous"
          },
          "observed_max": null,
          "observed_min": null,
          "option_type": "call",
          "quantity": 100000.0,
          "spot_id": "SPX-SPOT",
          "strike": 4500.0,
          "underlying_ticker": "SPX",
          "vol_surface_id": "SPX-VOL"
        },
        "type": "lookback_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/lookback_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "lookback_option",
  "type": "object"
}
