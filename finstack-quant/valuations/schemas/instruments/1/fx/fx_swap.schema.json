{
  "$defs": {
    "FxSwap": {
      "additionalProperties": false,
      "description": "FX Swap instrument definition",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and tagging."
        },
        "base_calendar_id": {
          "default": null,
          "description": "Optional base currency calendar for spot/settlement adjustment metadata.",
          "type": [
            "string",
            "null"
          ]
        },
        "base_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Base currency (foreign)."
        },
        "base_notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Notional amount in base currency (exchanged on near, reversed on far)."
        },
        "domestic_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Domestic discount curve id (quote currency)."
        },
        "far_date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Far leg settlement date (forward leg)."
        },
        "far_rate": {
          "default": null,
          "description": "Optional far leg FX rate (quote per base). If None, source from forwards.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "foreign_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Foreign discount curve id (base currency)."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {},
          "description": "Per-instrument pricing/sensitivity override knobs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "theta_period": null
          },
          "description": "Metric-time pricing configuration."
        },
        "near_date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Near leg settlement date (spot leg)."
        },
        "near_rate": {
          "default": null,
          "description": "Optional near leg FX rate (quote per base). If None, source from market.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "quote_calendar_id": {
          "default": null,
          "description": "Optional quote currency calendar for spot/settlement adjustment metadata.",
          "type": [
            "string",
            "null"
          ]
        },
        "quote_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Quote currency (domestic)."
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {},
          "description": "Scenario-only pricing adjustments."
        }
      },
      "required": [
        "id",
        "base_currency",
        "quote_currency",
        "near_date",
        "far_date",
        "base_notional",
        "domestic_discount_curve_id",
        "foreign_discount_curve_id",
        "attributes"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "fx_swap": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/FxSwap"
        },
        "type": {
          "const": "fx_swap",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/fx/fx_swap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "base_currency": "EUR",
          "base_notional": {
            "amount": "1000000",
            "currency": "EUR"
          },
          "domestic_discount_curve_id": "USD-OIS",
          "far_date": "2024-07-05",
          "far_rate": 1.12,
          "foreign_discount_curve_id": "EUR-OIS",
          "id": "FXSWAP-EURUSD-6M",
          "near_date": "2024-01-05",
          "near_rate": 1.1,
          "quote_currency": "USD"
        },
        "type": "fx_swap"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/fx_swap"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "fx_swap",
  "type": "object"
}
