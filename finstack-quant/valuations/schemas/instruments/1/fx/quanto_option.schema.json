{
  "$defs": {
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    },
    "QuantoOption": {
      "additionalProperties": false,
      "description": "Quanto option instrument.\n\nQuanto options have payoffs that depend on an underlying asset in one currency\nbut are settled in another currency, creating FX exposure.",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and grouping."
        },
        "base_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Base currency (equity denomination)."
        },
        "correlation": {
          "description": "Correlation between equity price and FX rate.",
          "format": "double",
          "type": "number"
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "default": "act_365f",
          "description": "Day count convention (defaults to ACT/365F)."
        },
        "div_yield_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional dividend-yield scalar ID."
        },
        "domestic_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID (domestic currency)."
        },
        "expiry": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Option expiry date."
        },
        "foreign_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Discount curve ID (foreign currency)."
        },
        "fx_spot_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional FX rate identifier."
        },
        "fx_vol_surface_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional FX volatility surface ID."
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier."
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "default": {},
          "description": "Instrument-owned pricing inputs."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "default": {
            "theta_period": null
          },
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Strike-equivalent domestic reference notional."
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "description": "Option type (call or put)."
        },
        "payoff_fx_rate": {
          "default": null,
          "description": "Fixed payoff FX conversion rate from base-currency payoff into quote currency.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "quantity": {
          "default": null,
          "description": "Number of underlying units covered by the option payoff.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "quote_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Quote currency (payment/settlement currency)."
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "default": {},
          "description": "Scenario-only pricing adjustments."
        },
        "spot_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Equity spot price identifier."
        },
        "strike": {
          "description": "Per-unit strike of the equity underlying, in `base_currency` price units.",
          "format": "double",
          "type": "number"
        },
        "underlying_ticker": {
          "description": "Underlying equity ticker symbol.",
          "type": "string"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Equity volatility surface ID."
        }
      },
      "required": [
        "id",
        "underlying_ticker",
        "strike",
        "option_type",
        "expiry",
        "notional",
        "base_currency",
        "quote_currency",
        "correlation",
        "domestic_discount_curve_id",
        "foreign_discount_curve_id",
        "spot_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "quanto_option": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/QuantoOption"
        },
        "type": {
          "const": "quanto_option",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/fx/quanto_option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "base_currency": "JPY",
          "correlation": -0.2,
          "day_count": "act_365f",
          "div_yield_id": "NKY-DIV",
          "domestic_discount_curve_id": "USD-OIS",
          "expiry": "2030-06-21",
          "foreign_discount_curve_id": "JPY-OIS",
          "fx_spot_id": "JPYUSD-SPOT",
          "fx_vol_surface_id": "JPYUSD-VOL",
          "id": "QUANTO-NKY-USD-CALL",
          "notional": {
            "amount": "1000000",
            "currency": "USD"
          },
          "option_type": "call",
          "payoff_fx_rate": 0.007142857142857143,
          "quantity": 4000.0,
          "quote_currency": "USD",
          "spot_id": "NKY-SPOT",
          "strike": 35000.0,
          "underlying_ticker": "NKY",
          "vol_surface_id": "NKY-VOL"
        },
        "type": "quanto_option"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/quanto_option"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "quanto_option",
  "type": "object"
}
