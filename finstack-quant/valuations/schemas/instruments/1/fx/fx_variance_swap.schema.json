{
  "$defs": {
    "FxVarianceSwap": {
      "additionalProperties": false,
      "description": "FX variance swap instrument.\n\nPayoff: Notional * (Realized Variance - Strike Variance)",
      "properties": {
        "attributes": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/attributes.schema.json",
          "description": "Attributes for scenario selection and tagging"
        },
        "base_calendar_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Base-currency calendar used in the joint observation calendar."
        },
        "base_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Base currency (foreign)"
        },
        "close_series_id": {
          "default": null,
          "description": "Series ID for close prices. Defaults to `spot_id` (or currency-pair string) when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "day_count": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
          "default": "act_365f",
          "description": "Day count convention for time calculations (defaults to ACT/365F)."
        },
        "domestic_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Domestic currency discount curve ID"
        },
        "foreign_discount_curve_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Foreign currency discount curve ID"
        },
        "high_series_id": {
          "default": null,
          "description": "Series ID for high prices (required for Parkinson, GarmanKlass, RogersSatchell, YangZhang).\nDefaults to `spot_id` (or currency-pair string) when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Unique instrument identifier"
        },
        "instrument_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/instrument_pricing_overrides.schema.json",
          "description": "Instrument-owned pricing inputs."
        },
        "low_series_id": {
          "default": null,
          "description": "Series ID for low prices (required for Parkinson, GarmanKlass, RogersSatchell, YangZhang).\nDefaults to `spot_id` (or currency-pair string) when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "maturity": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Contractual end of the observation period."
        },
        "metric_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/metric_pricing_overrides.schema.json",
          "description": "Metric-time pricing configuration."
        },
        "notional": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
          "description": "Variance notional (in quote currency units)"
        },
        "observation_business_day_convention": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/business_day_convention.schema.json",
          "default": "following",
          "description": "Business-day convention applied to observation dates."
        },
        "observation_end_of_month": {
          "default": false,
          "description": "Preserve month-end rolls for month/year observation frequencies.",
          "type": "boolean"
        },
        "observation_frequency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
          "description": "Observation frequency"
        },
        "open_series_id": {
          "default": null,
          "description": "Series ID for open prices (required for Parkinson, GarmanKlass, RogersSatchell, YangZhang).\nDefaults to `spot_id` (or currency-pair string) when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "quote_calendar_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "Quote-currency calendar used in the joint observation calendar."
        },
        "quote_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Quote currency (domestic)"
        },
        "realized_var_method": {
          "$ref": "#/$defs/RealizedVarMethod",
          "default": "close_to_close",
          "description": "Method for calculating realized variance (defaults to CloseToClose)"
        },
        "scenario_pricing_overrides": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/scenario_pricing_overrides.schema.json",
          "description": "Scenario-only pricing adjustments."
        },
        "settlement_date": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional cash-settlement date. Defaults to the adjusted final observation date."
        },
        "side": {
          "$ref": "#/$defs/PayReceive",
          "description": "Pay/receive variance"
        },
        "spot_id": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional spot identifier used to look up historical series."
        },
        "start_date": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
          "description": "Start date of observation period"
        },
        "strike_variance": {
          "description": "Strike variance (annualized)",
          "format": "double",
          "type": "number"
        },
        "trading_days_per_year": {
          "default": 252.0,
          "description": "Trading days per year used to annualise daily realized variance.\n\nA contract term of the variance-swap confirmation: daily observations\nare annualised by `trading_days_per_year / observation_frequency.count()`.\nMust be finite and positive. Defaults to\n[`crate::constants::TRADING_DAYS_PER_YEAR`] (252).",
          "format": "double",
          "type": "number"
        },
        "vol_surface_id": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
          "description": "FX volatility surface ID"
        }
      },
      "required": [
        "id",
        "base_currency",
        "quote_currency",
        "notional",
        "strike_variance",
        "start_date",
        "maturity",
        "observation_frequency",
        "base_calendar_id",
        "quote_calendar_id",
        "side",
        "domestic_discount_curve_id",
        "foreign_discount_curve_id",
        "vol_surface_id",
        "attributes"
      ],
      "type": "object"
    },
    "InstrumentSchema": {
      "const": "finstack_quant.instrument/1",
      "description": "Canonical schema marker for persisted instrument envelopes.",
      "type": "string"
    },
    "PayReceive": {
      "description": "Direction for instrument legs (universal for IRS, CDS, variance swaps, etc.)\n\nFor interest rate swaps: Pay = pay fixed/receive floating, Receive = receive fixed/pay floating\nFor credit default swaps: Pay = buy protection (pay premium), Receive = sell protection (receive premium)\nFor variance swaps: Pay = short variance, Receive = long variance",
      "oneOf": [
        {
          "const": "pay",
          "description": "Pay the primary leg (fixed rate in IRS, protection premium in CDS, short variance)",
          "type": "string"
        },
        {
          "const": "receive",
          "description": "Receive the primary leg (fixed rate in IRS, protection premium in CDS, long variance)",
          "type": "string"
        }
      ]
    },
    "RealizedVarMethod": {
      "description": "Methods for calculating realized variance from price series.",
      "oneOf": [
        {
          "const": "close_to_close",
          "description": "Standard close-to-close returns (market standard default)",
          "type": "string"
        },
        {
          "const": "parkinson",
          "description": "Parkinson (1980) high-low estimator",
          "type": "string"
        },
        {
          "const": "garman_klass",
          "description": "Garman-Klass (1980) OHLC estimator",
          "type": "string"
        },
        {
          "const": "rogers_satchell",
          "description": "Rogers-Satchell (1991) drift-independent OHLC estimator",
          "type": "string"
        },
        {
          "const": "yang_zhang",
          "description": "Yang-Zhang (2000) drift and opening gaps estimator",
          "type": "string"
        }
      ]
    },
    "fx_variance_swap": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/FxVarianceSwap"
        },
        "type": {
          "const": "fx_variance_swap",
          "type": "string"
        }
      },
      "required": [
        "type",
        "spec"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/instrument/1/fx/fx_variance_swap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical single-instrument v1 envelope generated from its serde type.",
  "examples": [
    {
      "instrument": {
        "spec": {
          "attributes": {},
          "base_calendar_id": "TARGET2",
          "base_currency": "EUR",
          "close_series_id": null,
          "day_count": "act_365f",
          "domestic_discount_curve_id": "USD-OIS",
          "foreign_discount_curve_id": "EUR-OIS",
          "high_series_id": null,
          "id": "FXVAR-EURUSD-1Y",
          "low_series_id": null,
          "maturity": "2025-01-02",
          "notional": {
            "amount": "1000000",
            "currency": "USD"
          },
          "observation_business_day_convention": "following",
          "observation_end_of_month": false,
          "observation_frequency": {
            "count": 1,
            "unit": "days"
          },
          "open_series_id": null,
          "quote_calendar_id": "USNY",
          "quote_currency": "USD",
          "realized_var_method": "close_to_close",
          "settlement_date": null,
          "side": "receive",
          "spot_id": "EURUSD",
          "start_date": "2024-01-02",
          "strike_variance": 0.04,
          "trading_days_per_year": 252.0,
          "vol_surface_id": "EURUSD-VOL"
        },
        "type": "fx_variance_swap"
      },
      "schema": "finstack_quant.instrument/1"
    }
  ],
  "properties": {
    "instrument": {
      "$ref": "#/$defs/fx_variance_swap"
    },
    "schema": {
      "$ref": "#/$defs/InstrumentSchema"
    }
  },
  "required": [
    "schema",
    "instrument"
  ],
  "title": "fx_variance_swap",
  "type": "object"
}
