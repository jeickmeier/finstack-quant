{
  "$id": "https://finstack_quant.dev/schemas/common/1/pool_accounts.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Account balances and performance tallies of a seasoned structured-credit pool.",
  "examples": [
    {
      "collection_account": {
        "amount": "250000",
        "currency": "USD"
      },
      "cumulative_defaults": {
        "amount": "8000000",
        "currency": "USD"
      }
    }
  ],
  "properties": {
    "collection_account": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Collection account balance\n([`AssetPool::collection_account`](super::AssetPool::collection_account))."
    },
    "cumulative_defaults": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative defaults to date\n([`AssetPool::cumulative_defaults`](super::AssetPool::cumulative_defaults))."
    },
    "cumulative_prepayments": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative voluntary prepayments\n([`AssetPool::cumulative_prepayments`](super::AssetPool::cumulative_prepayments))."
    },
    "cumulative_recoveries": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative recoveries on defaulted assets\n([`AssetPool::cumulative_recoveries`](super::AssetPool::cumulative_recoveries))."
    },
    "cumulative_scheduled_amortization": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative scheduled amortization\n([`AssetPool::cumulative_scheduled_amortization`](super::AssetPool::cumulative_scheduled_amortization))."
    },
    "excess_spread_account": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Excess spread account balance\n([`AssetPool::excess_spread_account`](super::AssetPool::excess_spread_account))."
    },
    "original_balance": {
      "anyOf": [
        {
          "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original (cut-off) pool balance\n([`AssetPool::original_balance`](super::AssetPool::original_balance))."
    }
  },
  "title": "PoolAccounts",
  "type": "object"
}
