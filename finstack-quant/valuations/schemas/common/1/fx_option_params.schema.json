{
  "$defs": {
    "FxDeltaConvention": {
      "additionalProperties": false,
      "description": "Explicit venue and premium-currency convention for FX delta reporting.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FxDeltaConventionKind",
          "description": "Delta convention quoted by the venue."
        },
        "premium_currency": {
          "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
          "description": "Currency in which the option premium is paid."
        },
        "venue": {
          "description": "Non-empty market venue or quoting-source identifier.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "premium_currency",
        "venue"
      ],
      "type": "object"
    },
    "FxDeltaConventionKind": {
      "description": "Pair/venue FX delta quoting convention selected by the contract.",
      "oneOf": [
        {
          "const": "spot",
          "description": "Unadjusted spot delta.",
          "type": "string"
        },
        {
          "const": "forward",
          "description": "Unadjusted forward delta.",
          "type": "string"
        },
        {
          "const": "premium_adjusted_spot",
          "description": "Premium-adjusted spot delta.",
          "type": "string"
        },
        {
          "const": "premium_adjusted_forward",
          "description": "Premium-adjusted forward delta.",
          "type": "string"
        }
      ]
    },
    "FxOptionDelivery": {
      "description": "Settlement profile of the FX option.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Cash-settled benchmark option whose intrinsic payoff is due at expiry.",
          "properties": {
            "type": {
              "const": "cash_at_expiry",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Deliverable option with a fixed native cash exchange on exercise.",
          "properties": {
            "date": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
              "description": "Booked value date of both currency legs, on or after expiry."
            },
            "exercised": {
              "description": "Confirmed expiry outcome. The live option has no known outcome.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "position": {
              "$ref": "#/$defs/FxOptionPosition",
              "description": "Signed holder position with positive base notional."
            },
            "type": {
              "const": "physical",
              "type": "string"
            }
          },
          "required": [
            "type",
            "date",
            "position"
          ],
          "type": "object"
        }
      ]
    },
    "FxOptionPosition": {
      "description": "Holder direction of a physically delivered FX option.",
      "oneOf": [
        {
          "const": "long",
          "description": "Holder receives the exercised option exchange.",
          "type": "string"
        },
        {
          "const": "short",
          "description": "Writer owes the opposite exchange when exercised.",
          "type": "string"
        }
      ]
    },
    "FxSpotBasis": {
      "description": "Value-date basis of the selected ordered FX quote.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The selected quote is cash FX at the valuation date.",
          "properties": {
            "type": {
              "const": "cash",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The selected outright is quoted for a stated value date.",
          "properties": {
            "date": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
              "description": "Fixed value date of the spot quote."
            },
            "type": {
              "const": "value_date",
              "type": "string"
            }
          },
          "required": [
            "type",
            "date"
          ],
          "type": "object"
        }
      ]
    },
    "OptionType": {
      "description": "Option payoff direction used by analytical and numerical model engines.",
      "oneOf": [
        {
          "const": "call",
          "description": "Call option.",
          "type": "string"
        },
        {
          "const": "put",
          "description": "Put option.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/common/1/fx_option_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pair, strike, expiry, notional, volatility surface, call/put and delta convention of a European FX option.",
  "examples": [
    {
      "base_currency": "EUR",
      "delivery": {
        "type": "cash_at_expiry"
      },
      "delta_convention": {
        "kind": "forward",
        "premium_currency": "USD",
        "venue": "generic_interbank"
      },
      "expiry": "2025-07-15",
      "id": "EURUSD-CALL-6M",
      "notional": {
        "amount": "1000000",
        "currency": "EUR"
      },
      "option_type": "call",
      "quote_currency": "USD",
      "spot_basis": {
        "type": "cash"
      },
      "strike": 1.12,
      "vol_surface_id": "EURUSD-VOL"
    }
  ],
  "properties": {
    "base_currency": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
      "description": "Base (foreign) currency: the notional currency."
    },
    "delivery": {
      "$ref": "#/$defs/FxOptionDelivery",
      "description": "Booked payoff and settlement profile."
    },
    "delta_convention": {
      "$ref": "#/$defs/FxDeltaConvention",
      "description": "Delta quoting convention: kind, premium currency (base or quote) and venue."
    },
    "expiry": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
      "description": "Date anchoring expiry and the option volatility clock."
    },
    "id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Unique instrument identifier."
    },
    "notional": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Notional in `base_currency`."
    },
    "option_type": {
      "$ref": "#/$defs/OptionType",
      "description": "`call` or `put` on the base currency."
    },
    "quote_currency": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
      "description": "Quote (domestic) currency: the strike and PV currency."
    },
    "spot_basis": {
      "$ref": "#/$defs/FxSpotBasis",
      "description": "Selected spot quote's fixed value-date basis."
    },
    "strike": {
      "description": "Strike exchange rate, quote currency per unit of base currency.",
      "format": "double",
      "type": "number"
    },
    "vol_surface_id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "FX volatility surface identifier."
    }
  },
  "required": [
    "spot_basis",
    "delivery",
    "id",
    "base_currency",
    "quote_currency",
    "strike",
    "expiry",
    "notional",
    "vol_surface_id",
    "option_type",
    "delta_convention"
  ],
  "title": "FxOptionParams",
  "type": "object"
}
