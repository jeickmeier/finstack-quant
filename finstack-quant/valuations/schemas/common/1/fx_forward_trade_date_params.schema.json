{
  "$id": "https://finstack_quant.dev/schemas/common/1/fx_forward_trade_date_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Trade-date, tenor and spot-roll inputs of an FX forward built from its trade date.",
  "examples": [
    {
      "base_calendar_id": "target2",
      "base_currency": "EUR",
      "business_day_convention": "modified_following",
      "domestic_discount_curve_id": "USD-OIS",
      "foreign_discount_curve_id": "EUR-OIS",
      "id": "EURUSD-FWD-3M",
      "notional": {
        "amount": "1000000",
        "currency": "EUR"
      },
      "preserve_business_eom": false,
      "quote_calendar_id": "usny",
      "quote_currency": "USD",
      "settlement_days": 2,
      "tenor": {
        "count": 3,
        "unit": "months"
      },
      "trade_date": "2025-01-15"
    }
  ],
  "properties": {
    "base_calendar_id": {
      "description": "Base-currency holiday calendar id (may itself be a composite such as\n`\"target2+usny\"` when the convention needs a USD gate).",
      "type": "string"
    },
    "base_currency": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
      "description": "Base (foreign) currency: the numerator of the quote and the notional currency."
    },
    "business_day_convention": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/business_day_convention.schema.json",
      "description": "Business-day convention rolling the maturity once on the joint\ncalendar."
    },
    "domestic_discount_curve_id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Quote-currency (domestic) discount curve identifier."
    },
    "foreign_discount_curve_id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Base-currency (foreign) discount curve identifier."
    },
    "id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Unique instrument identifier."
    },
    "notional": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Notional in `base_currency`."
    },
    "preserve_business_eom": {
      "description": "Keep a business month-end spot on the business month-end of the\nmaturity month; month and year tenors only.",
      "type": "boolean"
    },
    "quote_calendar_id": {
      "description": "Quote-currency holiday calendar id.",
      "type": "string"
    },
    "quote_currency": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/currency.schema.json",
      "description": "Quote (domestic) currency: the denominator of the quote and the PV currency."
    },
    "settlement_days": {
      "description": "Spot lag: business days from trade date to spot on the joint\nbase/quote calendar. Stated by the trade's convention; no pair table\nsupplies it.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "tenor": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
      "description": "Calendar tenor from spot to maturity, e.g. `3M`."
    },
    "trade_date": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
      "description": "Trade date from which the spot date is rolled."
    }
  },
  "required": [
    "id",
    "base_currency",
    "quote_currency",
    "trade_date",
    "tenor",
    "notional",
    "domestic_discount_curve_id",
    "foreign_discount_curve_id",
    "base_calendar_id",
    "quote_calendar_id",
    "settlement_days",
    "business_day_convention",
    "preserve_business_eom"
  ],
  "title": "FxForwardTradeDateParams",
  "type": "object"
}
