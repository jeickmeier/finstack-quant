{
  "$id": "https://finstack_quant.dev/schemas/common/1/floating_bond_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Identifier, notional, index, spread, dates, frequency, day count and curve of a floating-rate note.",
  "examples": [
    {
      "day_count": "act_360",
      "discount_curve_id": "USD-OIS",
      "forward_curve_id": "USD-SOFR-3M",
      "frequency": {
        "count": 3,
        "unit": "months"
      },
      "id": "FRN-001",
      "issue_date": "2025-01-15",
      "maturity": "2030-01-15",
      "notional": {
        "amount": "1000000",
        "currency": "USD"
      },
      "spread_bp": 200
    }
  ],
  "properties": {
    "day_count": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/day_count.schema.json",
      "description": "Accrual day count of the floating coupons, e.g. `act360`."
    },
    "discount_curve_id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Discount curve identifier for pricing."
    },
    "forward_curve_id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Forward (projection) curve of the coupon index, e.g. `USD-SOFR-3M`."
    },
    "frequency": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/tenor.schema.json",
      "description": "Coupon payment and reset frequency, e.g. `3M`."
    },
    "id": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/id.schema.json",
      "description": "Unique identifier for the bond."
    },
    "issue_date": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
      "description": "Issue date: start of the first coupon period."
    },
    "maturity": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
      "description": "Maturity date: end of the last coupon period and redemption date."
    },
    "notional": {
      "$ref": "https://finstack_quant.dev/schemas/common/1/money.schema.json",
      "description": "Principal amount; its currency is the coupon and redemption currency."
    },
    "spread_bp": {
      "description": "Spread over the index in integer basis points (200 = 2%).",
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "notional",
    "forward_curve_id",
    "spread_bp",
    "issue_date",
    "maturity",
    "frequency",
    "day_count",
    "discount_curve_id"
  ],
  "title": "FloatingBondParams",
  "type": "object"
}
