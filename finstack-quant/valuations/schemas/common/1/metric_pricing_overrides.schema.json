{
  "$defs": {
    "BondRiskBasis": {
      "description": "Basis used for bond duration, convexity, and DV01-style risk metrics.",
      "oneOf": [
        {
          "const": "bullet_discountable",
          "description": "Use maturity/workout cashflows under the quoted-yield convention.\n\nThis matches Bloomberg YAS \"Workout\" risk fields and is the default for\npublic bond risk metrics.",
          "type": "string"
        },
        {
          "const": "callable_oas",
          "description": "Use callable/putable option model repricing under the bond's OAS/tree configuration.",
          "type": "string"
        }
      ]
    },
    "BreakevenConfig": {
      "additionalProperties": false,
      "description": "Configuration for the breakeven calculator.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/BreakevenMode",
          "description": "Solve mode."
        },
        "target": {
          "$ref": "#/$defs/BreakevenTarget",
          "description": "Which valuation parameter to solve for."
        }
      },
      "required": [
        "target",
        "mode"
      ],
      "type": "object"
    },
    "BreakevenMode": {
      "description": "Linear (first-order) or iterative (full-reprice root-find) solve mode.\n\n# Why the two modes disagree\n\nThe gap between them is usually **not** dominated by convexity. `Linear`\ndivides by the sensitivity measured at `as_of`, whereas `Iterative`\nreprices at the horizon date, where the instrument has less remaining time\nand therefore a different sensitivity. On a 5Y bond over a 6M horizon the\ntwo differ by several percent even though convexity over the ~9bp solved\nshift contributes only a fraction of that. The gap grows with horizon\nlength, not just with curvature.\n\n`Iterative` is the more accurate answer where it is supported; `Linear` is\nthe fast approximation and the default.",
      "oneOf": [
        {
          "const": "linear",
          "description": "`-(carry_total) / sensitivity`, using the sensitivity at `as_of`.\n\nFast, first-order: ignores both convexity and the change in sensitivity\nover the horizon.",
          "type": "string"
        },
        {
          "const": "iterative",
          "description": "Brent root-find with a full reprice at the horizon date.\n\nCaptures convexity *and* the horizon change in sensitivity. Not\nsupported for [`BreakevenTarget::BaseCorrelation`], nor for\ncredit-curve instruments under `ZSpread`/`Oas` — see\n[`BreakevenTarget`] and the calculator docs for why.",
          "type": "string"
        }
      ]
    },
    "BreakevenTarget": {
      "description": "Which valuation parameter to solve the breakeven for.\n\n# Result units\n\nThe breakeven metric is a bare `f64` whose unit depends on the target. Read\nthe per-variant docs before interpreting a value:\n\n| Target             | Sensitivity     | Result unit          |\n|--------------------|-----------------|----------------------|\n| `ZSpread`          | CS01            | basis points         |\n| `Ytm`              | DV01            | basis points         |\n| `Oas`              | CS01            | basis points         |\n| `ImpliedVol`       | Vega            | vol points (1 = 1%)  |\n| `BaseCorrelation`  | Correlation01   | correlation points   |",
      "oneOf": [
        {
          "const": "z_spread",
          "description": "Z-spread breakeven, in **basis points** (sensitivity: CS01).",
          "type": "string"
        },
        {
          "const": "ytm",
          "description": "Yield-to-maturity breakeven, in **basis points** (sensitivity: DV01).",
          "type": "string"
        },
        {
          "const": "implied_vol",
          "description": "Implied volatility breakeven, in **vol points** where 1.0 = 1% absolute\nvol (sensitivity: Vega).",
          "type": "string"
        },
        {
          "const": "base_correlation",
          "description": "Base correlation breakeven, in **correlation points** (sensitivity:\nCorrelation01).\n\nOnly [`BreakevenMode::Linear`] is supported. Base-correlation skew is\nstrongly non-linear, so a first-order breakeven here is a coarser\napproximation than for spread or yield targets.",
          "type": "string"
        },
        {
          "const": "oas",
          "description": "OAS breakeven, in **basis points** (sensitivity: CS01).\n\nNote that under [`BreakevenMode::Iterative`] the solve applies a\nparallel discount-curve shift. For an instrument with embedded\noptionality that is a duration-space answer, not a true OAS shift,\nbecause OAS is defined relative to the option model.",
          "type": "string"
        }
      ]
    },
    "BumpConfig": {
      "additionalProperties": false,
      "description": "Bump sizes for finite-difference sensitivity calculations.",
      "properties": {
        "adaptive_bumps": {
          "default": false,
          "description": "Enable adaptive bump sizes based on volatility and moneyness\n\nWhen true, bump sizes are scaled based on:\n- Volatility level (higher vol → larger bumps)\n- Time to expiry (longer dated → larger bumps)\n- Moneyness (deep ITM/OTM → smaller bumps)\n\nDefault: false (use fixed bump sizes)",
          "type": "boolean"
        },
        "credit_spread_bump_bp": {
          "default": null,
          "description": "Custom credit spread bump size override (in basis points, e.g., 1.0 for 1bp).\n\nUsed by CS01 calculations that bump par spreads / hazard calibration quotes.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "rate_bump_bp": {
          "default": null,
          "description": "Custom rate bump size override (in basis points, e.g., 1.0 for 1bp)\n\nWhen set, overrides both standard and adaptive rate bump calculations.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "rho_bump_decimal": {
          "default": null,
          "description": "Rho bump size in **decimal rate** units (default `0.0001 = 1bp`).\n\nNote: internal curve-bump APIs often take bump sizes in **bp** units (`1.0 = 1bp`).\nPrefer using [`MetricPricingOverrides::rho_bump_bp`] when wiring into `BumpSpec::parallel_bp`\nor `metrics::bump_discount_curve_parallel` to avoid unit mistakes.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "spot_bump_pct": {
          "default": null,
          "description": "Custom spot bump size override (as percentage, e.g., 0.01 for 1%)\n\nWhen set, overrides both standard and adaptive spot bump calculations.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "vega_bump_decimal": {
          "default": null,
          "description": "Vega bump size in decimal (default 0.01 = 1%)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "vol_bump_pct": {
          "default": null,
          "description": "Custom volatility bump size override (as absolute vol, e.g., 0.01 for 1% vol)\n\nWhen set, overrides both standard and adaptive volatility bump calculations.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ytm_bump_decimal": {
          "default": null,
          "description": "Optional YTM bump size for numerical metrics (e.g., convexity/duration), in decimal (1 bp = 1e-4)",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
