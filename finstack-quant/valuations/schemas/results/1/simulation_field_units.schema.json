{
  "$defs": {
    "MetricFieldUnit": {
      "additionalProperties": false,
      "description": "The display unit of one scalar field of a result struct.",
      "properties": {
        "field": {
          "description": "Wire name of the field.",
          "type": "string"
        },
        "label": {
          "description": "Unit text as the field documents it, such as `USD per bp` or `years`.",
          "type": "string"
        },
        "source": {
          "description": "Canonical Rust field the unit is documented on.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "label",
        "source"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/results/1/simulation_field_units.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The display units of a simulation's coverage, diversion, enhancement and excess-spread series.",
  "examples": [
    {
      "coverage_tests": [
        {
          "field": "ratio",
          "label": "times covered",
          "source": "valuations::CoverageTestDiagnostic::ratio"
        },
        {
          "field": "trigger_level",
          "label": "times covered",
          "source": "valuations::CoverageTestDiagnostic::trigger_level"
        },
        {
          "field": "cushion",
          "label": "times covered",
          "source": "valuations::CoverageTestDiagnostic::cushion"
        }
      ],
      "credit_enhancement": {
        "field": "credit_enhancement",
        "label": "decimal share of collateral",
        "source": "valuations::TrancheCreditEnhancement::credit_enhancement"
      },
      "diverted_cash": {
        "field": "diverted_cash",
        "label": "USD",
        "source": "valuations::PeriodWaterfall::diverted_cash"
      },
      "excess_spread": {
        "field": "excess_spread",
        "label": "annual decimal of opening pool balance",
        "source": "valuations::PeriodDiagnostics::excess_spread"
      }
    }
  ],
  "properties": {
    "coverage_tests": {
      "description": "Unit of each numeric `CoverageTestDiagnostic` field, in the order the\nstruct declares them.",
      "items": {
        "$ref": "#/$defs/MetricFieldUnit"
      },
      "type": "array"
    },
    "credit_enhancement": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `TrancheCreditEnhancement::credit_enhancement`."
    },
    "diverted_cash": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `PeriodWaterfall::diverted_cash` and of each diversion's amount."
    },
    "excess_spread": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `PeriodDiagnostics::excess_spread`."
    }
  },
  "required": [
    "coverage_tests",
    "diverted_cash",
    "credit_enhancement",
    "excess_spread"
  ],
  "title": "SimulationFieldUnits",
  "type": "object"
}
