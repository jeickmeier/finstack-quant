{
  "$defs": {
    "DealType": {
      "description": "Primary structured credit deal classification",
      "oneOf": [
        {
          "const": "clo",
          "description": "Collateralized Loan Obligation",
          "type": "string"
        },
        {
          "const": "cbo",
          "description": "Collateralized Bond Obligation",
          "type": "string"
        },
        {
          "const": "abs",
          "description": "Generic Asset-Backed Security",
          "type": "string"
        },
        {
          "const": "rmbs",
          "description": "Residential Mortgage-Backed Security",
          "type": "string"
        },
        {
          "const": "cmbs",
          "description": "Commercial Mortgage-Backed Security",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "Auto Loan ABS",
          "type": "string"
        },
        {
          "const": "card",
          "description": "Credit Card ABS",
          "type": "string"
        }
      ]
    }
  },
