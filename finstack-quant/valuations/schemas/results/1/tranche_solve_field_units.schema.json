{
  "$defs": {
    "MetricFieldUnit": {
      "additionalProperties": false,
      "description": "The display unit of one scalar field of a result struct.",
      "properties": {
        "field": {
          "description": "Wire name of the field.",
          "type": "string"
        },
        "label": {
          "description": "Unit text as the field documents it, such as `USD per bp` or `years`.",
          "type": "string"
        },
        "source": {
          "description": "Canonical Rust field the unit is documented on.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "label",
        "source"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/results/1/tranche_solve_field_units.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The display units of the tranche break-even CDR, discount margin and OAS results.",
  "examples": [
    {
      "breakeven_cdr": {
        "field": "breakeven_cdr",
        "label": "decimal",
        "source": "valuations::tranche_breakeven_cdr"
      },
      "discount_margin": {
        "field": "discount_margin",
        "label": "decimal",
        "source": "valuations::tranche_discount_margin"
      },
      "oas": [
        {
          "field": "oas",
          "label": "decimal",
          "source": "valuations::OasResult::oas"
        },
        {
          "field": "model_price",
          "label": "% of current balance",
          "source": "valuations::OasResult::model_price"
        },
        {
          "field": "market_price",
          "label": "% of current balance",
          "source": "valuations::OasResult::market_price"
        },
        {
          "field": "num_paths",
          "label": "paths",
          "source": "valuations::OasResult::num_paths"
        },
        {
          "field": "price_std_error",
          "label": "% of current balance",
          "source": "valuations::OasResult::price_std_error"
        }
      ]
    }
  ],
  "properties": {
    "breakeven_cdr": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of the value `tranche_breakeven_cdr` returns."
    },
    "discount_margin": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of the value `tranche_discount_margin` returns."
    },
    "oas": {
      "description": "Unit of every `OasResult` field, in the order the struct declares them.",
      "items": {
        "$ref": "#/$defs/MetricFieldUnit"
      },
      "type": "array"
    }
  },
  "required": [
    "breakeven_cdr",
    "discount_margin",
    "oas"
  ],
  "title": "TrancheSolveFieldUnits",
  "type": "object"
}
