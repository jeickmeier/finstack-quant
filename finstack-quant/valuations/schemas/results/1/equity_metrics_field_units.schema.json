      "description": "Unit of `EquityMetrics::invested`."
    },
    "irr": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `EquityMetrics::irr`."
    },
    "moic": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `EquityMetrics::moic`."
    },
    "nav_pct": {
      "$ref": "#/$defs/MetricFieldUnit",
      "description": "Unit of `EquityMetrics::nav_pct`."
    }
  },
  "required": [
    "invested",
    "irr",
    "moic",
    "nav_pct",
    "cash_on_cash"
