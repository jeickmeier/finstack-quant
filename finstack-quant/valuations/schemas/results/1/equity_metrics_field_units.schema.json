{
  "$defs": {
    "MetricFieldUnit": {
      "additionalProperties": false,
      "description": "The display unit of one scalar field of a result struct.",
      "properties": {
        "field": {
          "description": "Wire name of the field.",
          "type": "string"
        },
        "label": {
          "description": "Unit text as the field documents it, such as `USD per bp` or `years`.",
          "type": "string"
        },
        "source": {
          "description": "Canonical Rust field the unit is documented on.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "label",
        "source"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/results/1/equity_metrics_field_units.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The display units of an equity tranche's invested amount, IRR, MOIC, NAV and cash-on-cash.",
  "examples": [
    {
      "cash_on_cash": {
        "field": "cash_on_cash",
        "label": "decimal share of invested",
        "source": "valuations::EquityMetrics::cash_on_cash"
      },
      "invested": {
        "field": "invested",
        "label": "USD",
        "source": "valuations::EquityMetrics::invested"
      },
      "irr": {
        "field": "irr",
        "label": "annual decimal, ACT/365F",
        "source": "valuations::EquityMetrics::irr"
      },
      "moic": {
        "field": "moic",
        "label": "multiple of invested",
        "source": "valuations::EquityMetrics::moic"
      },
      "nav_pct": {
        "field": "nav_pct",
        "label": "% of current balance",
        "source": "valuations::EquityMetrics::nav_pct"
      }
    }
  ],
  "properties": {
    "cash_on_cash": {
      "$ref": "#/$defs/MetricFieldUnit",
