{
  "$defs": {
    "DateWire": {
      "description": "ISO 8601 calendar date encoded as a `YYYY-MM-DD` JSON string.",
      "format": "date",
      "type": "string"
    },
    "PeriodKind": {
      "description": "Period frequency type.\n\nDefines the frequency of periodic schedules (cashflow rolls, return-series\nresampling, statement reporting). Two different yearly counts exist:\n[`PeriodKind::annualization_factor`] is the conventional statistical\nfactor for explicitly selected observations (daily trading 252), and\n[`PeriodKind::slots_per_year`] is the calendar partition count, defined\nonly for the month-block kinds (record CORE-CONVENTIONS-014 #9).\n\nParses only the canonical snake_case wire values via [`std::str::FromStr`]:\n`daily`, `weekly`, `monthly`, `quarterly`, `semi_annual`, and `annual`.\nAliases, whitespace padding and case variants are rejected.\n\nOrdering follows [`PeriodKind::rank`] (daily through annual). It is a\ndeterministic key order, not a chronology.",
      "oneOf": [
        {
          "const": "daily",
          "description": "Daily periods (252 trading days per year by convention)",
          "type": "string"
        },
        {
          "const": "quarterly",
          "description": "Quarterly periods (4 per year)",
          "type": "string"
        },
        {
          "const": "monthly",
          "description": "Monthly periods (12 per year)",
          "type": "string"
        },
        {
          "const": "weekly",
          "description": "Weekly periods (ISO 8601 week-year, typically 52 or 53 per year)",
          "type": "string"
        },
        {
          "const": "semi_annual",
          "description": "Semi-annual periods (2 per year)",
          "type": "string"
        },
        {
          "const": "annual",
          "description": "Annual periods (1 per year)",
          "type": "string"
        }
      ]
    },
    "TickerSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/analytics/1/performance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Central performance analytics engine.",
  "examples": [
    {
      "benchmark_idx": 1,
      "end_idx": 7,
      "frequency": "daily",
      "price_dates": [
        "2025-01-01",
        "2025-01-02",
        "2025-01-03",
        "2025-01-04",
        "2025-01-05",
        "2025-01-06",
        "2025-01-07",
        "2025-01-08"
      ],
      "return_spans": [
        {
          "end": 7,
          "start": 0
        },
        {
          "end": 7,
          "start": 0
        }
      ],
      "returns": [
        [
          0.02,
          -0.0294117647059,
          0.020202020202,
          0.019801980198,
          -0.00970873786408,
          0.0196078431373,
          0.0192307692308
        ],
        [
          0.01,
          -0.00990099009901,
          0.02,
          -0.00980392156863,
          0.019801980198,
          0.00970873786408,
          0.00961538461538
        ]
      ],
      "start_idx": 0,
      "ticker_names": [
        "FUND",
        "BENCH"
      ]
    }
  ],
  "properties": {
    "benchmark_idx": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "end_idx": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeriodKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "price_dates": {
      "items": {
        "$ref": "#/$defs/DateWire"
      },
      "type": "array"
    },
    "return_spans": {
      "items": {
        "$ref": "#/$defs/TickerSpan"
      },
      "type": "array"
    },
    "returns": {
      "items": {
        "items": {
          "format": "double",
          "type": "number"
        },
        "type": "array"
      },
      "type": "array"
    },
    "start_idx": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "ticker_names": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "price_dates",
    "returns",
    "return_spans",
    "ticker_names",
    "start_idx",
    "end_idx"
  ],
  "title": "Performance",
  "type": "object"
}
