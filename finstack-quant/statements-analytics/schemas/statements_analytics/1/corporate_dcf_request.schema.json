    "DateWire": {
      "description": "ISO 8601 calendar date encoded as a `YYYY-MM-DD` JSON string.",
      "format": "date",
      "type": "string"
    },
    "DcfInputs": {
      "additionalProperties": false,
      "description": "Headline DCF assumptions of [`evaluate_dcf`](crate::analysis::evaluate_dcf): discount rate, terminal value,\ncash-flow node and optional net-debt override.\n\nThe serde form is the host input of `evaluate_dcf`: `wacc` and\n`terminal_value` are required, `ufcf_node` defaults to\n[`DEFAULT_UFCF_NODE`] and `net_debt_override` to `None`; an unknown field\nis rejected. For example\n`{\"wacc\": 0.10, \"terminal_value\": {\"type\": \"gordon_growth\", \"stable_growth_rate\": 0.02}}`.",
      "properties": {
        "net_debt_override": {
          "default": null,
          "description": "Flat net-debt amount in model currency used instead of the\nmodel-derived equity bridge; `None` (the default) derives net debt\nfrom the model's debt and cash.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_value": {
          "$ref": "#/$defs/TerminalValueSpec",
          "description": "Terminal-value convention applied after the explicit forecast period."
        },
        "ufcf_node": {
          "default": "ufcf",
          "description": "Node id containing monetary unlevered free cash flow for forecast\nperiods (default [`DEFAULT_UFCF_NODE`], `\"ufcf\"`).",
          "type": "string"
        },
        "wacc": {
          "description": "Weighted average cost of capital as a decimal (`0.10` means `10%`).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "wacc",
        "terminal_value"
      ],
      "type": "object"
    },
    "DcfOptions": {
      "additionalProperties": false,
      "description": "Optional configuration for DCF valuation beyond the core WACC/terminal parameters.\n\nPercentage-style inputs use decimal form, so `0.10` means `10%`.\n[`Default`] caps perpetual stable growth at 5%.\n\nThe serde form is the host input for DCF options: every field is optional\nand a missing field takes its [`Default`] value, while an unknown field is\nrejected. For example `{\"exit_multiple_bump\": {\"relative\": 0.10}}` keeps\nevery other default and shocks the exit multiple by ±10%.",
      "properties": {
        "equity_bridge": {
          "anyOf": [
            {
              "$ref": "#/$defs/EquityBridge"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured equity bridge; when `Some` it is used as-is and the model's\ndebt/cash (and any net-debt override) are not consulted."
        },
        "exit_multiple_bump": {
          "$ref": "#/$defs/ExitMultipleBump",
          "default": {
            "absolute": 1.0
          },
          "description": "Exit-multiple sensitivity bump (default: `ExitMultipleBump::Absolute(1.0)`).\n\nUse `ExitMultipleBump::Relative` for a proportional shock,\ne.g. `Relative(0.10)` for ±10% of the base multiple. Absolute\nbumps are clamped at zero on the downside."
        },
        "exit_multiple_metric_node": {
          "default": null,
          "description": "Statement flow node whose complete trailing calendar year supplies the\n[`TerminalValueSpec::ExitMultiple`] metric (default: `None`).\n\nWhen `Some`, sum contiguous actual and forecast periods over the year ending\nat the last forecast boundary. Values must be finite and monetary. Missing\nhistory or a partial boundary requires an explicit annual metric. When `None`, the\nspec's explicit `terminal_metric` is used. Ignored for Gordon\nGrowth and H-Model terminals.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_stable_growth_rate": {
          "default": 0.05,
          "description": "Maximum perpetual stable growth rate accepted by Gordon Growth and the\nH-Model (default `0.05` = 5%).\n\nThis is a policy ceiling, not merely the mathematical `g < WACC`\nconstraint. Set it to the valuation's defensible long-run nominal\neconomy or risk-free growth assumption.",
          "format": "double",
          "type": "number"
        },
        "mid_year_convention": {
          "default": false,
          "description": "Enable mid-year discounting convention (default: false).",
          "type": "boolean"
        },
        "shares_outstanding": {
          "default": null,
          "description": "Basic shares outstanding for per-share value.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "valuation_discounts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValuationDiscounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Private company valuation discounts (DLOM, DLOC).\n\nDiscounts apply after the DCF EV-to-equity bridge. The reported DCF\nenterprise value remains pre-discount and will not reconcile to\ndiscounted equity value plus net debt when discounts are present."
        },
        "wacc_denominator_epsilon": {
          "default": 0.005,
          "description": "Minimum spread between WACC-down and the Gordon / H-Model growth\nrate in the terminal-value formula (default `0.005` = 50 bp).\n\nWhen `wacc - bump < growth + epsilon`, the down-shock is clamped\nto `growth + epsilon` so the `1/(wacc - g)` denominator stays\nwell defined. The clamp is reported in the trace so the caller\nknows the bump was shortened.",
          "format": "double",
          "type": "number"
        },
        "wacc_sensitivity_bump": {
          "default": 0.01,
          "description": "WACC sensitivity bump, in decimal (default `0.01` = ±100 bp).\n\nThe down-shock is clamped so the terminal-value denominator\n`wacc - g` cannot collapse (the resulting EV would blow up and\nobscure the true sensitivity). See\n[`DcfOptions::wacc_denominator_epsilon`].",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "DcfProjection": {
      "additionalProperties": false,
      "description": "Authored terminal horizon and optional normalized annual FCFF election.",
      "properties": {
        "forward_remainder_node": {
          "description": "Exact monetary node for the forward portion of the one forecast period\nstraddling the cut. Its modeled receipt is the end of that period.",
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_annual_fcff": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalFcffBasis"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for a growth terminal and absent for an exit multiple."
        },
        "stable_growth_ceiling": {
          "description": "Elected maximum annual stable growth as a decimal rate; absent means no ceiling.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_date": {
          "$ref": "#/$defs/DateWire",
          "description": "Terminal value is discounted to the same cut on its own ACT/365.25 tenor."
        }
      },
      "required": [
        "terminal_date"
      ],
      "type": "object"
    },
    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.\n\nRestoration routes through [`crate::decimal::parse_decimal`], the single\nexact text-admission rule: JSON numbers, malformed text and inexact values\nare rejected rather than rounded. Serialization writes canonical\nfixed-point text with trailing zeros removed and signed zero normalized\n(`\"1.5\"`, `\"0\"`), never scientific notation.",
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "type": "string"
    },
    "EquityBridge": {
      "additionalProperties": false,
      "description": "Structured equity bridge for converting Enterprise Value to Equity Value.\n\nStandard professional bridge:\n```text\nEquity = EV - Total Debt + Cash - Preferred Equity - Minority Interest\n         + Non-Operating Assets + Σ(other adjustments)\n```\n\nEvery [`DiscountedCashFlow`] carries one; a flat net-debt deduction is\nwritten as `EquityBridge { total_debt, cash, ..Default::default() }`.",
      "properties": {
        "cash": {
          "default": 0.0,
          "description": "Cash and cash equivalents.",
          "format": "double",
          "type": "number"
        },
        "minority_interest": {
          "default": 0.0,
          "description": "Non-controlling (minority) interests.",
          "format": "double",
          "type": "number"
        },
        "non_operating_assets": {
          "default": 0.0,
          "description": "Non-operating assets (excess cash, investments, real estate, etc.).",
          "format": "double",
          "type": "number"
        },
        "other_adjustments": {
          "description": "Named adjustments (e.g., unfunded pension, contingent liabilities).\nPositive values increase equity; negative values decrease it.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "format": "double",
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "preferred_equity": {
          "default": 0.0,
          "description": "Preferred stock at liquidation preference.",
          "format": "double",
          "type": "number"
        },
        "total_debt": {
          "default": 0.0,
          "description": "Total interest-bearing debt.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ExitMultipleBump": {
      "description": "Exit-multiple sensitivity shock shape.\n\nAbsolute bumps are in multiple-turn units (e.g. `Absolute(1.0)` is\n±1.0x). Relative bumps are decimal fractions of the base multiple\n(e.g. `Relative(0.10)` is ±10%).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Absolute bump in turns of the multiple.",
          "properties": {
            "absolute": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "absolute"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Proportional bump in decimal (0.10 = ±10%).",
          "properties": {
            "relative": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "relative"
          ],
          "type": "object"
        }
      ]
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "StatementValuationCut": {
      "additionalProperties": false,
      "description": "Explicit timing basis for a point-in-time corporate valuation.",
      "properties": {
        "as_of": {
          "$ref": "#/$defs/DateWire",
          "description": "Effective calendar date from which projected cash receipts are discounted."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "Single reporting currency shared by authored cashflows, bridges and the model."
        },
        "observed_through": {
          "$ref": "#/$defs/DateWire",
          "description": "Latest publication date eligible for the statement run, inclusive."
        }
      },
      "required": [
        "as_of",
        "observed_through",
        "currency"
      ],
      "type": "object"
    },
    "TerminalFcffBasis": {
      "description": "Explicit source of normalized annual FCFF for a perpetual-growth terminal.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Same-currency annualized FCFF authored directly for the terminal date.",
          "properties": {
            "amount": {
              "$ref": "#/$defs/Money",
              "description": "Signed FCFF per year, measured on a nominal currency basis."
            },
            "kind": {
              "const": "authored",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amount"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Sum the complete 12 months of additive forecast FCFF at the horizon.",
          "properties": {
            "kind": {
              "const": "trailing_additive",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "TerminalValueSpec": {
      "description": "Terminal value calculation method for DCF.",
      "oneOf": [
        {
          "description": "Gordon Growth Model: TV = FCF_terminal × (1 + g) / (WACC - g)",
          "properties": {
            "stable_growth_rate": {
              "description": "Perpetual stable growth rate as an annual decimal (e.g., 0.02 for\n2%). Must be < WACC.",
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "gordon_growth",
              "type": "string"
            }
          },
          "required": [
            "type",
            "stable_growth_rate"
          ],
          "type": "object"
        },
        {
          "description": "Exit Multiple: TV = Terminal_Metric × Multiple",
          "properties": {
            "multiple": {
              "description": "Multiple to apply (e.g., 10.0 for 10x EBITDA)",
              "format": "double",
              "type": "number"
            },
            "terminal_metric": {
              "description": "Terminal metric in major currency units (for example, EBITDA).\nRequired for standalone pricing. A statement DCF can resolve it from a metric node.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "exit_multiple",
              "type": "string"
            }
          },
          "required": [
            "type",
            "multiple"
          ],
          "type": "object"
        },
        {
          "description": "H-Model: linear fade from high growth to stable growth (Damodaran).\n\n```text\nTV = FCF_T × (1+g_s)/(WACC-g_s) + FCF_T × H × (g_h-g_s)/(WACC-g_s)\n```\n\nwhere `H` is the half-life in years of the high-growth fade period.\nThe first term is the standard Gordon Growth stable-state value;\nthe second term captures the present value of excess growth that\nlinearly decays from `high_growth_rate` to `stable_growth_rate`\nover `2 × half_life_years`.",
          "properties": {
            "half_life_years": {
              "description": "Half-life of the growth fade in years (e.g., 5.0).",
              "format": "double",
              "type": "number"
            },
            "high_growth_rate": {
              "description": "Initial high growth rate (e.g., 0.15 for 15%).",
              "format": "double",
              "type": "number"
            },
            "stable_growth_rate": {
              "description": "Long-run stable growth rate (e.g., 0.03 for 3%). Must be < WACC.",
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "h_model",
              "type": "string"
            }
          },
          "required": [
            "type",
            "high_growth_rate",
            "stable_growth_rate",
            "half_life_years"
          ],
          "type": "object"
        }
      ]
    },
    "ValuationDiscounts": {
      "additionalProperties": false,
      "description": "Valuation discounts for private company equity.\n\nApplied multiplicatively after the equity bridge:\n```text\nFMV = Equity Value × (1 - DLOC) × (1 - DLOM) × (1 - other_discount)\n```\n\nThe enterprise value reported by a DCF remains pre-discount. When discounts\nare present, `enterprise_value - net_debt` reconciles to pre-discount\nequity value, not to the discounted fair-market equity value.",
      "properties": {
        "dloc": {
          "description": "Discount for Lack of Control (0.0–1.0, e.g., 0.20 for 20%).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "dlom": {
          "description": "Discount for Lack of Marketability (0.0–1.0, e.g., 0.25 for 25%).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "other_discount": {
          "description": "Additional discount (0.0–1.0).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/statements_analytics/1/corporate_dcf_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Named cash-flow and terminal assumptions on an explicit statement valuation cut.",
  "properties": {
    "cut": {
      "$ref": "#/$defs/StatementValuationCut",
      "description": "Explicit effective valuation date, observation cutoff and currency."
    },
    "inputs": {
      "$ref": "#/$defs/DcfInputs",
      "description": "WACC, terminal method and explicitly named operating cashflow."
    },
    "options": {
      "$ref": "#/$defs/DcfOptions",
      "description": "Additional equity bridge, dilution and timing assumptions."
    },
    "projection": {
      "$ref": "#/$defs/DcfProjection",
      "description": "Projection selection and normalized annual terminal basis."
    }
  },
  "required": [
    "cut",
    "inputs",
    "projection",
    "options"
  ],
  "title": "CorporateDcfRequest",
  "type": "object"
}
