{
  "$id": "https://finstack_quant.dev/schemas/statements_analytics/1/peer_filter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Criteria for filtering companies into a peer set.",
  "properties": {
    "countries": {
      "description": "ISO country codes to include (meta key: \"country\").",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "excluded_tags": {
      "description": "Excluded attribute tags (none may be present).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gics_industries": {
      "description": "GICS industry codes to include (meta key: \"gics_industry\").",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gics_sectors": {
      "description": "GICS sector codes to include (meta key: \"gics_sector\").",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "market_cap_max": {
      "description": "Market cap ceiling (inclusive).",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "market_cap_min": {
      "description": "Market cap floor (inclusive).",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "ratings": {
      "description": "Credit rating bands to include (meta key: \"rating\").",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_tags": {
      "description": "Required attribute tags (all must be present).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "selectors": {
      "description": "Arbitrary attribute selector strings (uses `Attributes::matches_selector`).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "gics_sectors",
    "gics_industries",
    "countries",
    "ratings",
    "required_tags",
    "excluded_tags",
    "selectors"
  ],
  "title": "PeerFilter",
  "type": "object"
}
