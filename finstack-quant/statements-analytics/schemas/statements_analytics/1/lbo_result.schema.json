          "const": "YER",
          "description": "Yemeni Rial (886)",
          "type": "string"
        },
        {
          "const": "ZAR",
          "description": "Rand (710)",
          "type": "string"
        },
        {
          "const": "ZMW",
          "description": "Zambian Kwacha (967)",
          "type": "string"
        },
        {
          "const": "ZWL",
          "description": "Zimbabwe Dollar (932)",
          "type": "string"
        }
      ]
    },
    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
      "type": "string"
    },
    "Materiality": {
      "description": "Materiality context attached to a finding, describing its quantitative\nsignificance.",
      "properties": {
        "absolute": {
          "description": "Absolute amount of the discrepancy.",
          "format": "double",
          "type": "number"
        },
        "reference_label": {
          "description": "Human-readable label for the reference (e.g. \"total_assets\").",
          "type": "string"
        },
        "reference_value": {
          "description": "The reference (denominator) value used when computing `relative_pct`.",
          "format": "double",
          "type": "number"
        },
        "relative_pct": {
          "description": "Discrepancy as a percentage of the reference value.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "absolute",
        "relative_pct",
        "reference_value",
        "reference_label"
      ],
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "NodeId": {
      "description": "Type-safe identifier for a node in a financial model.\n\nSerializes as a plain string and is interoperable with `&str` via\n[`Borrow`] and [`AsRef`].",
      "type": "string"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/statements_analytics/1/lbo_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Outputs of an LBO evaluation.",
  "properties": {
    "checks": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckReport"
        },
        {
          "type": "null"
        }
      ],
      "description": "Report from the [`lbo_model_checks`] suite when\n[`LboConfig::check_mappings`] was supplied."
    },
    "debt_total": {
      "$ref": "#/$defs/Money",
      "description": "Total funded debt at close (sum of [`LboConfig::sources`])."
    },
    "entry_enterprise_value": {
      "$ref": "#/$defs/Money",
      "description": "Entry enterprise value: `entry_multiple × entry metric`."
    },
    "entry_metric": {
      "description": "Entry metric value read from the model at the first period.",
      "format": "double",
      "type": "number"
    },
    "equity_check": {
      "$ref": "#/$defs/Money",
      "description": "Sponsor equity required to close: `uses_total − debt_total`."
    },
    "exit_enterprise_value": {
      "$ref": "#/$defs/Money",
      "description": "Exit enterprise value: `exit_multiple × exit metric`."
    },
    "exit_equity_proceeds": {
      "$ref": "#/$defs/Money",
      "description": "Equity proceeds at exit: `exit_enterprise_value − exit_net_debt`."
    },
    "exit_metric": {
      "description": "Exit metric value read from the model at `exit_period`.",
      "format": "double",
      "type": "number"
    },
    "exit_net_debt": {
      "$ref": "#/$defs/Money",
      "description": "Net debt outstanding at `exit_period`."
    },
    "moic": {
      "description": "Multiple of invested capital: `exit_equity_proceeds / equity_check`.",
      "format": "double",
      "type": "number"
    },
    "sources_total": {
      "$ref": "#/$defs/Money",
      "description": "Total sources: funded debt plus the sponsor equity check."
    },
    "sources_uses_balanced": {
      "description": "`true` when sources reconcile to uses within a relative tolerance of\n`1e-9` scaled by deal size. False signals a\nnumerically degenerate capital structure (for example, tranche amounts\nso large relative to the purchase price that the residual equity check\nloses all significance).",
      "type": "boolean"
    },
    "uses_total": {
      "$ref": "#/$defs/Money",
      "description": "Total uses: entry enterprise value plus transaction fees."
    }
  },
  "required": [
    "entry_enterprise_value",
    "entry_metric",
    "debt_total",
    "equity_check",
    "sources_total",
    "uses_total",
    "sources_uses_balanced",
    "exit_enterprise_value",
    "exit_metric",
    "exit_net_debt",
    "exit_equity_proceeds",
    "moic"
  ],
  "title": "LboResult",
  "type": "object"
}
