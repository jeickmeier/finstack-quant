{
  "$id": "https://finstack_quant.dev/schemas/statements_analytics/1/dependency_tree.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hierarchical dependency tree structure.",
  "properties": {
    "children": {
      "description": "Child dependencies",
      "items": {
        "$ref": "#"
      },
      "type": "array"
    },
    "formula": {
      "description": "Formula text (if node is calculated)",
      "type": [
        "string",
        "null"
      ]
    },
    "node_id": {
      "description": "Node identifier",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "children"
  ],
  "title": "DependencyTree",
  "type": "object"
}
