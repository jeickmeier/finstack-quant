{
  "$id": "https://finstack_quant.dev/schemas/cashflow/1/recovery_model_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cashflow recovery-model specification.",
  "examples": [
    {
      "rate": 0.4,
      "recovery_lag": 3
    }
  ],
  "properties": {
    "rate": {
      "description": "Recovery rate as fraction (0.0 to 1.0, e.g., 0.40 for 40%)",
      "format": "double",
      "type": "number"
    },
    "recovery_lag": {
      "description": "Recovery lag in months",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "severity_vector": {
      "description": "Loss severity (`1 − recovery`) by month of default as decimals in\n`[0, 1]`, month 1 first; the last value is held. When present it\nreplaces `rate` for defaults in that month.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "rate",
    "recovery_lag"
  ],
  "title": "RecoveryModelSpec",
  "type": "object"
}
