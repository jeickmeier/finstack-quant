    { "type": "fixed", "name": "Christmas Day", "month": "december", "day": 25, "observed": "fri_if_sat_mon_if_sun" },
    { "type": "nth_weekday", "name": "Martin Luther King Jr. Day", "n": 3, "weekday": "monday", "month": "january", "from_year": 1998 },
    { "type": "nth_weekday", "name": "Washington's Birthday", "n": 3, "weekday": "monday", "month": "february" },
