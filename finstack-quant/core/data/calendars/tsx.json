{
  "id": "tsx",
  "name": "Toronto Stock Exchange (TSX) Holiday Calendar",
  "ignore_weekends": false,
  "comment": "TSX trading calendar excludes Remembrance Day and National Day for Truth and Reconciliation. Victoria Day is Monday on or before May 24. Christmas and Boxing Day have distinct substitute dates. Family Day applies from 2008. Published annual fixture: 2026. <https://www.tsx.com/en/trading/calendars-and-trading-hours/calendar>",
  "rules": [
    { "type": "fixed", "name": "New Year's Day", "month": "january", "day": 1, "observed": "next_monday" },
    { "type": "fixed", "name": "Canada Day", "month": "july", "day": 1, "observed": "next_monday" },
    { "type": "fixed", "name": "Christmas Day", "month": "december", "day": 25, "observed": "mon_if_sat_tue_if_sun" },
    { "type": "fixed", "name": "Boxing Day", "month": "december", "day": 26, "observed": "mon_if_sat_tue_if_sun" },
    { "type": "nth_weekday", "name": "Family Day", "n": 3, "weekday": "monday", "month": "february", "from_year": 2008 },
    { "type": "easter_offset", "name": "Good Friday", "days": -3 },
    { "type": "weekday_shift", "name": "Victoria Day", "weekday": "monday", "month": "may", "day": 24, "dir": "before" },
    { "type": "nth_weekday", "name": "Civic Holiday", "n": 1, "weekday": "monday", "month": "august" },
    { "type": "nth_weekday", "name": "Labour Day", "n": 1, "weekday": "monday", "month": "september" },
    { "type": "nth_weekday", "name": "Thanksgiving", "n": 2, "weekday": "monday", "month": "october" }
  ]
}
