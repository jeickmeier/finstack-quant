{
  "$defs": {
    "RatingLevel": {
      "additionalProperties": false,
      "description": "Rating level for credit rating scales.",
      "properties": {
        "min_score": {
          "description": "Minimum score threshold for this rating.",
          "format": "double",
          "type": "number"
        },
        "name": {
          "description": "Rating name, for example `AAA` or `Aaa`.",
          "type": "string"
        },
        "score": {
          "description": "Numeric score on a 0-100 scale.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "score",
        "min_score"
      ],
      "type": "object"
    }
  },
