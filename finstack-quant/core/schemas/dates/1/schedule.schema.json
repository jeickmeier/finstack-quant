{
  "$defs": {
    "DateWire": {
      "description": "ISO 8601 calendar date encoded as a `YYYY-MM-DD` JSON string.",
      "format": "date",
      "type": "string"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/dates/1/schedule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated accrual, payment and fixing dates with any construction warnings.",
  "examples": [
    {
      "dates": [
        "2025-01-15",
        "2025-02-15",
        "2025-03-15",
        "2025-04-15",
        "2025-05-15",
        "2025-06-15",
        "2025-07-15",
        "2025-08-15",
        "2025-09-15",
        "2025-10-15",
        "2025-11-15",
        "2025-12-15",
        "2026-01-15"
      ],
      "fixing_dates": [],
      "payment_dates": [
        "2025-02-15",
        "2025-03-15",
        "2025-04-15",
        "2025-05-15",
        "2025-06-15",
        "2025-07-15",
        "2025-08-15",
        "2025-09-15",
        "2025-10-15",
        "2025-11-15",
        "2025-12-15",
        "2026-01-15"
      ]
    }
  ],
  "properties": {
    "dates": {
      "description": "Unadjusted accrual grid (period start plus each period end).",
      "items": {
        "$ref": "#/$defs/DateWire"
      },
      "type": "array"
    },
    "fixing_dates": {
      "description": "Fixing date for each accrual period, or empty when no fixing lag is\nconfigured.",
      "items": {
        "$ref": "#/$defs/DateWire"
      },
      "type": "array"
    },
    "payment_dates": {
      "description": "Payment date for each accrual period (one per period end).",
      "items": {
        "$ref": "#/$defs/DateWire"
      },
      "type": "array"
    }
  },
  "required": [
    "dates",
    "payment_dates",
    "fixing_dates"
  ],
  "title": "Schedule",
  "type": "object"
}
