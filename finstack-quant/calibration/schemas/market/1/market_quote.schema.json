          "properties": {
            "contract": {
              "$ref": "#/$defs/IrFutureContractId",
              "description": "Future contract identifier (e.g. \"CME:SR3\")."
            },
            "convexity_adjustment": {
              "description": "Convexity adjustment as a decimal rate (Hull convention).\n\nThe implied forward is\n`forward = (100 - price) / 100 − convexity_adjustment`.\nA positive adjustment lowers the futures-implied rate toward the true\nforward. Callers that want no adjustment must pass `0.0` explicitly.",
              "format": "double",
              "type": "number"
            },
            "expiry": {
              "$ref": "https://finstack_quant.dev/schemas/common/1/date.schema.json",
              "description": "Last trading date of the future.\n\nThe convention registry derives the underlying reference period from\nthis date. For in-arrears IMM contracts such as `CME:SR3`, pass the\nbusiness day before the ending IMM Wednesday, not the named contract\nmonth's starting IMM date."
            },
            "id": {
              "$ref": "#/$defs/QuoteId",
              "description": "Unique identifier for the quote."
            },
            "price": {
