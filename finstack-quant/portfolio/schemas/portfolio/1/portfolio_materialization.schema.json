{
  "$defs": {
    "AttributeValue": {
      "anyOf": [
        {
          "description": "Categorical / string attribute (e.g., rating = \"CCC\", sector = \"Energy\").",
          "type": "string"
        },
        {
          "description": "Numeric attribute (e.g., credit_score = 650.0, esg_score = 72.5).",
          "format": "double",
          "type": "number"
        }
      ],
      "description": "Value stored in a position or candidate attribute.\n\nPositions carry key/value attributes for grouping, filtering, and\noptimization constraints.  Text values represent categorical data\n(rating, sector), while numeric values represent continuous data\n(credit score, ESG score) usable in metric expressions."
    },
    "Book": {
      "additionalProperties": false,
      "description": "A book represents a folder-like organizational unit within a portfolio.\n\nBooks can contain positions and/or child books, forming a hierarchical tree.\nThis allows multi-level aggregation (e.g., Americas > Credit > Investment Grade).\n\n# Design\n\n- Flat position list is default; books are optional\n- Parent-child relationships tracked via `parent_id` field\n- Positions reference books via optional `book_id` field\n- Positions without `book_id` are not in any book\n- Book hierarchies are expected to be acyclic trees or forests; aggregation\n  helpers reject cycles and excessively deep nesting instead of recursing\n  indefinitely\n- [`Book::child_book_ids`] drives rollup in [`crate::grouping::aggregate_by_book`];\n  [`crate::portfolio::Portfolio::validate`] checks parent/child consistency\n  between child lists and [`Book::parent_id`]",
      "properties": {
        "child_book_ids": {
          "description": "Child book IDs (for hierarchical organization)",
          "items": {
            "$ref": "#/$defs/BookId"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/BookId",
          "description": "Unique identifier for this book"
        },
        "meta": {
          "additionalProperties": true,
          "description": "Additional metadata",
          "type": "object"
        },
        "name": {
          "description": "Human-readable name",
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parent book identifier (None for root books)"
        },
        "position_ids": {
          "description": "Position IDs directly assigned to this book (non-recursive)",
          "items": {
            "$ref": "#/$defs/PositionId"
          },
          "type": "array"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Book-level tags for grouping and filtering",
          "type": "object"
        }
      },
      "required": [
        "id",
        "position_ids",
        "child_book_ids"
      ],
      "type": "object"
    },
    "BookId": {
      "description": "Book identifier.",
      "type": "string"
    },
