{
  "$defs": {
    "NonFiniteF64Wire": {
      "anyOf": [
        {
          "description": "A finite value, written as a JSON number.",
          "format": "double",
          "type": "number"
        },
        {
          "$ref": "#/$defs/NonFiniteSentinel",
          "description": "A non-finite value, written as its sentinel string."
        }
      ],
      "description": "An `f64` in the [`non_finite_f64`] wire form: a JSON number when finite,\notherwise one of the strings `\"inf\"`, `\"-inf\"` or `\"nan\"`.\n\nContract types store plain `f64` fields with\n`#[serde(with = \"finstack_quant_core::wire::non_finite_f64\")]` and name this\ntype in `#[schemars(with = ...)]`, so the generated schema describes the\nsentinel strings the serializer actually writes."
    },
    "NonFiniteSentinel": {
      "description": "Sentinel string the [`non_finite_f64`] adapter writes for a non-finite `f64`.",
      "oneOf": [
        {
          "const": "inf",
          "description": "`+∞`, written as `\"inf\"`.",
          "type": "string"
        },
        {
          "const": "-inf",
          "description": "`-∞`, written as `\"-inf\"`.",
          "type": "string"
        },
        {
          "const": "nan",
          "description": "`NaN`, written as `\"nan\"`.",
          "type": "string"
        }
      ]
    },
    "OptimizationStatus": {
      "description": "Status of an optimization run.",
      "oneOf": [
        {
          "const": "optimal",
          "description": "Found optimal solution.",
          "type": "string"
        },
        {
          "const": "feasible_but_suboptimal",
          "description": "Found feasible solution but solver stopped early.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "No feasible solution exists.",
          "properties": {
            "infeasible": {
              "properties": {
                "conflicting_constraints": {
                  "description": "Constraints that appear to conflict (if determinable).",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "conflicting_constraints"
              ],
              "type": "object"
            }
          },
          "required": [
            "infeasible"
          ],
          "type": "object"
        },
        {
          "const": "unbounded",
          "description": "Objective is unbounded.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Solver error.",
          "properties": {
            "error": {
              "properties": {
                "message": {
                  "description": "Error message describing what went wrong.",
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "PositionId": {
      "description": "Position identifier.",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Numeric schema revision for contracts whose sole supported revision is v1.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "TradeDirection": {
      "description": "Direction of a trade.",
      "oneOf": [
        {
          "const": "buy",
          "description": "Increase the signed instrument quantity, including covering a short.",
          "type": "string"
        },
        {
          "const": "sell",
          "description": "Decrease the signed instrument quantity, including increasing a short.",
          "type": "string"
        },
        {
          "const": "hold",
          "description": "No change in instrument quantity.",
          "type": "string"
        }
      ]
    },
    "TradeSpec": {
      "additionalProperties": false,
      "description": "Trade specification for a single position.",
      "properties": {
        "current_quantity": {
          "description": "Pre‑trade quantity.",
          "format": "double",
          "type": "number"
        },
        "current_weight": {
          "description": "Pre‑trade weight.",
          "format": "double",
          "type": "number"
        },
        "delta_quantity": {
          "description": "Quantity change (`target - current`).",
          "format": "double",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/TradeDirection",
          "description": "Buy / Sell / Hold classification from the sign of `delta_quantity`."
        },
        "instrument_id": {
          "description": "Underlying instrument identifier (or candidate id).",
          "type": "string"
        },
        "position_id": {
          "$ref": "#/$defs/PositionId",
          "description": "Position identifier in the optimized portfolio."
        },
        "target_quantity": {
          "description": "Post‑trade quantity.",
          "format": "double",
          "type": "number"
        },
        "target_weight": {
          "description": "Post‑trade weight.",
          "format": "double",
          "type": "number"
        },
        "trade_type": {
          "$ref": "#/$defs/TradeType",
          "description": "Trade type (existing, new position, close‑out)."
        }
      },
      "required": [
        "position_id",
        "instrument_id",
        "trade_type",
        "current_quantity",
        "target_quantity",
        "delta_quantity",
        "direction",
        "current_weight",
        "target_weight"
      ],
      "type": "object"
    },
    "TradeType": {
      "description": "Whether a trade is for an existing position or a new candidate.",
      "oneOf": [
        {
          "const": "existing",
          "description": "Adjusting an existing portfolio position.",
          "type": "string"
        },
        {
          "const": "new_position",
          "description": "Adding a new position from the candidate universe.",
          "type": "string"
        },
        {
          "const": "close_out",
          "description": "Closing out an existing position entirely.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://finstack_quant.dev/schemas/portfolio/1/portfolio_optimization_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical typed v1 output from portfolio optimization.",
  "examples": [
    {
      "binding_constraints": [],
      "constraint_slacks": {
        "max_weight": 0.4
      },
      "current_weights": {
        "POS_001": 0.55
      },
      "implied_quantities": {
        "POS_001": 600000.0
      },
      "is_feasible": true,
      "metric_values": {
        "expected_return": 0.0425
      },
      "objective_value": 0.0425,
      "optimal_weights": {
        "POS_001": 0.6
      },
      "schema_version": 1,
      "status": "optimal",
      "status_label": "optimal",
      "trades": [
        {
          "current_quantity": 550000.0,
          "current_weight": 0.55,
          "delta_quantity": 50000.0,
          "direction": "buy",
          "instrument_id": "DEP_1M",
          "position_id": "POS_001",
          "target_quantity": 600000.0,
          "target_weight": 0.6,
          "trade_type": "existing"
        }
      ],
      "turnover": 0.05,
      "weight_deltas": {
        "POS_001": 0.05
      }
    }
  ],
  "properties": {
    "binding_constraints": {
      "description": "Approximately binding constraint names.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "constraint_slacks": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Constraint slack values.",
      "type": "object"
    },
    "current_weights": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Current weights keyed by position.",
      "type": "object"
    },
    "implied_quantities": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Implied target quantities keyed by position.",
      "type": "object"
    },
    "is_feasible": {
      "description": "Whether the solution can be consumed.",
      "type": "boolean"
    },
    "label": {
      "description": "Optional user-supplied problem label.",
      "type": [
        "string",
        "null"
      ]
    },
    "metric_values": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Evaluated metrics.",
      "type": "object"
    },
    "objective_value": {
      "$ref": "#/$defs/NonFiniteF64Wire",
      "description": "Objective value at the solution.\n\n`NaN` when the solve is not feasible; non-finite values travel as the\nstring sentinels `\"nan\"`, `\"inf\"` and `\"-inf\"` so the result round-trips."
    },
    "optimal_weights": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Optimal weights keyed by position.",
      "type": "object"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "description": "Required numeric v1 marker."
    },
    "status": {
      "$ref": "#/$defs/OptimizationStatus",
      "description": "Solver outcome."
    },
    "status_label": {
      "description": "Stable snake-case status label.",
      "type": "string"
    },
    "trades": {
      "description": "Executable trade list.",
      "items": {
        "$ref": "#/$defs/TradeSpec"
      },
      "type": "array"
    },
    "turnover": {
      "$ref": "#/$defs/NonFiniteF64Wire",
      "description": "Gross turnover.\n\n`NaN` when the solve is not feasible; encoded like `objective_value`."
    },
    "weight_deltas": {
      "additionalProperties": {
        "format": "double",
        "type": "number"
      },
      "description": "Weight changes keyed by position.",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "status_label",
    "is_feasible",
    "objective_value",
    "turnover",
    "optimal_weights",
    "current_weights",
    "weight_deltas",
    "implied_quantities",
    "metric_values",
    "trades",
    "constraint_slacks",
    "binding_constraints"
  ],
  "title": "Portfolio Optimization Result",
  "type": "object"
}
