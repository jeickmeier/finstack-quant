  "properties": {
    "benchmark_return_compounded": {
      "description": "Geometrically compounded benchmark return.",
      "format": "double",
      "type": "number"
    },
    "linked_allocation": {
      "description": "Sum of per-sector linked allocation effects.",
      "format": "double",
      "type": "number"
    },
    "linked_interaction": {
      "description": "Sum of per-sector linked interaction effects.",
      "format": "double",
      "type": "number"
    },
    "linked_sectors": {
      "description": "Per-sector Carino-smoothed effects summed across periods.\n`sum(linked_allocation + linked_selection + linked_interaction)`\nreconstructs the active compounded return exactly.",
      "items": {
        "$ref": "#/$defs/SectorEffect"
      },
      "type": "array"
    },
    "linked_selection": {
      "description": "Sum of per-sector linked selection effects.",
      "format": "double",
      "type": "number"
    },
    "periods": {
      "description": "Per-period decompositions in chronological order.",
      "items": {
        "$ref": "#/$defs/BrinsonPeriodResult"
      },
      "type": "array"
    },
    "portfolio_return_compounded": {
      "description": "Geometrically compounded portfolio return,\n`∏_t (1 + r_p,t) − 1`.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "periods",
    "portfolio_return_compounded",
    "benchmark_return_compounded",
    "linked_sectors",
    "linked_allocation",
    "linked_selection",
    "linked_interaction"
  ],
  "title": "CarinoLinkedAttribution",
  "type": "object"
}
