{
  "$defs": {
    "AggregatedMetric": {
      "description": "Aggregated metric across the portfolio.\n\nContains portfolio-wide totals as well as breakdowns by entity.\n\n# Additive versus non-additive metrics\n\nSumming currency-denominated rate and credit sensitivities across\npositions is standard desk practice: `dv01`, `cs01`, `pv01` and their\nbucketed series all measure a change per basis point of the *same* kind of\nrisk factor, and their sum is a portfolio-level number a risk manager can\nhedge with (Tuckman & Serrat, *Fixed Income Securities*). `fx_delta` and\n`index_delta` are likewise currency-denominated and linear in size.\n\nUnqualified scalar Greeks (`delta`, `gamma`, `vega`, `vanna`, `volga`)\nare not additive because their risk factors may differ across positions.\nPortfolio totals require qualified keys such as `delta::<underlying>` or\n`bucketed_vega::<surface>::<expiry>::<strike>`.\nInstrument-specific measures such as yield and duration remain in\n[`PortfolioMetrics::by_position`] and are listed on\n[`PortfolioMetrics::unaggregated_metrics`].",
      "properties": {
        "by_entity": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Aggregated values by entity",
          "type": "object"
        },
        "metric_id": {
          "description": "Metric identifier",
          "type": "string"
        },
        "total": {
          "description": "Total value across all positions (for summable metrics)",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "total",
        "by_entity"
      ],
      "type": "object"
    },
