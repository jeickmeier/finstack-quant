    "DateWire": {
      "description": "ISO 8601 calendar date encoded as a `YYYY-MM-DD` JSON string.",
      "format": "date",
      "type": "string"
    },
    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
      "type": "string"
    },
    "EntityId": {
      "description": "Entity identifier (company, fund, etc.)",
      "type": "string"
    },
    "FxConversionPolicy": {
      "description": "Standard FX conversion strategies used to hint FX providers.\n\nThe policy tells a provider *how* the rate will be applied so it can decide\nbetween spot, forward, or averaged sources.",
      "oneOf": [
        {
          "const": "cashflow_date",
          "description": "Use spot/forward on the cashflow date.",
          "type": "string"
        },
        {
          "const": "period_end",
          "description": "Use period end date.",
          "type": "string"
        },
        {
          "const": "period_average",
          "description": "Use an average over the period.",
          "type": "string"
        }
      ]
    },
    "MetricId": {
      "description": "Strongly-typed metric identifier.\n\nProvides compile-time validation, autocomplete support, and safe refactoring\nwhen metric names change. Covers bond, IRS, deposit, and risk metrics.\n\nSee unit tests and `examples/` for usage.",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "PortfolioMetrics": {
      "description": "Complete portfolio metrics results.\n\nHolds both aggregated metrics and per-position values returned\nby `aggregate_metrics`.\n\n# Completeness of the aggregated totals\n\nA total in [`aggregated`](Self::aggregated) is not necessarily a sum over\nevery position in the portfolio. Three fields make each omission visible,\nand consumers that report totals should surface all three:\n\n- [`degraded_positions`](Self::degraded_positions) — positions that fell\n  back to a PV-only valuation, so they carry **no** risk measures and\n  contribute zero to every total.\n- [`skipped_metrics`](Self::skipped_metrics) — individual non-finite\n  values excluded from a total.\n- [`unaggregated_metrics`](Self::unaggregated_metrics) — metrics that\n  exist per position but are not portfolio-summable, so they have no\n  total at all.\n\nA metric narrowed away because a position's instrument type has no\ncalculator for it is *not* one of these omissions: the model gives that\ninstrument type no such exposure, so the total is complete without it. Such\nnarrowing is reported per position on\n[`PositionValue::inapplicable_metrics`](crate::valuation::PositionValue::inapplicable_metrics).",
      "properties": {
        "aggregated": {
          "additionalProperties": {
            "$ref": "#/$defs/AggregatedMetric"
          },
          "description": "Aggregated metrics (summable only)",
          "type": "object"
        },
        "by_position": {
          "additionalProperties": {
            "$ref": "#/$defs/PositionMetrics"
          },
          "description": "Raw metrics by position (all metrics), with explicit native currency context.",
          "type": "object"
        },
        "degraded_positions": {
          "description": "Positions that carried no risk measures at all because their valuation\nfell back to PV-only.\n\nMirrored from\n[`PortfolioValuation::degraded_positions`](crate::valuation::PortfolioValuation::degraded_positions)\n(positions with `risk_metrics_complete == false`). Such positions\ncontribute zero to every total without producing a\n[`SkippedMetric`] entry — that field only records non-finite values —\nso this list is the only signal that the aggregate is partial.",
          "items": {
            "$ref": "#/$defs/PositionId"
          },
          "type": "array"
        },
        "skipped_metrics": {
          "description": "Positions whose non-finite metric values were excluded from aggregation.\n\nEach entry records the position and metric that was skipped, allowing\ncallers to detect incomplete aggregation (analogous to\n[`crate::valuation::PortfolioValuation::degraded_positions`]).",
          "items": {
            "$ref": "#/$defs/SkippedMetric"
          },
          "type": "array"
        },
        "unaggregated_metrics": {
          "description": "Metric identifiers present in [`by_position`](Self::by_position) that\nwere not aggregated into a portfolio total because they are not\nsummable across positions (for example `ytm`, `duration`, or any\nmetric outside the additive allowlist).\n\nSorted and de-duplicated. The per-position values remain available in\n`by_position` in their native currency.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "aggregated",
        "by_position"
      ],
      "type": "object"
    },
    "PortfolioValuation": {
      "description": "Complete portfolio valuation results.\n\nProvides per-position valuations, totals by entity, and the grand total.",
      "properties": {
        "as_of": {
          "$ref": "#/$defs/DateWire",
          "description": "Valuation date carried through from the portfolio."
        },
        "by_entity": {
          "additionalProperties": {
            "$ref": "#/$defs/Money"
          },
          "description": "Aggregated values by entity",
          "type": "object"
        },
        "degraded_positions": {
          "description": "Positions whose valuation fell back to PV-only because requested risk\nmetrics could not be computed.",
          "items": {
            "$ref": "#/$defs/PositionId"
          },
          "type": "array"
        },
        "fx_collapse_policy": {
          "$ref": "#/$defs/FxConversionPolicy",
          "default": "cashflow_date",
          "description": "FX policy applied when collapsing position values to the base currency.\n\nBase-currency rollups use an explicit spot-equivalent conversion at\n[`as_of`](Self::as_of) through the market FX matrix; this records the\napplied [`FxConversionPolicy`] so the result envelope satisfies the\npolicy-visibility invariant (the FX strategy is stamped, not implied)."
        },
        "position_values": {
          "additionalProperties": {
            "$ref": "#/$defs/PositionValue"
          },
          "description": "Values for each position",
          "type": "object"
        },
        "total_base_currency": {
          "$ref": "#/$defs/Money",
          "description": "Total portfolio value in base currency"
        }
      },
      "required": [
        "as_of",
        "position_values",
        "total_base_currency",
        "by_entity"
      ],
      "type": "object"
    },
    "PositionId": {
      "description": "Position identifier.",
      "type": "string"
    },
    "PositionMetrics": {
      "description": "Position-level metrics with explicit native currency context.",
      "properties": {
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "Native currency for this position's valuation and non-summable metrics."
        },
        "metrics": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Raw metric values for the position.",
          "type": "object"
        }
      },
      "required": [
        "currency",
        "metrics"
      ],
      "type": "object"
    },
    "PositionValue": {
      "description": "Result of valuing a single position.\n\nHolds both native-currency and base-currency valuations along with\nthe underlying [`ValuationResult`].",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/EntityId",
          "description": "Entity that owns this position"
        },
        "inapplicable_metrics": {
          "description": "Metrics on the portfolio menu that this position's instrument type has\nno calculator for, and which were therefore never requested of it.\n\nA portfolio metric list is a menu offered to a heterogeneous book (see\n[`RequestedMetrics`]), so this records the per-position narrowing that\nmakes such a list usable. It is not a failure report: unlike\n[`PortfolioValuation::degraded_positions`] and\n[`PortfolioMetrics::skipped_metrics`](crate::metrics::PortfolioMetrics::skipped_metrics),\nnothing here could have been computed and was not. An entry means the\nmodel gives this instrument type no such exposure, so the position\ncontributes nothing to that metric's portfolio total by construction.\n\nListed in menu order. Empty for a position that supports the whole menu.",
          "items": {
            "$ref": "#/$defs/MetricId"
          },
          "type": "array"
        },
        "metric_scale": {
          "description": "Linear scaling factor to apply to summable risk measures.\n\nThis mirrors the economic position size and sign used for PV scaling,\nbut is kept separate so non-summable metrics such as YTM remain\nunscaled at the position drill-down level.",
          "format": "double",
          "type": "number"
        },
        "position_id": {
          "$ref": "#/$defs/PositionId",
          "description": "Position identifier"
        },
        "risk_error": {
          "description": "Original metrics failure message when the valuation fell back to PV-only.",
          "type": [
            "string",
            "null"
          ]
        },
        "risk_metrics_complete": {
          "description": "Whether every risk metric requested *of this position* was computed\nsuccessfully.\n\nThe requested set is the portfolio metric menu narrowed to what this\nposition's instrument type supports, so structural narrowing does not\nclear this flag; the narrowed-away entries are listed on\n[`inapplicable_metrics`](Self::inapplicable_metrics). `false` means a\nsupported metric failed to compute and the position fell back to\nPV-only.",
          "type": "boolean"
        },
        "valuation_result": {
          "anyOf": [
            {
              "$ref": "https://finstack_quant.dev/schemas/results/1/valuation_result.schema.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full valuation result with metrics (including computed risk measures)."
        },
        "value_base": {
          "$ref": "#/$defs/Money",
          "description": "Value converted to portfolio base currency"
        },
        "value_native": {
          "$ref": "#/$defs/Money",
          "description": "Value in the instrument's native currency"
        }
      },
      "required": [
        "position_id",
        "entity_id",
        "value_native",
        "value_base",
        "metric_scale",
        "risk_metrics_complete"
      ],
      "type": "object"
    },
    "PositiveF64Wire": {
      "description": "Finite JSON number that is strictly greater than zero.\n\nThis type is used by serde field adapters so runtime deserialization and\ngenerated schemas enforce the same positive-number contract.",
      "exclusiveMinimum": 0.0,
      "format": "double",
      "type": "number"
    },
    "ResultsMeta": {
      "description": "Metadata bundle that accompanies valuation outputs.\n\nThe metadata is intentionally small so it can be attached to reports and\ndownstream data stores for reproducibility and audit trails.\n\n# Examples\n```rust\nuse finstack_quant_core::config::{results_meta, FinstackConfig, NUMERIC_MODE_F64};\n\nlet meta = results_meta(&FinstackConfig::default());\nassert_eq!(meta.numeric_mode, NUMERIC_MODE_F64);\nassert!(meta.timestamp.is_none()); // deterministic by default\n```",
      "properties": {
        "fx_policy_applied": {
          "default": null,
          "description": "Optional FX policy applied by the computing layer (human-readable key).",
          "type": [
            "string",
            "null"
          ]
        },
        "numeric_mode": {
          "description": "Numeric engine mode used to produce the results.\n\nAlways [`NUMERIC_MODE_F64`] today; a plain string so result\nenvelopes stay wire-compatible across host languages.",
          "type": "string"
        },
        "parallel": {
          "description": "Whether the producing computation ran in parallel.\n\nSerial results omit the field entirely so existing payloads and golden\nfiles stay byte-identical.",
          "type": "boolean"
        },
        "rounding": {
          "$ref": "#/$defs/RoundingContext",
          "description": "Rounding context snapshot applied to IO boundaries."
        },
        "timestamp": {
          "description": "Timestamp when result was computed (ISO 8601 format).\nUseful for audit trails and reproducibility.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Finstack Quant library version used to produce the result.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "numeric_mode",
        "rounding"
      ],
      "type": "object"
    },
    "RoundingContext": {
      "description": "Snapshot of active rounding settings used for result stamping.\n\nInstances are typically produced via [`rounding_context_from`] and persisted\nalongside valuation results.",
      "properties": {
        "ingest_scale_by_currency": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Ingest scale map snapshot by currency code.",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/RoundingMode",
          "description": "Active rounding mode."
        },
        "output_scale_by_currency": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Output scale map snapshot by currency code.",
          "type": "object"
        },
        "tolerances": {
          "$ref": "#/$defs/ToleranceConfig",
          "default": {
            "generic_epsilon": 1e-10,
            "rate_epsilon": 1e-12
          },
          "description": "Tolerance settings snapshot for floating-point comparisons."
        },
        "version": {
          "description": "Schema version for forward compatibility.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "ingest_scale_by_currency",
        "output_scale_by_currency",
        "version"
      ],
      "type": "object"
    },
    "RoundingMode": {
      "description": "Rounding modes supported by the library.\n\nThe variants mirror the most common conventions found in pricing engines.\n\n# Examples\n```rust\nuse finstack_quant_core::config::{FinstackConfig, RoundingMode};\n\nlet mut cfg = FinstackConfig::default();\ncfg.rounding.mode = RoundingMode::TowardZero;\nassert!(matches!(cfg.rounding.mode, RoundingMode::TowardZero));\n```",
      "oneOf": [
        {
          "const": "bankers",
          "description": "Banker's rounding (ties to even).",
          "type": "string"
        },
        {
          "const": "away_from_zero",
          "description": "Round halves away from zero.",
          "type": "string"
        },
        {
          "const": "toward_zero",
          "description": "Round toward zero (truncate).",
          "type": "string"
        },
        {
          "const": "floor",
          "description": "Round toward negative infinity.",
          "type": "string"
        },
        {
          "const": "ceil",
          "description": "Round toward positive infinity.",
          "type": "string"
        }
      ]
    },
    "SchemaVersion": {
      "description": "Numeric schema revision for contracts whose sole supported revision is v1.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "SkippedMetric": {
      "description": "A metric value that was excluded from portfolio aggregation because it was\nnon-finite (NaN or ±Inf).",
      "properties": {
        "metric_id": {
          "description": "Metric identifier that was skipped.",
          "type": "string"
        },
        "position_id": {
          "$ref": "#/$defs/PositionId",
          "description": "Position that produced the non-finite value."
        },
        "value": {
          "description": "The non-finite value that was encountered.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "position_id",
        "metric_id",
        "value"
      ],
      "type": "object"
    },
    "ToleranceConfig": {
      "additionalProperties": false,
      "description": "Numerical tolerance configuration for floating-point comparisons.\n\nProvides configurable epsilon values for zero-checks in rate calculations\nand generic floating-point comparisons. These defaults are chosen to balance\nnumerical stability with practical precision requirements.\n\n# Examples\n```rust\nuse finstack_quant_core::config::ToleranceConfig;\n\nlet mut tol = ToleranceConfig::default();\nassert_eq!(tol.rate_epsilon, 1e-12);\n\n// Customize for stricter rate comparisons\ntol.rate_epsilon = 1e-14;\n```",
      "properties": {
        "generic_epsilon": {
          "$ref": "#/$defs/PositiveF64Wire",
          "default": 1e-10,
          "description": "Epsilon for generic floating-point comparisons (default: 1e-10).\n\nUsed for general numerical comparisons where higher tolerance is acceptable."
        },
        "rate_epsilon": {
          "$ref": "#/$defs/PositiveF64Wire",
          "default": 1e-12,
          "description": "Epsilon for rate comparisons (default: 1e-12).\n\nUsed when comparing interest rates, yields, and other small ratios."
        }
      },
      "type": "object"
    }
  },
  "$id": "https://finstack_quant.dev/schemas/portfolio/1/portfolio_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Complete results from portfolio evaluation.",
  "examples": [
    {
      "meta": {
        "fx_policy_applied": null,
        "numeric_mode": "f64",
        "rounding": {
          "ingest_scale_by_currency": {},
          "mode": "bankers",
          "output_scale_by_currency": {},
          "tolerances": {
            "generic_epsilon": 1e-10,
            "rate_epsilon": 1e-12
          },
          "version": 1
        },
        "version": "0.9.0"
      },
      "metrics": {
        "aggregated": {
          "dv01": {
            "by_entity": {
              "ACME_CORP": -8.5
            },
            "metric_id": "dv01",
            "total": -8.5
          }
        },
        "by_position": {
          "POS_001": {
            "currency": "USD",
            "metrics": {
              "dv01": -8.5
            }
          }
        }
      },
      "schema_version": 1,
      "valuation": {
        "as_of": "2024-01-01",
        "by_entity": {
          "ACME_CORP": {
            "amount": "1000125.50",
            "currency": "USD"
          }
        },
        "fx_collapse_policy": "cashflow_date",
        "position_values": {
          "POS_001": {
            "entity_id": "ACME_CORP",
            "metric_scale": 1.0,
            "position_id": "POS_001",
            "risk_metrics_complete": true,
            "value_base": {
              "amount": "1000125.50",
              "currency": "USD"
            },
            "value_native": {
              "amount": "1000125.50",
              "currency": "USD"
            }
          }
        },
        "total_base_currency": {
          "amount": "1000125.50",
          "currency": "USD"
        }
      }
    }
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/ResultsMeta",
      "description": "Metadata about the calculation"
    },
    "metrics": {
      "$ref": "#/$defs/PortfolioMetrics",
      "description": "Aggregated metrics"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "description": "Required wire-format schema version. Only numeric `1` is accepted."
    },
    "valuation": {
      "$ref": "#/$defs/PortfolioValuation",
      "description": "Portfolio valuation results"
    }
  },
  "required": [
    "schema_version",
    "valuation",
    "metrics",
    "meta"
  ],
  "title": "PortfolioResult",
  "type": "object"
}
