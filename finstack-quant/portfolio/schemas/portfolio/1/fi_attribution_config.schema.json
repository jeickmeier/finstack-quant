{
  "$id": "https://finstack_quant.dev/schemas/portfolio/1/fi_attribution_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Configuration for `campisi_attribution`.",
  "examples": [
    {
      "period_years": 0.0833333333333
    }
  ],
  "properties": {
