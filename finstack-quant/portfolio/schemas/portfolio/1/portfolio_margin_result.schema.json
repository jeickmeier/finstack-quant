    "DateWire": {
      "description": "ISO 8601 calendar date encoded as a `YYYY-MM-DD` JSON string.",
      "format": "date",
      "type": "string"
    },
    "DecimalWire": {
      "description": "Exact decimal encoded only as a JSON string.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$",
      "type": "string"
    },
    "DegradedPosition": {
      "properties": {
        "message": {
          "type": "string"
        },
        "position_id": {
          "type": "string"
        }
      },
      "required": [
        "position_id",
        "message"
      ],
      "type": "object"
    },
    "ImCollateralResult": {
      "additionalProperties": false,
      "description": "One-way IM collateral account after applying the CSA's allocated threshold.\n\nIM remains separate from VM. Segregation determines the custody requirement;\nit does not discount gross model risk or allow the account to offset VM.",
      "properties": {
        "current_collateral": {
          "$ref": "#/$defs/Money",
          "description": "Existing nonnegative collateral balance in this one-way IM account."
        },
        "gross_initial_margin": {
          "$ref": "#/$defs/Money",
          "description": "Gross model IM after MPOR adjustment, before contractual thresholds."
        },
        "required_collateral": {
          "$ref": "#/$defs/Money",
          "description": "Target collateral balance, max(gross IM minus allocated CSA threshold, 0)."
        },
        "segregated": {
          "description": "True requires separate custody with no reuse to satisfy VM obligations.",
          "type": "boolean"
        },
        "transfer": {
          "$ref": "#/$defs/Money",
          "description": "Signed transfer: positive posts additional IM, negative returns excess.\nAbsolute transfers strictly below MTA are zero; equality triggers transfer."
        }
      },
      "required": [
        "gross_initial_margin",
        "required_collateral",
        "current_collateral",
        "transfer",
        "segregated"
      ],
      "type": "object"
    },
    "ImMethodology": {
      "description": "Initial margin calculation methodology.\n\nDifferent methodologies are used depending on regulatory requirements,\nproduct type, and whether trades are cleared or bilateral.\n\n# BCBS-IOSCO Standards\n\nFor bilateral (uncleared) OTC derivatives, either SIMM or the regulatory\nschedule approach may be used. SIMM is the industry standard for large\ndealers due to its risk-sensitivity.",
      "oneOf": [
        {
          "const": "haircut",
          "description": "Haircut-based IM calculation (standard for repos and securities financing)\n\nIM = Collateral_Value × Haircut\n\nHaircuts are determined by asset class, rating, maturity, and FX mismatch.",
          "type": "string"
        },
        {
          "const": "simm",
          "description": "ISDA Standard Initial Margin Model (SIMM)\n\nSensitivities-based model calculating IM from delta, vega, and curvature\nrisk across interest rate, credit, equity, commodity, and FX risk classes.\n\nReference: ISDA SIMM Methodology v2.6 (2023)",
          "type": "string"
        },
        {
          "const": "schedule",
          "description": "BCBS-IOSCO regulatory schedule approach\n\nGrid-based IM calculation using notional × rate based on asset class and maturity.\nSimpler but typically more conservative than SIMM.\n\nExample rates:\n- Interest Rate: 0-2yr: 1%, 2-5yr: 2%, 5+yr: 4%\n- Credit: 2-5yr: 5%, 5+yr: 10%\n- Equity: 15%\n- FX: 6%",
          "type": "string"
        },
        {
          "const": "internal_model",
          "description": "Internal model approved by regulator\n\nBank's proprietary VaR or ES-based model approved by supervisor.\nMust meet regulatory backtesting and validation requirements.",
          "type": "string"
        },
        {
          "const": "clearing_house",
          "description": "Clearing house methodology\n\nCCP-specific IM calculation (typically VaR or SPAN-based).\nExamples: LCH SwapClear, CME, ICE Clear Credit",
          "type": "string"
        }
      ]
    },
    "Money": {
      "additionalProperties": false,
      "description": "Currency-tagged monetary amount with safe arithmetic.\n\nValues retain decimal precision independently of ISO 4217 display precision.\n\nWhen you need configurable rounding during ingestion, use\n[`Money::new_with_config`].\n\n# Examples\n```rust\nuse finstack_quant_core::money::Money;\nuse finstack_quant_core::currency::Currency;\n\nlet notional = Money::from((1_000_000_i64, Currency::EUR));\nassert_eq!(notional.currency(), Currency::EUR);\nassert_eq!(notional.amount(), 1_000_000.0);\n```",
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalWire",
          "description": "Monetary amount, carried on the wire as an exact decimal string rather\nthan a JSON number so no precision is lost in transit. Construction with\nconfiguration applies the selected ingest scale; raw construction does not."
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "ISO 4217 currency of `amount`. Arithmetic between two `Money` values\nrequires this to match; there is no implicit conversion."
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "NettingSetId": {
      "description": "Identifies a margin netting set.\n\nInstruments in the same netting set can offset each other for margin\ncalculation purposes. The netting set is typically defined by the\nCSA agreement (bilateral) or by CCP membership (cleared) — these two\nshapes are mutually exclusive, so the type encodes them as enum\nvariants rather than as a struct with two `Option<String>` fields\nthat could in principle both be set or both be unset.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A bilateral netting set scoped by counterparty + CSA.",
          "properties": {
            "counterparty_id": {
              "description": "Counterparty identifier",
              "type": "string"
            },
            "csa_id": {
              "description": "CSA identifier",
              "type": "string"
            },
            "kind": {
              "const": "bilateral",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "counterparty_id",
            "csa_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A cleared netting set scoped by CCP membership.",
          "properties": {
            "ccp_id": {
              "description": "CCP identifier (also used as the counterparty id)",
              "type": "string"
            },
            "kind": {
              "const": "cleared",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ccp_id"
          ],
          "type": "object"
        }
      ]
    },
